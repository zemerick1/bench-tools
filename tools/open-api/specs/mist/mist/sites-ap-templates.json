      "radsec": {
        "additionalProperties": false,
        "description": "RadSec settings",
        "properties": {
          "coa_enabled": {
            "default": false,
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "idle_timeout": {
