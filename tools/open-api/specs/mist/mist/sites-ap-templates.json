      },
      "radsec_mxcluster_ids": {
        "description": "To use Org mxedges when this WLAN does not use mxtunnel, specify their mxcluster_ids. Org mxedge(s) identified by mxcluster_ids",
        "items": {
          "examples": [
            "572586b7-f97b-a22b-526c-8b97a3f609c4"
          ],
          "format": "uuid",
          "type": "string"
        },
        "type": "array"
      },
      "radsec_proxy_hosts": {
