        },
        "type": "array"
      },
      "service_max_jitter": {
        "description": "For SSR only, when `traffic_type`==`custom`, for uplink selection. 0-2147483647 or variable",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          }
        ]
      },
      "service_max_latency": {
