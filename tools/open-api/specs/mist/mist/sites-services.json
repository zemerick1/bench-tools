          {
            "type": "string"
          },
          {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          }
        ]
      },
      "service_max_loss": {
        "description": "For SSR only, when `traffic_type`==`custom`, for uplink selection. 0-100 or variable",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        ]
      },
