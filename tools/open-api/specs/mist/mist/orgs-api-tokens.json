        ],
        "format": "uuid",
        "readOnly": true,
        "type": "string"
      },
      "privilege_org": {
        "additionalProperties": false,
        "description": "Organization privilege scope and role settings",
        "properties": {
          "org_id": {
            "description": "If `scope`==`org`, organization ID this privilege applies to",
            "format": "uuid",
            "readOnly": true,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/privilege_org_role",
            "description": "Access role granted by this organization privilege"
          },
          "scope": {
            "$ref": "#/components/schemas/privilege_org_scope",
            "description": "Organization hierarchy level where this privilege applies"
          },
          "site_id": {
            "description": "If `scope`==`site`, site ID this privilege applies to",
            "format": "uuid",
            "type": "string"
          },
          "sitegroup_id": {
            "description": "If `scope`==`sitegroup`, site group ID this privilege applies to",
            "format": "uuid",
            "type": "string"
          },
          "view": {
            "deprecated": true,
            "description": "Used for backward compatibility. Use `views` instead.",
            "type": "string"
          },
          "views": {
            "$ref": "#/components/schemas/admin_privilege_views",
            "description": "UI views allowed by custom role restrictions"
          }
        },
        "required": [
          "role",
          "scope"
        ],
        "type": "object"
      },
      "privilege_org_role": {
        "description": "access permissions. enum: `admin`, `helpdesk`, `installer`, `read`, `write`",
        "enum": [
          "admin",
          "helpdesk",
          "installer",
          "read",
          "write"
        ],
        "type": "string"
      },
      "privilege_org_scope": {
        "description": "enum: `org`, `site`, `sitegroup`, `orgsites`",
        "enum": [
          "org",
          "site",
          "sitegroup",
          "orgsites"
        ],
        "type": "string"
      },
      "response_http400": {
