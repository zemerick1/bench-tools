          }
        },
        "summary": "getOrgApiToken",
        "tags": [
          "Orgs API Tokens"
        ]
      },
      "put": {
        "description": "Update an organization API token's display name or scoped privileges. Source IP restrictions are defined when the token is created.",
        "operationId": "updateOrgApiToken",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "Example": {
                  "value": {
