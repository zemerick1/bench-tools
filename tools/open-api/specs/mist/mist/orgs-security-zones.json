      "securityzone": {
        "additionalProperties": false,
        "description": "Org-level security zone used by SRX gateways. The zone `name` is used as the security zone name on the device, and Networks reference a zone through their `zone_id`.",
        "properties": {
          "created_time": {
            "$ref": "#/components/schemas/created_time",
            "description": "Timestamp when the security zone was created, in epoch seconds"
          },
          "id": {
            "$ref": "#/components/schemas/id",
            "description": "Unique value identifying the security zone"
          },
          "modified_time": {
            "$ref": "#/components/schemas/modified_time",
            "description": "Timestamp when the security zone was last modified, in epoch seconds"
          },
          "name": {
            "description": "Security zone name used on the device. Must start with a letter or a digit, followed by letters, digits, hyphens or underscores",
            "examples": [
              "corp-zone"
            ],
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
            "type": "string"
          },
          "org_id": {
            "$ref": "#/components/schemas/org_id",
            "description": "Organization identifier associated with the security zone"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
