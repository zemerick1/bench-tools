  "tags": [
    {
      "description": "Security Zones are Org-level zones used by SRX gateways. The zone `name` is used as the security zone name on the device, and Networks can reference a zone through their `zone_id`.",
      "name": "Orgs Security Zones"
    }
  ],
  "paths": {
    "/api/v1/orgs/{org_id}/securityzones": {
      "parameters": [
        {
          "$ref": "#/components/parameters/org_id"
        }
      ],
      "get": {
        "description": "List organization-level security zones. Security zones are used by SRX gateways, and the zone `name` is used as the security zone name on the device.",
        "operationId": "listOrgSecurityZones",
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/page"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SecurityZonesArray"
          },
          "400": {
            "$ref": "#/components/responses/HTTP400"
          },
          "401": {
            "$ref": "#/components/responses/HTTP401"
          },
          "403": {
            "$ref": "#/components/responses/HTTP403"
          },
          "404": {
            "$ref": "#/components/responses/HTTP404"
          },
          "429": {
            "$ref": "#/components/responses/HTTP429"
          }
        },
        "summary": "listOrgSecurityZones",
        "tags": [
          "Orgs Security Zones"
        ]
      },
      "post": {
        "description": "Create an organization-level security zone for SRX gateways. Networks reference a zone through their `zone_id`, and several networks can share the same zone.",
        "operationId": "createOrgSecurityZone",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "Example": {
                  "value": {
                    "name": "corp-zone"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/securityzone"
              }
            }
          },
          "description": "Request Body"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SecurityZone"
          },
          "400": {
            "$ref": "#/components/responses/HTTP400"
          },
          "401": {
            "$ref": "#/components/responses/HTTP401"
          },
          "403": {
            "$ref": "#/components/responses/HTTP403"
          },
          "404": {
            "$ref": "#/components/responses/HTTP404"
          },
          "429": {
            "$ref": "#/components/responses/HTTP429"
          }
        },
        "summary": "createOrgSecurityZone",
        "tags": [
          "Orgs Security Zones"
        ]
      }
    },
    "/api/v1/orgs/{org_id}/securityzones/{securityzone_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/org_id"
        },
        {
          "$ref": "#/components/parameters/securityzone_id"
        }
      ],
      "get": {
        "description": "Retrieve details for a specific organization security zone.",
        "operationId": "getOrgSecurityZone",
        "responses": {
          "200": {
            "$ref": "#/components/responses/SecurityZone"
          },
          "400": {
            "$ref": "#/components/responses/HTTP400"
          },
          "401": {
            "$ref": "#/components/responses/HTTP401"
          },
          "403": {
            "$ref": "#/components/responses/HTTP403"
          },
          "404": {
            "$ref": "#/components/responses/HTTP404"
          },
          "429": {
            "$ref": "#/components/responses/HTTP429"
          }
        },
        "summary": "getOrgSecurityZone",
        "tags": [
          "Orgs Security Zones"
        ]
      },
      "put": {
        "description": "Update an organization security zone. Renaming a zone changes the security zone name used on the device for every Network referencing it.",
        "operationId": "updateOrgSecurityZone",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
