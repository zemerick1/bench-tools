            "examples": [
              "foryoureyesonly"
            ],
            "format": "password",
            "type": "string"
          },
          "realm": {
            "description": "Sky ATP realm to create or link with this Mist organization",
            "examples": [
              "mist-team"
            ],
            "type": "string"
          },
          "username": {
            "description": "Sky ATP username used to create or access the realm",
            "examples": [
              "john@abc.com"
