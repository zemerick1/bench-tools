        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "Example": {
                  "value": {
                    "cloud_name": "www.amerskyatp.com",
                    "password": "foryoureyesonly",
                    "realm": "mist-team",
                    "username": "john@abc.com"
                  }
