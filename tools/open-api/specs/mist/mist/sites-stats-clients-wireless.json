    "/api/v1/sites/{site_id}/stats/maps/{map_id}/unconnected_clients": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site_id"
        },
        {
          "$ref": "#/components/parameters/map_id"
        }
      ],
