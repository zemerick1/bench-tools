        "format": "float",
        "readOnly": true,
        "type": [
          "number",
          "null"
        ]
      },
      "rx_retries": {
        "description": "Amount of rx retries",
        "readOnly": true,
        "type": [
          "integer",
          "null"
        ]
      },
      "site_id": {
        "examples": [
          "441a1214-6928-442a-8e92-e1d34b8ec6a6"
        ],
        "format": "uuid",
        "readOnly": true,
        "type": "string"
      },
      "stats_client": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/stats_wireless_client"
          },
          {
            "$ref": "#/components/schemas/stats_wired_client"
          }
        ]
      },
      "stats_client_any_of": {
        "items": {
          "$ref": "#/components/schemas/stats_client"
