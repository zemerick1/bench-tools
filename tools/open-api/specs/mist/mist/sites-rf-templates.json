        "format": "uuid",
        "readOnly": true,
        "type": "string"
      },
      "radio_band_24_usage": {
        "description": "enum: `24`, `5`, `6`, `auto`",
        "enum": [
          "24",
          "5",
          "6",
          "auto"
        ],
        "type": "string"
      },
