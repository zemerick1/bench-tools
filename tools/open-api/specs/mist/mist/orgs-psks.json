        },
        "type": "array"
      },
      "psk_list": {
        "items": {
          "$ref": "#/components/schemas/psk"
        },
        "type": "array"
      },
      "psk_macs": {
        "description": "If `usage`==`macs`, this list contains N number of client mac addresses or mac patterns(1122*) or both. This list is capped at 5000",
        "examples": [
