          "x": {
            "description": "Horizontal pixel coordinate of the zone vertex",
            "format": "double",
            "type": "number"
          },
          "y": {
            "description": "Vertical pixel coordinate of the zone vertex",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object",
        "uniqueItems": true
      },
      "zone_vertices": {
        "description": "Vertices used to define an area. It’s assumed that the last point connects to the first point and forms an closed area",
        "examples": [
