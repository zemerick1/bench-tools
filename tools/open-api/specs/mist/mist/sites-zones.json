  "tags": [
    {
      "description": "A Zone is a custom area defined by a user on a floor plan.\n\nZones can be used for capturing entry and exit events of clients, assets, and sdk clients, providing insights such as wait time and the number of devices in a particular zone.\n\nZone notifications can be accessed using sdk notification callbacks.\n\nZones are useful for data collection specific to areas on the floor plan.",
      "name": "Sites Zones"
    }
  ],
