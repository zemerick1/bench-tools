            "readOnly": true,
            "type": "string"
          },
          "jamf_webhook_url": {
            "examples": [
              "https://scep.mistsys.com/api/v1/webhook/jamf/:org_id/scep"
            ],
            "readOnly": true,
            "type": "string"
          },
          "suspended": {
            "default": false,
            "description": "Whether SCEP is suspended for this org",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "response_http400": {
