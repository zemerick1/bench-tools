        "type": "object"
      },
      "device_id": {
        "examples": [
          "00000000-0000-0000-1000-d8695a0f9e61"
        ],
        "format": "uuid",
        "readOnly": true,
        "type": "string"
      },
      "issued_client_certificate": {
        "additionalProperties": false,
        "properties": {
          "cert_provider": {
            "examples": [
              "byod"
