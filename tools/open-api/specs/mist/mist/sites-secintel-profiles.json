          "default",
          "standard",
          "strict"
        ],
        "type": "string"
      },
      "secintel_profile_profile_category": {
        "description": "enum: `CC`, `IH` (Infected Host), `DNS`",
        "enum": [
          "CC",
          "DNS",
          "IH"
        ],
        "type": "string"
      },
      "secintel_profile_profiles": {
        "description": "Category-specific SecIntel action settings",
        "items": {
