          },
          "peer_ip": {
            "description": "Remote VTEP (peer) endpoint IP",
            "examples": [
              "15.8.3.5"
            ],
            "type": "string"
          },
          "peer_mac": {
            "description": "Remote VTEP device MAC address, when the peer is another device in the same org",
            "examples": [
              "020001e53153"
            ],
            "type": "string"
          },
          "rx_bytes": {
            "description": "Received bytes",
            "examples": [
              633660
            ],
            "type": "integer"
          },
          "rx_pkts": {
            "description": "Received packets",
            "examples": [
              63366
