  "paths": {
    "/api/v1/sites/{site_id}/stats/vtep_peers/count": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site_id"
        }
      ],
      "get": {
        "description": "Count VTEP peer stats by distinct attribute name",
        "operationId": "countSiteVtepStats",
        "parameters": [
          {
            "description": "Field used to group this count response. enum: `ip`, `mac`, `peer_ip`, `peer_mac`, `site_id`",
            "in": "query",
            "name": "distinct",
            "schema": {
              "$ref": "#/components/schemas/vtep_peer_stats_count_distinct"
            }
          },
          {
            "$ref": "#/components/parameters/start"
          },
          {
            "$ref": "#/components/parameters/end"
          },
          {
            "$ref": "#/components/parameters/duration"
          },
          {
            "$ref": "#/components/parameters/limit"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Count"
          },
          "400": {
            "$ref": "#/components/responses/HTTP400"
          },
          "401": {
            "$ref": "#/components/responses/HTTP401"
          },
          "403": {
            "$ref": "#/components/responses/HTTP403"
          },
          "404": {
            "$ref": "#/components/responses/HTTP404"
          },
          "429": {
            "$ref": "#/components/responses/HTTP429"
          }
        },
        "summary": "countSiteVtepStats",
        "tags": [
          "Sites Stats - VTEP Peers"
        ]
      }
    },
    "/api/v1/sites/{site_id}/stats/vtep_peers/search": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site_id"
        }
      ],
      "get": {
        "description": "Search VTEP peer stats. Results are sorted by time in descending order",
        "operationId": "searchSiteVtepStats",
        "parameters": [
          {
            "description": "Filter results by device MAC address. Accepts multiple comma-separated values.",
            "in": "query",
            "name": "mac",
            "schema": {
              "examples": [
                "5c5b53010101,5c5b53020202"
              ],
              "type": "string"
            }
          },
          {
            "description": "Filter results by local device source VTEP IP (SVTEP-IP)",
            "in": "query",
            "name": "ip",
            "schema": {
              "examples": [
                "15.8.3.1"
              ],
              "type": "string"
            }
          },
          {
            "description": "Filter results by remote VTEP (peer) endpoint IP",
            "in": "query",
            "name": "peer_ip",
            "schema": {
              "examples": [
                "15.8.3.5"
              ],
              "type": "string"
            }
          },
          {
            "description": "Filter results by remote VTEP device MAC address",
            "in": "query",
            "name": "peer_mac",
            "schema": {
              "examples": [
                "020001e53153"
              ],
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/start"
          },
          {
            "$ref": "#/components/parameters/end"
          },
          {
            "$ref": "#/components/parameters/duration"
          },
          {
            "$ref": "#/components/parameters/sort"
          },
          {
            "$ref": "#/components/parameters/search_after"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/VtepPeersStatsSearch"
          },
          "400": {
            "$ref": "#/components/responses/HTTP400"
          },
          "401": {
            "$ref": "#/components/responses/HTTP401"
          },
          "403": {
            "$ref": "#/components/responses/HTTP403"
          },
          "404": {
            "$ref": "#/components/responses/HTTP404"
          },
          "429": {
            "$ref": "#/components/responses/HTTP429"
          }
        },
        "summary": "searchSiteVtepStats",
        "tags": [
          "Sites Stats - VTEP Peers"
        ]
      }
    }
  },
  "components": {
