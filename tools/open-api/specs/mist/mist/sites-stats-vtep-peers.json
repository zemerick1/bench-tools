      },
      "vtep_peer_stats_count_distinct": {
        "default": "mac",
        "description": "enum: `ip`, `mac`, `peer_ip`, `peer_mac`, `site_id`",
        "enum": [
          "ip",
          "mac",
          "peer_ip",
          "peer_mac",
          "site_id"
        ],
        "type": "string"
      },
      "vtep_peer_stats_search_result": {
