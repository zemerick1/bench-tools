        ]
      },
      "put": {
        "description": "Updates an existing BLE asset filter for the given site.",
        "operationId": "updateOrgAssetFilter",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "Example": {
                  "value": {
                    "disabled": true,
                    "eddystone_uid_namespace": "string",
                    "eddystone_url": "string",
                    "ibeacon_major": 1,
                    "ibeacon_uuid": "b069b358-4c97-5319-1f8c-7c5ca64d6ab2",
