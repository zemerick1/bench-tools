            "description": "Eddystone uid namespace used to filter assets",
            "examples": [
              "2818e3868dec25629ede"
            ],
            "type": "string"
          },
          "eddystone_url": {
            "description": "Eddystone url used to filter assets",
            "examples": [
              "https://www.abc.com"
