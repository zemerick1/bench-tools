  "components": {
    "schemas": {
      "BadRequestError": {
        "properties": {
          "debugId": {
            "description": "A unique identifier used for troubleshooting and debugging purposes.",
            "example": "78f002e32e0cefba3d8cc94fa8179342",
            "maxLength": 512,
            "type": "string",
            "x-go-name": "DebugID"
          },
          "errorCode": {
            "description": "Error code representing the specific error condition.",
            "enum": [
              "HPE_GL_ERROR_BAD_REQUEST",
              "HPE_GL_ERROR_MISSING_IDENTIFIER",
              "HPE_GL_ERROR_INSUFFICIENT_PARAMS"
            ],
            "example": "HPE_GL_ERROR_BAD_REQUEST",
            "maxLength": 128,
            "type": "string",
            "x-go-name": "ErrorCode"
          },
          "httpStatusCode": {
            "description": "The HTTP status code indicating the error type (e.g., 400 for Bad Request).",
            "example": 400,
            "format": "int64",
            "maximum": 400,
            "minimum": 400,
            "type": "integer",
            "x-go-name": "HTTPStatusCode"
          },
          "message": {
            "description": "Error message providing more details about the error.",
            "example": "Reason for the error",
            "maxLength": 512,
            "type": "string",
            "x-go-name": "Message"
          }
        },
        "required": [
          "debugId",
          "errorCode",
          "httpStatusCode",
          "message"
        ],
        "type": "object",
        "x-go-package": "cdaservice/nbapi"
      },
      "CdaJobResponse": {
        "description": "Represents Information about a job",
        "properties": {
          "completedAt": {
            "description": "Timestamp when the job was completed (ISO 8601 format)",
            "type": "string",
            "x-go-name": "CompletedAt"
          },
          "createdAt": {
            "description": "Timestamp when the job was created (ISO 8601 format)",
            "type": "string",
            "x-go-name": "CreatedAt"
          },
          "duplicateCount": {
            "description": "Number of duplicate records",
            "format": "int64",
            "type": "integer",
            "x-go-name": "DuplicateCount"
          },
          "errorArgs": {
            "description": "Error args to format error string",
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-go-name": "ErrorArgs"
          },
          "errorCode": {
            "description": "Error code for the job",
            "type": "string",
            "x-go-name": "ErrorCode"
          },
          "errorCount": {
            "description": "Number of records that encountered errors",
            "format": "int64",
            "type": "integer",
            "x-go-name": "ErrorCount"
          },
          "errorMessage": {
            "description": "Error message for the job",
            "type": "string",
            "x-go-name": "ErrorMessage"
          },
          "id": {
            "description": "Unique identifier for the job",
            "type": "string",
            "x-go-name": "ID"
          },
          "identityStoreID": {
            "description": "Identity store associated with the Named MPSK authentication profile",
            "type": "string",
            "x-go-name": "IdentityStoreID"
          },
          "lastUpdatedAt": {
            "description": "Timestamp when the job was last updated (ISO 8601 format)",
            "type": "string",
            "x-go-name": "LastUpdatedAt"
          },
          "progressPercentage": {
            "description": "Indicates the progress of the job",
            "format": "double",
            "type": "number",
            "x-go-name": "ProgressPercentage"
          },
          "status": {
            "$ref": "#/components/schemas/CdaJobStatus"
          },
          "successCount": {
            "description": "Number of records that have been processed successfully",
            "format": "int64",
            "type": "integer",
            "x-go-name": "SuccessCount"
          },
          "type": {
            "$ref": "#/components/schemas/CdaJobType"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "type": "object",
        "x-go-package": "cdaservice/graphql/models"
      },
      "CdaJobStatus": {
        "description": "Represents status of a job",
        "type": "string",
        "x-go-package": "cdaservice/graphql/models"
      },
      "CdaJobType": {
        "description": "Supported cda job types",
        "type": "string",
        "x-go-package": "cdaservice/graphql/models"
      },
      "CdaJobsResponse": {
        "description": "Represents the response for query listCdaJobs",
        "properties": {
          "count": {
            "description": "Count of items returned.",
            "format": "int64",
            "type": "integer",
            "x-go-name": "Count"
