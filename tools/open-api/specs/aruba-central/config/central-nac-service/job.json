  "paths": {
    "/network-config/v1alpha1/cnac-job": {
      "get": {
        "description": "This API lists import/export jobs with optional filters.",
        "operationId": "ListCdaJobs",
        "parameters": [
          {
            "description": "A type of job to filter on.",
            "in": "query",
            "name": "jobtype",
            "schema": {
              "enum": [
                "MAC_EXPORT",
                "MAC_IMPORT",
                "MPSK_EXPORT",
                "MPSK_IMPORT",
                "VISITOR_EXPORT"
              ],
              "type": "string"
            }
          },
          {
            "description": "Maximum number of registered jobs to be returned. Allowed range is 1 to 30.",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 30,
              "maximum": 30,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "A pagination cursor for the next page of resources.",
            "in": "query",
            "name": "next",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "A zero-based resource offset from which to start the response.",
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "A search value to filter job results.",
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The sort expression is a field name followed by a direction indicator asc (ascending) or desc (descending).\nThe first value in the expression defines the sort field and the second defines the sort order. If\nexpression is not specified, the default expression is 'createdAt desc'.\nSupported fields are macAddress, name, enable, userRole, displayName, createdAt and modifiedAt.\nExample: macAddress asc\n",
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CdaJobsResponse"
                }
              }
            },
            "description": "Success. The job details have been retrieved."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            },
            "description": "Bad request. The request is malformed or invalid input received."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            },
            "description": "Unauthorized access."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenError"
                }
              }
            },
            "description": "Forbidden. Access is denied."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            },
            "description": "Job was not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequestsError"
                }
              }
            },
            "description": "Too many requests. Rate limit exceeded."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            },
            "description": "Internal server error."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUnavailableError"
                }
              }
            },
            "description": "Service unavailable. The server is temporarily unavailable."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "List jobs",
        "tags": [
          "Job"
        ]
      }
    },
