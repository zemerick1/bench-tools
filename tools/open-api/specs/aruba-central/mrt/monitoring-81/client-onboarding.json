    {
      "name": "Client Onboarding",
      "description": "APIs to retrieve onboarding stage scores, stage export summaries, top reasons, and top grouped counts."
    }
  ],
  "paths": {
    "/network-monitoring/v1/client-onboarding-score": {
      "get": {
        "tags": [
          "Client Onboarding"
        ],
        "operationId": "getClientOnboardingScoreV1",
        "summary": "Get onboarding score",
        "description": "Retrieves an onboarding score by stage and overall score for a given time range. If `stage` is not provided, scores are returned for default stages: `assoc`, `auth`, `dhcp`, and `dns`. If `site-id` is omitted tenant-level score is returned.",
        "parameters": [
          {
            "name": "start-at",
            "in": "query",
            "required": false,
            "description": "Start timestamp (ISO date format). Must be earlier than end-at. If start-at and end-at are not provided, the default time range is 3 hours.",
            "schema": {
              "type": "string",
              "format": "const",
              "example": "2026-04-27T14:30:00Z"
            }
          },
          {
            "name": "end-at",
            "in": "query",
            "required": false,
            "description": "End timestamp (ISO date format). Must be later than start-at. If start-at and end-at are not provided, the default time range is 3 hours.",
            "schema": {
              "type": "string",
              "format": "const",
              "example": "2026-04-29T14:30:00Z"
            }
          },
          {
            "name": "site-id",
            "in": "query",
            "required": false,
            "description": "Optional site identifier. If omitted, tenant-level score is returned.",
            "schema": {
              "type": "string",
              "format": "const",
              "example": "6985764272"
            }
          },
          {
            "name": "stage",
            "in": "query",
            "required": false,
            "description": "Optional onboarding stage. Supported values: `assoc`, `auth`, `dhcp`, `dns`. Omit to get all supported stages.",
            "schema": {
              "type": "string",
              "format": "const",
              "example": "assoc"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "Optional onboarding events version. If not provided or non-numeric, the service uses a default version.",
            "schema": {
              "type": "string",
              "format": "const",
              "example": "1"
            }
          },
          {
            "name": "view-type",
            "in": "query",
            "required": false,
            "description": "view-type supports DEFAULT, BY_CLIENT and BY_ATTEMPTS view. DEFAULT view gives consolidated metrics based on every single client onboarding attempt in given time period. BY_CLIENT gives consolidated metrics for all distinct client based on the single connection attempt made most recently or latest connection attempt in the given time period. BY_ATTEMPTS view gives the consolidated metrics by extracting latest or most recent connection attempt made per session from the client.",
            "schema": {
              "type": "string",
              "enum": [
                "DEFAULT",
                "BY_CLIENT",
                "BY_ATTEMPTS"
              ],
              "example": "BY_CLIENT"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/OnboardingScoreResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/network-monitoring/v1/client-onboarding-stage/count": {
      "get": {
        "tags": [
          "Client Onboarding"
        ],
        "operationId": "getClientOnboardingStageCountV1",
        "summary": "Get top onboarding counts by stage and status for a specific field",
        "description": "Retrieves top grouped counts for onboarding by stage and status. Query params supports kebab-case",
        "parameters": [
          {
            "name": "start-at",
            "in": "query",
            "required": true,
            "description": "Start timestamp (ISO date format). Must be earlier than end-at. If start-at and end-at are not provided, the default time range is 3 hours.",
            "schema": {
              "type": "string",
              "example": "2026-04-27T14:30:00Z"
            }
          },
          {
            "name": "end-at",
            "in": "query",
            "required": true,
            "description": "End timestamp (ISO date format). Must be later than start-at. If start-at and end-at are not provided, the default time range is 3 hours.",
            "schema": {
              "type": "string",
              "example": "2026-04-29T14:30:00Z"
            }
          },
          {
            "name": "site-id",
            "in": "query",
            "required": false,
            "description": "Optional site identifier. If omitted, tenant-level aggregation is returned.",
            "schema": {
              "type": "string",
              "example": "6985764272"
            }
          },
          {
            "name": "field",
            "in": "query",
            "required": false,
            "description": "Grouping field key. Supported values and meanings: `topclients` (client MAC), `topaccessdevices` (AP MAC), `band` (radio band), `topwlans` (ESSID), `topreasons` (onboarding failure reason), `topservers` (auth server if stage is auth, dhcp server if stage is dhcp, dns server if stage is dns). Defaults to `topclients` in resolver when omitted.",
            "schema": {
              "type": "string",
              "enum": [
                "topclients",
                "topaccessdevices",
                "band",
                "topwlans",
                "topreasons",
                "topservers"
              ],
              "example": "topclients"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Optional status selector. Supported values: `FAILED` (stage failed), `DELAY` (successful with latency above threshold), `SUCCESS` (successful onboarding). Defaults to `FAILED`.",
            "schema": {
              "type": "string",
              "enum": [
                "FAILED",
                "DELAY",
                "SUCCESS"
              ],
              "example": "FAILED"
            }
          },
          {
            "name": "stage",
            "in": "query",
            "required": false,
            "description": "Optional onboarding stage selector. Omit to get all supported stages.",
            "schema": {
              "type": "string",
              "enum": [
                "assoc",
                "auth",
                "dhcp",
                "dns"
              ],
              "example": "assoc"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "Optional onboarding events version. If missing or non-numeric, default version is used.",
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "view-type",
            "in": "query",
            "required": false,
            "description": "view-type supports DEFAULT, BY_CLIENT and BY_ATTEMPTS view. DEFAULT view gives consolidated metrics based on every single client onboarding attempt in given time period. BY_CLIENT gives consolidated metrics for all distinct client based on the single connection attempt made most recently or latest connection attempt in the given time period. BY_ATTEMPTS view gives the consolidated metrics by extracting latest or most recent connection attempt made per session from the client.",
            "schema": {
              "type": "string",
              "enum": [
                "DEFAULT",
                "BY_CLIENT",
                "BY_ATTEMPTS"
              ],
              "example": "BY_CLIENT"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/OnboardingCountResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
