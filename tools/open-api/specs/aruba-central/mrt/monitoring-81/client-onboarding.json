  "components": {
    "schemas": {
      "BadRequestError": {
        "type": "object",
        "description": "Bad request error details returned from the server.",
        "required": [
          "httpStatusCode",
          "errorCode",
          "message",
          "debugId"
        ],
        "properties": {
          "httpStatusCode": {
            "type": "integer",
            "minimum": 400,
            "maximum": 400,
            "description": "HTTP status code.",
            "example": 400
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "HPE_GL_NETWORK_MONITORING_INVALID_INPUT"
            ],
            "maxLength": 128,
            "description": "Error code",
            "example": "HPE_GL_NETWORK_MONITORING_INVALID_INPUT"
          },
          "message": {
            "$ref": "#/components/schemas/ErrorMessage"
          },
          "debugId": {
            "$ref": "#/components/schemas/DebugId"
          }
        }
      },
      "DebugId": {
        "type": "string",
        "format": "const",
        "maxLength": 512,
        "description": "A unique identifier used for troubleshooting purposes.",
        "example": "78f002e32e0cefba3d8cc94fa8179342"
      },
      "Error404": {
        "type": "object",
        "description": "Error details returned from the server.",
        "required": [
          "httpStatusCode",
          "errorCode",
          "message",
          "debugId"
        ],
        "properties": {
          "httpStatusCode": {
            "type": "integer",
            "minimum": 404,
            "maximum": 404,
            "example": 404,
            "description": "HTTP status code."
          },
          "errorCode": {
            "type": "string",
            "format": "const",
            "maxLength": 32,
            "description": "Internal error code.",
            "example": "HPE_GL_ERROR_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "format": "const",
            "maxLength": 512,
            "description": "Not Found.",
            "example": "Not Found"
          },
          "debugId": {
            "type": "string",
            "format": "const",
            "maxLength": 50,
            "description": "This can be used to help with troubleshooting",
            "example": "abc-123-456"
          }
        }
      },
      "ErrorMessage": {
        "type": "string",
        "format": "const",
        "maxLength": 512,
        "description": "Error message indicating the cause of the failure.",
        "example": "Error Message"
      },
      "ForbiddenRequest": {
        "type": "object",
        "description": "Forbidden error details returned from the server.",
        "required": [
          "httpStatusCode",
          "errorCode",
          "message",
          "debugId"
        ],
        "properties": {
          "httpStatusCode": {
            "type": "integer",
            "minimum": 403,
            "maximum": 403,
            "example": 403,
            "description": "HTTP status code."
          },
          "errorCode": {
            "type": "string",
            "description": "* A unique machine-friendly, but human-readable identifier for the error. It has prefix HPE_GL_.* For more details regarding error please refer to error message",
            "example": "HPE_GL_ERROR_FORBIDDEN",
            "maxLength": 256
          },
          "message": {
            "$ref": "#/components/schemas/ErrorMessage"
          },
          "debugId": {
            "$ref": "#/components/schemas/DebugId"
          }
        }
      },
      "InternalServerError": {
        "type": "object",
        "description": "Error details returned from the server.",
        "required": [
          "httpStatusCode",
          "errorCode",
          "message",
          "debugId"
        ],
        "properties": {
          "httpStatusCode": {
            "type": "integer",
            "minimum": 500,
            "maximum": 500,
            "example": 500,
            "description": "HTTP status code."
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "HPE_GL_NETWORK_MONITORING_INTERNAL_SERVER_ERROR"
            ],
            "format": "const",
            "maxLength": 128,
            "description": "* A unique machine-friendly, but human-readable identifier for the error. It has a prefix HPE_GL_.* For more details regarding error, please refer to the error message",
            "example": "HPE_GL_NETWORK_MONITORING_INTERNAL_SERVER_ERROR"
          },
          "message": {
            "$ref": "#/components/schemas/ErrorMessage"
          },
          "debugId": {
            "$ref": "#/components/schemas/DebugId"
          }
        }
      },
      "OnboardingCountData": {
        "type": "object",
        "required": [
          "type",
          "value",
          "field",
          "count",
          "stage"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Computed type in `<FIELD>_<STATUS>_COUNT` form.",
            "example": "TOPCLIENTS_FAILED_COUNT"
          },
          "value": {
            "type": "string",
            "description": "Top grouped value; for example client MAC, AP MAC, band, WLAN, reason, or server IP.",
            "example": "AA:AA:AA:AA:AA:AA"
          },
          "field": {
            "type": "string",
            "description": "Requested grouping field key.",
            "enum": [
              "topclients",
              "topaccessdevices",
              "band",
              "topwlans",
              "topreasons",
              "topservers"
            ]
          },
          "count": {
            "type": "integer",
            "description": "Occurrence count for the grouped value.",
            "example": 42
          },
          "stage": {
            "type": "string",
            "enum": [
              "assoc",
              "auth",
              "dhcp",
              "dns"
            ],
            "example": "auth"
          }
        }
      },
      "OnboardingCountItem": {
        "type": "object",
        "required": [
          "type",
          "data"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Stage key.",
            "example": "auth"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OnboardingCountData"
            }
          }
        }
      },
      "OnboardingCountResult": {
        "type": "object",
        "required": [
          "id",
          "type",
          "items",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Top count response type based on status.",
            "example": "TOP_FAILED_COUNT"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OnboardingCountItem"
            }
          },
          "count": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "OnboardingReasonsItem": {
        "type": "object",
        "required": [
          "type",
          "reasons"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Stage name in uppercase.",
            "example": "AUTH"
          },
          "reasons": {
