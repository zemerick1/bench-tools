            "in": "query",
            "required": false,
            "description": "Sort field followed by a direction indicator ASC (ascending) or DESC (descending). Supported fields are siteName, deviceHealth, apHealth, switchHealth, gatewayHealth, bridgeHealth\n",
            "schema": {
