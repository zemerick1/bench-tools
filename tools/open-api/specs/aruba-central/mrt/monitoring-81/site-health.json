  "tags": [
    {
      "name": "Site Health",
      "description": "Site Health APIs to get site details with health, devices, clients, alerts information."
    }
  ],
  "paths": {
    "/network-monitoring/v1/site-health/{site-id}": {
      "get": {
        "tags": [
          "Site Health"
        ],
        "operationId": "getSiteHealthV1",
        "summary": "Site information",
        "description": "This API endpoint provides the detailed health information for the requested site, including site Id, health of the site, and poor health reasons for the site. The response includes the count of devices, clients, VMs, and hosts categorized by performance as poor, fair or good.",
        "parameters": [
          {
            "name": "site-id",
            "in": "path",
            "required": true,
            "description": "Identifier of the Site for which site information is requested.\n",
            "schema": {
              "$ref": "#/components/schemas/SiteIdsite"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SiteHealthResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/network-monitoring/v1/sites-client-health": {
      "get": {
        "tags": [
          "Site Health"
        ],
        "operationId": "listSitesClientHealthV1",
        "summary": "List of sites with client health",
        "description": "This API returns a list of sites with the number of poor, fair and good health clients, categorized as wired and wireless for each site.",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Specifies the number of sites to be returned per request. Maximum limit per request is 1000.",
            "schema": {
              "$ref": "#/components/schemas/Limitsite"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "Defines the starting point for the set of sites to be returned. Number of sites to skip before starting to collect the result set.",
            "schema": {
              "$ref": "#/components/schemas/Offsetsite"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "OData Version 4.0 filter string (limited functionality). Supports only 'and' conjunction; ('or' and 'not' are NOT supported). Supported fields and operators are in the below given table.\n\n| Field | Operators |\n| --------- | -------- |\n| `siteId` | `eq` and `in` |\n| `siteName` | `eq` and `in` |\n\n**The operators are implemented as follows:**\n\n* `eq`: Only values exactly matching the given value are returned.\n\n* `in`: Only values present in the given list are returned.\n\n",
            "schema": {
              "type": "string",
              "format": "const",
              "maxLength": 256,
              "example": "siteName in ('site1', 'site2')"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort field followed by a direction indicator ASC (ascending) or DESC (descending). Supported fields are siteName, clientHealth, wirelessClientHealth, wiredClientHealth\n",
            "schema": {
              "default": "siteName ASC",
              "type": "string",
              "format": "const",
              "maxLength": 256,
              "example": "wirelessClientHealth ASC"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SitesClientHealthResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
