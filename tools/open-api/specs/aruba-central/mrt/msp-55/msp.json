  "paths": {
    "/network-msp/v1/list-tenants": {
      "get": {
        "tags": [
          "MSP"
        ],
        "summary": "Get all MSP tenants information.",
        "description": "This API provides the list of tenants for an MSP. Tenants list includes details like tenant name, tenant CID, sites count, devices count with health status, alerts count, etc. The query parameters allow you to narrow down the results that meet specific criteria, ensuring you receive only the relevant data.",
        "operationId": "listTenantsV1",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Filter"
          },
          {
            "$ref": "#/components/parameters/Sort"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Next"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ListTenantsResponse"
          },
