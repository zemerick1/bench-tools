        "type": "object",
        "description": "List of all the tenants for an MSP. It includes details like tenant name, tenant CID, sites count, devices count with health status, alerts count, etc.",
        "example": {
          "count": 10,
          "total": 100,
          "next": "2",
          "items": [
            {
              "tenantName": "Tenant A",
              "tenantId": "fa451230e38a11ef8a28061d9656",
              "totalSites": 12,
              "degradedSites": 1,
              "deviceOwnership": "MSP",
              "deviceHealthStatus": {
                "total": 150,
                "good": 130,
                "fair": 15,
                "poor": 5
              },
              "alerts": {
                "total": 58,
                "critical": 8,
                "major": 10,
                "minor": 40
              },
              "lastUpdatedTime": 1732320000,
              "createdTime": 1633036806
            }
          ]
        },
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "The number of objects returned in the current response.",
            "example": 10
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "The total number of objects contained in the database.",
            "example": 200
          },
          "next": {
            "type": "string",
            "format": "const",
            "description": "Specifies the pagination cursor for the next page of resources.",
            "example": "2"
