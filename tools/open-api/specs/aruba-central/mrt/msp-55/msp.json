      "MSPTenant": {
        "type": "object",
        "description": "An object containing details of a tenant under MSP.",
        "properties": {
          "tenantName": {
            "type": "string",
            "format": "const",
            "description": "Name of the tenant.",
            "example": "Tenant A"
          },
          "tenantId": {
            "type": "string",
            "format": "const",
            "description": "Application CID of the tenant.",
            "example": "fa451230e38a11ef8a28061d9656"
          },
          "totalSites": {
            "type": "integer",
            "format": "int32",
            "description": "The total number of sites belonging to the tenant.",
            "example": 8
          },
          "degradedSites": {
            "type": "integer",
            "format": "int32",
            "description": "The total number of sites belonging to the tenant where at least one device health is poor.",
            "example": 3
          },
          "deviceOwnership": {
            "type": "string",
            "enum": [
              "MSP",
              "TENANT"
            ],
            "format": "const",
            "maxLength": 128,
            "description": "Indicates devices ownership by MSP or tenant",
            "example": "MSP"
          },
          "deviceHealthStatus": {
            "type": "object",
            "description": "An object containing health status of all device types.",
            "properties": {
              "total": {
                "type": "integer",
                "format": "int32",
                "description": "The total number of devices.",
                "example": 150
              },
              "good": {
                "type": "integer",
                "format": "int32",
                "description": "The total number of devices with health status good.",
                "example": 130
              },
              "fair": {
                "type": "integer",
                "format": "int32",
                "description": "The total number of devices with health status fair.",
                "example": 15
              },
              "poor": {
                "type": "integer",
                "format": "int32",
                "description": "The total number of devices with health status poor.",
                "example": 5
              }
            }
          },
          "alerts": {
            "type": "object",
            "description": "An object containing alerts count from all sites of a tenant.",
            "properties": {
              "total": {
                "type": "integer",
                "format": "int32",
                "description": "The total number of alerts.",
                "example": 58
              },
              "critical": {
                "type": "integer",
                "format": "int32",
                "description": "The total number of critical alerts.",
                "example": 8
              },
              "major": {
                "type": "integer",
                "format": "int32",
                "description": "The total number of major alerts.",
                "example": 10
              },
              "minor": {
                "type": "integer",
                "format": "int32",
                "description": "The total number of minor alerts.",
                "example": 40
              }
            }
          },
          "lastUpdatedTime": {
            "type": "integer",
            "format": "int64",
            "description": "Timestamp in seconds indicating last update of a tenant details.",
            "example": 1732320000
          },
          "createdTime": {
            "type": "integer",
            "format": "int64",
            "description": "Timestamp in seconds indicating creation time of a tenant.",
            "example": 1633036806
          }
        }
      },
