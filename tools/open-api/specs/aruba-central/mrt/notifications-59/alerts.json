            "type": "integer",
            "description": "Number of alerts returned in the current response.\n",
            "example": 1
          },
          "total": {
            "type": "integer",
            "description": "Total number of alerts matching the query criteria.\n",
            "example": 1
          },
          "next": {
            "type": "string",
            "description": "Specifies the pagination cursor for the next page of resources. Null if there are no further pages.\n",
            "example": [
              null,
              1,
              2,
              3
            ]
          }
        }
      },
      "AlertsClassificationResponseBody": {
        "type": "object",
        "description": "Response body for alerts classification.\n",
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of classification used.\n",
            "example": "category"
          },
          "classificationData": {
            "type": "array",
            "description": "List of classification data entries.\n",
            "items": {
              "$ref": "#/components/schemas/ClassificationDataItem"
            }
          }
        }
      },
      "AsyncOperationError": {
        "type": "object",
        "description": "Error details for a failed async operation.\n",
        "properties": {
          "code": {
            "type": "string",
            "description": "The error code.\n",
            "example": "HPE_GL_ERROR_OPERATION_FAILED"
          },
          "message": {
            "type": "string",
            "description": "The error message.\n",
            "example": "The operation failed due to an internal error."
          },
          "details": {
            "type": "string",
            "description": "Additional details about the error.\n",
            "example": "Alert ID not found"
          }
        }
      },
      "BadRequestErrorDetails": {
        "type": "object",
        "description": "Error details returned from the server.",
        "required": [
          "httpStatusCode",
          "errorCode",
          "message",
          "debugId"
        ],
        "properties": {
          "httpStatusCode": {
            "type": "integer",
            "minimum": 400,
            "maximum": 400,
            "example": 400,
            "description": "HTTP status code."
          },
          "errorCode": {
            "type": "string",
            "maxLength": 128,
            "description": "Internal error code.",
            "example": "HPE_GL_NETWORK_NOTIFICATIONS_BAD_REQUEST"
          },
          "message": {
            "type": "string",
            "maxLength": 512,
            "description": "Error message indicating the cause of the failure.",
            "example": "Invalid input received for notification rule."
          },
          "debugId": {
            "$ref": "#/components/schemas/DebugId"
          }
        }
      },
      "ClassificationDataItem": {
        "type": "object",
        "description": "A single classification data entry.\n",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the classification group.\n",
            "example": "System"
          },
          "count": {
            "type": "integer",
            "description": "The number of alerts in this classification group.\n",
            "example": 25
          },
          "typeId": {
            "type": "string",
            "description": "The type identifier for this classification group.\n",
            "example": "102"
          }
        }
      },
      "ClearAlertsRequest": {
        "type": "object",
        "description": "Request body for clearing alerts.\n",
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "description": "List of alert keys to clear.\n",
            "items": {
              "type": "string"
            },
            "example": [
              "22071893000:47765082406",
              "22071893000:47764775046"
            ]
          },
          "reason": {
            "type": "string",
            "description": "The reason for clearing the alerts.\n",
            "enum": [
              "Problem was resolved",
              "False Positive",
              "Insufficient information for troubleshooting",
              "Alert is not important",
              "Other"
            ],
            "example": "Problem was resolved"
          },
