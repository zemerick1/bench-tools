  "components": {
    "schemas": {
      "Alert": {
        "type": "object",
        "description": "Alert details.\n",
        "required": [
          "id",
          "key",
          "category",
          "typeId",
          "name",
          "severity",
          "priority",
          "status",
          "summary",
          "createdAt",
          "updatedAt",
          "updatedBy",
          "type",
          "deviceType",
          "clearedReason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the alert.\n"
          },
          "key": {
            "type": "string",
            "description": "Alert key.\n"
          },
          "category": {
            "type": "string",
            "description": "Category of the alert.\n"
          },
          "typeId": {
            "type": "string",
            "description": "Type identifier of the alert.\n"
          },
          "name": {
            "type": "string",
            "description": "Name of the alert.\n"
          },
          "severity": {
            "type": "string",
            "description": "Severity level of the alert.\n"
          },
          "priority": {
            "type": "string",
            "description": "Priority level of the alert.\n"
          },
          "status": {
            "type": "string",
            "description": "Current status of the alert.\n"
          },
          "summary": {
            "type": "string",
            "description": "Summary description of the alert.\n"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the alert was created.\n"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the alert was last updated.\n"
          },
          "updatedBy": {
            "type": "string",
            "description": "Identifier of the user who last updated the alert.\n"
          },
          "type": {
            "type": "string",
            "description": "Type of the resource.\n"
          },
          "deviceType": {
            "type": "string",
            "description": "Type of device associated with the alert.\n"
          },
          "clearedReason": {
            "type": "string",
            "description": "The reason an alert is cleared. This will be populated only when the status is cleared.\n"
          }
        }
      },
      "AlertActionResponseBody": {
        "type": "object",
        "description": "Response body for alert action operations.\n",
        "properties": {
          "response": {
            "type": "string",
            "description": "Response message indicating the action was accepted.\n",
            "example": "Request accepted"
          },
          "taskId": {
            "type": "string",
            "description": "Unique task identifier for tracking the asynchronous operation.\n",
            "example": "abc123-def456-ghi789"
          },
          "location": {
            "type": "string",
            "description": "URL to check the status of the asynchronous operation.\n",
            "example": "/network-notifications/v1/alerts/async-operations/abc123-def456-ghi789"
          }
        }
      },
      "AlertActionStatusResponseBody": {
        "type": "object",
        "description": "Response body for alert action status.\n",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this async operation resource.\n",
            "example": "network-notifications/v1/alerts/action-status"
          },
          "type": {
            "type": "string",
            "description": "Resource type identifier.\n",
            "example": "network-notifications/alert-action-status"
          },
          "sourceResourceUri": {
            "type": "string",
            "description": "The URI of the source resource associated with this operation.\n",
            "example": "/network-notifications/v1/alerts/clear"
          },
          "state": {
            "type": "string",
            "description": "The current state of the asynchronous operation.\n",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "SUCCEEDED",
              "FAILED"
            ],
            "example": "SUCCEEDED"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the operation started.\n",
            "example": "2026-02-23T10:30:00Z"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the operation ended.\n",
            "example": "2026-02-23T10:31:00Z"
          },
          "logMessages": {
            "type": "array",
            "description": "Log messages associated with the operation.\n",
            "items": {
              "$ref": "#/components/schemas/LogMessage"
            }
          },
          "progressPercent": {
            "type": "integer",
            "description": "The progress percentage of the operation.\n",
            "minimum": 0,
            "maximum": 100,
            "example": 100
          },
          "error": {
            "$ref": "#/components/schemas/AsyncOperationError"
          }
        }
      },
