  "paths": {
    "/network-notifications/v1/alerts": {
      "get": {
        "summary": "List all alerts",
        "tags": [
          "Alerts"
        ],
        "operationId": "getAlertListV1",
        "description": "This API endpoint retrieves the list of Alerts based on the query parameters provided. The alerts list includes details such as name, type, category, severity, status, etc. The query parameters allow you to filter results that meet specific criteria, ensuring you receive only relevant data.\n",
        "parameters": [
          {
            "name": "filter",
            "description": "OData Version 4.0 filter string (limited functionality). Supports only 'and' conjunction ('or' and 'not' are NOT supported). Supported fields and operators are in the table below. \n\n| Field | Operators |\n| --------- | -------- |\n| `siteId` | `eq` and `in` |\n| `typeId` | `eq` and `in` |\n| `status` | `eq` and `in` |\n| `category` | `eq` and `in` |\n| `deviceType` | `eq` and `in`|\n\n**The operators are implemented as follows:**\n\n* `eq`: Only values exactly matching the given value are returned.\n* `in`: Only values present in the given list are returned.\n\n**List of applicable filters for field and terms:**\n\n| Field | Applicable Terms |\n| --------- | -------- |\n|  `siteId` | `string` |\n| `typeId` | `string` |\n| `status` | `[\"Active\", \"Deferred\", \"Cleared\"]` |\n| `deviceType` | `[\"Access Point\", \"Gateway\", \"Switch\", \"Bridge\", \"Access Point, Switch\", \"Switch, Switch\"]` |\n| `category` | `[\"Clients\", \"System\", \"LAN\", \"WLAN\", \"WAN\", \"Cluster\", \"Routing\", \"Security\"]` |\n\n",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "typeId in ('102', '4') and siteId eq '1234567'"
            }
          },
          {
            "name": "sort",
            "description": "Sort field followed by a direction indicator ASC (ascending) or DESC (descending). Supported fields are `createdAt`,`severity`,`status`,`name`,`priority`. `createdAt` field is used by default. \n",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "const",
              "maxLength": 256,
              "example": "status asc"
            }
          },
          {
            "name": "next",
            "description": "Specifies the pagination cursor for the next page of resources. Minimum value is 1.\n",
            "in": "query",
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "limit",
            "description": "Maximum number of alerts to be retrieved. Allowed range is 1 to 100.\n",
            "in": "query",
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/AlertListResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/network-notifications/v1/alerts/active": {
      "post": {
        "summary": "Set alerts to active",
        "tags": [
          "Alerts"
        ],
        "operationId": "setActiveAlerts",
        "description": "This API endpoint sets the specified alerts to active status. This can be used to reactivate deferred alerts.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetActiveAlertsRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/AlertActionResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/network-notifications/v1/alerts/async-operations/{task-id}": {
      "get": {
        "summary": "Get async operation status",
        "tags": [
          "Alerts"
        ],
        "operationId": "alertActionStatus",
        "description": "This API endpoint retrieves the status of an asynchronous alert operation using the task ID returned from alert action endpoints (clear, defer, active, priority).\n",
        "parameters": [
          {
            "name": "task-id",
            "description": "The unique task identifier returned from an alert action request.\n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "abc123-def456-ghi789"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/AlertActionStatusResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/network-notifications/v1/alerts/classification": {
      "get": {
        "summary": "Get alerts classification",
        "tags": [
          "Alerts"
        ],
        "operationId": "alertsClassification",
        "description": "This API endpoint retrieves the classification of alerts based on the specified type. The classification provides aggregated counts of alerts grouped by the specified criteria.\n",
        "parameters": [
          {
            "name": "type",
            "description": "The type of classification to retrieve. This determines how alerts are grouped. \nPossible values are `severity`, `status`, `priority`, `category`, `device_type`, `impacted_devices`\n",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "category"
            }
          },
          {
            "name": "filter",
            "description": "OData Version 4.0 filter string to filter the alerts before classification.\n",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "siteId eq '1234567'"
            }
          },
          {
            "name": "search",
            "description": "Search string to filter alerts by name or summary before classification.\n",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "PoE"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/AlertsClassificationResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/network-notifications/v1/alerts/clear": {
      "post": {
        "summary": "Clear alerts",
        "tags": [
