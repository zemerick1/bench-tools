  "tags": [
    {
      "name": "Alert Configurations",
      "description": "APIs for managing alert configurations — retrieve threshold rules and severity settings per alert type and scope."
    }
  ],
  "paths": {
    "/network-notifications/v1/alert-config": {
      "get": {
        "summary": "List alert configurations",
        "tags": [
          "Alert Configurations"
        ],
        "operationId": "getAlertConfigs",
        "description": "Retrieves alert configurations for a given scope. Each configuration defines the threshold rules, severity mappings, and settings for a specific alert type. Configurations may be locally defined or inherited from a parent scope.\n\n**Scope types:**\n\n| Value | Description |\n|-------|-------------|\n| `GLOBAL` | Tenant-level scope (default) |\n| `SITE` | Site-level scope |\n| `DEVICE` | Device-level scope |\n\n**Pagination:**\n\nUse `limit` and `next` together to page through large result sets. When `limit` is supplied the response includes `total` (total available configurations) and `offset` (zero-based index of the first item returned), enabling clients to determine whether additional pages exist.\n",
        "parameters": [
          {
            "name": "scope-id",
            "description": "The scope identifier for which alert configurations are retrieved.\n",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1021882040"
            }
          },
          {
            "name": "scope-type",
            "description": "The scope type. Determines the level at which the configuration applies.\n\n| Value | Description |\n|-------|-------------|\n| `GLOBAL` | Tenant-level scope (default) |\n| `SITE` | Site-level scope |\n| `DEVICE` | Device-level scope |\n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "GLOBAL",
                "SITE",
                "DEVICE"
              ],
              "default": "GLOBAL",
              "example": "SITE"
            }
          },
          {
            "name": "limit",
            "description": "Maximum number of alert configurations to return per page. Defaults to `20` when not specified.\n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20
            }
          },
          {
            "name": "next",
            "description": "Zero-based offset of the first alert configuration to return. Use together with `limit` to paginate through results. Defaults to `0` when not specified.\n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "example": 0
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/AlertConfigListResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AlertConfigResponse": {
        "type": "object",
        "description": "A single alert configuration entry returned from the list endpoint.\n",
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable name of the alert type.\n",
            "example": "AP CPU Utilization"
          },
          "description": {
            "type": "string",
            "description": "Description of what the alert monitors.\n",
            "example": "Triggers when access point CPU usage exceeds configured thresholds."
          },
          "label": {
            "type": "string",
            "description": "Display label or tag for the alert configuration.\n",
            "example": "CPU"
          },
          "category": {
            "type": "string",
            "description": "Category the alert belongs to.\n",
            "example": "System"
          },
          "deviceType": {
            "type": "string",
            "description": "Type of device this alert applies to.\n",
            "example": "Access Point"
          },
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether this alert configuration is currently active or not.\n",
            "example": true
          },
          "ruleSource": {
            "type": "string",
            "description": "Indicates whether the rule is system-defined or user-defined.\n",
            "enum": [
              "SYSTEM",
              "USER"
            ],
            "example": "USER"
          },
          "clearTimeout": {
            "type": "string",
            "description": "Auto-clear timeout duration, e.g. `1H`, `30D`.\n",
            "example": "1H"
          },
          "inherited": {
            "type": "boolean",
            "description": "Indicates whether this configuration is inherited from a parent scope or not.\n",
            "example": false
          },
          "scopeId": {
            "type": "string",
            "description": "The scope identifier this configuration belongs to.\n",
            "example": "1021882040"
          },
          "scopeType": {
            "type": "string",
            "description": "The scope type this configuration belongs to.\n",
            "enum": [
              "GLOBAL",
              "SITE",
              "DEVICE"
            ],
            "example": "GLOBAL"
          },
          "rules": {
            "type": "array",
            "description": "List of threshold rules for this alert configuration.\n",
            "items": {
              "$ref": "#/components/schemas/AlertConfigRuleResponse"
            }
          }
        }
      },
      "AlertConfigRuleResponse": {
        "type": "object",
        "description": "A rule entry as returned by the list endpoint.\n",
        "properties": {
          "ruleNumber": {
            "type": "integer",
            "description": "Ordering index of this rule.\n",
            "example": 0
          },
          "rule": {
            "type": "object",
            "description": "Rule details.\n",
            "properties": {
              "duration": {
                "type": "integer",
                "description": "Observation window in minutes.\n",
                "example": 5
              },
              "condition": {
                "type": "array",
                "description": "List of severity-to-threshold conditions.\n",
                "items": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "type": "string",
                      "description": "Severity level for this condition.\n",
                      "example": "CRITICAL"
                    },
                    "expression": {
                      "type": "object",
                      "properties": {
                        "metric": {
                          "type": "string",
                          "example": "cpu_utilization"
                        },
                        "operator": {
                          "type": "string",
                          "example": "GTE"
                        },
                        "valueNumber": {
                          "type": "number",
                          "example": 90
                        }
                      }
                    }
                  }
                }
              },
              "additionalCondition": {
                "type": "array",
                "description": "List of supplementary metric conditions.\n",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "example": 0
                    },
                    "expression": {
                      "type": "object",
                      "properties": {
                        "metric": {
                          "type": "string",
                          "example": "occurrences"
                        },
                        "operator": {
                          "type": "string",
                          "example": "GTE"
                        },
                        "valueNumber": {
                          "type": "number",
                          "example": 100
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
