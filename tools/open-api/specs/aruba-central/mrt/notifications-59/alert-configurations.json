    "responses": {
      "AlertConfigListResponse": {
        "description": "List of alert configurations for the requested scope.\n",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "Paginated list of alert configurations.\n",
              "required": [
                "id",
                "type",
                "items",
                "count"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for this collection resource.\n",
                  "example": "network-notifications/v1/alert-config"
                },
                "type": {
                  "type": "string",
                  "description": "Resource type identifier.\n",
                  "example": "network-notifications/alert-configs"
                },
                "items": {
                  "type": "array",
                  "description": "List of alert configuration entries in the current page.\n",
                  "items": {
                    "$ref": "#/components/schemas/AlertConfigResponse"
                  }
                },
                "count": {
                  "type": "integer",
                  "description": "Number of alert configurations returned in the current page.\n",
                  "example": 10
                },
                "total": {
                  "type": "integer",
                  "description": "Total number of alert configurations available across all pages. Present only when the request includes a `limit` parameter.\n",
                  "example": 99
                },
                "offset": {
                  "type": "integer",
                  "description": "Zero-based index of the first item returned in this page. Present only when the request includes a `limit` parameter.\n",
                  "example": 0
                }
              },
              "example": {
                "count": 2,
                "total": 99,
                "offset": 0,
                "items": [
                  {
                    "name": "AP CPU Utilization",
                    "description": "Triggers when access point CPU usage exceeds configured thresholds.",
                    "label": "CPU",
                    "category": "System",
                    "deviceType": "Access Point",
                    "enabled": true,
                    "ruleSource": "USER",
                    "clearTimeout": "1H",
                    "inherited": false,
                    "scopeId": "1021882040",
                    "scopeType": "GLOBAL",
                    "rules": [
                      {
                        "ruleNumber": 0,
                        "rule": {
                          "duration": 5,
                          "metric": "cpu_utilization",
                          "condition": [
                            {
                              "severity": "CRITICAL",
                              "expression": {
                                "metric": "cpu_utilization",
                                "operator": "GTE",
                                "valueNumber": 90
                              }
                            },
                            {
                              "severity": "MAJOR",
                              "expression": {
                                "metric": "cpu_utilization",
                                "operator": "GTE",
                                "valueNumber": 80
                              }
                            },
                            {
                              "severity": "MINOR",
                              "expression": {
                                "metric": "cpu_utilization",
                                "operator": "GTE",
                                "valueNumber": 70
                              }
                            }
                          ],
                          "additionalCondition": []
                        }
                      }
                    ]
                  },
                  {
                    "name": "Switch CPU Utilization",
                    "description": "Triggers when switch CPU usage exceeds configured thresholds.",
                    "label": "CPU",
                    "category": "System",
                    "deviceType": "Switch",
                    "enabled": true,
                    "ruleSource": "SYSTEM",
                    "clearTimeout": null,
                    "inherited": false,
                    "scopeId": "1021882040",
                    "scopeType": "GLOBAL",
                    "rules": []
                  }
                ]
              }
            }
          }
        }
