  "paths": {
    "/network-notifications/v1/notification-rules": {
      "get": {
        "summary": "List all notification rules",
        "tags": [
          "Notification Rules"
        ],
        "operationId": "getNotificationRulesV1",
        "description": "This API endpoint retrieves the list of notification rules. The notification rules list includes data source and destination channel details.\nNOTE: The source.alerts.alertCount field in responses is a summary count; use getNotificationRuleV1 to retrieve the full list of alertNames",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/LimitParam"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OffsetParam"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/NotificationRules"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "post": {
        "summary": "Create a notification rule",
        "tags": [
          "Notification Rules"
        ],
        "operationId": "createNotificationRuleV1",
        "description": "This API is used to create a notification rule.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notificationRuleInput": {
                    "$ref": "#/components/schemas/NotificationRuleConfigInput"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/NotificationRuleCreated",
            "description": "Notification rule created successfully."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/network-notifications/v1/notification-rules/{id}": {
      "get": {
        "summary": "Retrieve a notification rule by its ID",
        "tags": [
          "Notification Rules"
        ],
        "operationId": "getNotificationRuleV1",
        "description": "This API endpoint retrieves a notification rule based on the id provided. The notification rule includes data source and destination channel details.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "description": "ID of the notification rule.",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "example": "3f96ffea-73fe-4a9b-b253-ddc58c76fe25"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/NotificationRule"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "delete": {
        "summary": "Delete a notification rule",
        "tags": [
          "Notification Rules"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "description": "ID of the notification rule.",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "example": "3f96ffea-73fe-4a9b-b253-ddc58c76fe25"
            }
          }
        ],
        "operationId": "deleteNotificationRuleV1",
        "description": "This API is used to delete a notification rule.",
        "responses": {
          "204": {
            "$ref": "#/components/responses/ResponseWithNoContent",
            "description": "Notification rule deleted successfully."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "patch": {
        "summary": "Update a notification rule",
        "tags": [
          "Notification Rules"
        ],
        "operationId": "updateNotificationRuleV1",
        "description": "This API is used to update a notification rule.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "description": "ID of the notification rule.",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "example": "3f96ffea-73fe-4a9b-b253-ddc58c76fe25"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/merge-patch+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notificationRuleInput": {
                    "$ref": "#/components/schemas/NotificationRuleUpdateInput"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/NotificationRule",
            "description": "Notification rule updated successfully."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
