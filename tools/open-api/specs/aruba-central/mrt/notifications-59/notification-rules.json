          "httpStatusCode": {
            "type": "integer",
            "minimum": 404,
            "maximum": 404,
            "description": "HTTP status code.",
            "example": 404
          },
          "errorCode": {
            "type": "string",
            "description": "Internal error code.",
            "maxLength": 256,
            "example": "HPE_GL_NETWORK_NOTIFICATIONS_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "maxLength": 512,
            "description": "Error message indicating the cause of the failure.",
            "example": "Notification rule not found."
          },
          "debugId": {
            "$ref": "#/components/schemas/DebugId"
          }
        }
      },
      "NotificationRule": {
        "type": "object",
        "description": "Notification rule details.",
        "required": [
          "id",
          "type",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "description": "Unique identifier of the notification rule.",
            "example": "3f96ffea-73fe-4a9b-b253-ddc58c76fe25"
          },
          "type": {
            "type": "string",
            "const": "network-notifications/notification-rule",
            "description": "Type identifier for the notification rule."
          },
          "name": {
            "type": "string",
            "maxLength": 128,
            "description": "Name of the notification rule.",
            "example": "email-rule"
          },
          "description": {
            "type": "string",
            "maxLength": 512,
            "description": "Description of the notification rule.",
            "example": "Notification rule for email alerts."
          },
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the notification rule is enabled.",
            "example": true
          },
          "sourceTypes": {
            "type": "array",
            "description": "List of source types for the notification rule.",
            "items": {
              "type": "string",
              "enum": [
                "ALERTS"
              ]
            }
          },
          "source": {
            "$ref": "#/components/schemas/NotificationRuleSource"
          },
          "destination": {
            "$ref": "#/components/schemas/NotificationRuleDestination"
          }
        }
      },
      "NotificationRuleConfigInput": {
        "type": "object",
        "description": "Notification rule config input details.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "description": "Name of the notification rule.",
            "example": "email-rule"
          },
          "description": {
            "type": "string",
            "maxLength": 512,
            "description": "Description of the notification rule.",
            "example": "Notification rule for email alerts."
          },
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the notification rule is enabled.",
            "example": true
          },
          "sourceTypes": {
            "type": "array",
            "description": "List of source types for the notification rule.",
            "items": {
              "type": "string",
              "enum": [
                "ALERTS"
              ]
            }
          },
          "source": {
            "$ref": "#/components/schemas/NotificationRuleSourceInput"
          },
          "destination": {
            "$ref": "#/components/schemas/NotificationRuleDestinationInput"
          }
        }
      },
      "NotificationRuleDestination": {
        "type": "object",
        "description": "Notification destination details for the notification rule.",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/NotificationRuleDestinationEmail"
          },
          "webhook": {
            "$ref": "#/components/schemas/NotificationRuleDestinationWebhook"
          },
          "syslog": {
            "$ref": "#/components/schemas/NotificationRuleDestinationSyslog"
          }
        }
      },
      "NotificationRuleDestinationEmail": {
        "type": "object",
        "description": "Email destination details for the notification rule.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the email destination is enabled.",
            "example": true
          },
          "emailIds": {
            "type": "array",
            "description": "List of email addresses for the notification rule.",
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 256,
              "example": "admin@domain.com"
            }
          }
        }
      },
      "NotificationRuleDestinationEmailInput": {
        "type": "object",
        "description": "Email destination details for the notification rule.",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the email destination is enabled.",
            "example": true
          },
          "emailIds": {
            "type": "array",
            "description": "List of email addresses for the notification rule. \nNOTE: The contents of this field are ignored if email destination is not enabled.",
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 256,
              "example": "admin@domain.com"
            }
          }
        }
      },
      "NotificationRuleDestinationInput": {
        "type": "object",
        "description": "Notification destination details for the notification rule.\nNOTE: At least one of the destination types (email, webhook or syslog) should be enabled to create or update a notification rule.",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/NotificationRuleDestinationEmailInput"
          },
          "webhook": {
            "$ref": "#/components/schemas/NotificationRuleDestinationWebhookInput"
          },
          "syslog": {
            "$ref": "#/components/schemas/NotificationRuleDestinationSyslogInput"
          }
        }
      },
      "NotificationRuleDestinationSyslog": {
        "type": "object",
        "description": "Syslog destination details for the notification rule.\nNOTE: Syslog destination is only supported in the Central On-Premise environment.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the syslog destination is enabled.",
            "example": true
          },
          "serverIds": {
            "type": "array",
            "description": "List of syslog server UUIDs for the notification rule.",
            "items": {
              "type": "string",
              "format": "uuid",
              "maxLength": 256,
              "example": "4d113fgh-abcd-ef"
            }
          }
        }
      },
      "NotificationRuleDestinationSyslogInput": {
        "type": "object",
        "description": "Syslog destination details for the notification rule.\nNOTE: Syslog destination is only supported in the Central On-Premise environment.",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the syslog destination is enabled.",
            "example": true
          },
          "serverIds": {
            "type": "array",
            "description": "List of syslog servers UUIDs for the notification rule.\nNOTE: The contents of this field are ignored if syslog destination is not enabled.",
            "items": {
              "type": "string",
              "format": "uuid",
              "maxLength": 256,
              "example": "4d113fgh-abcd-ef"
            }
          }
        }
      },
      "NotificationRuleDestinationWebhook": {
        "type": "object",
        "description": "Webhook destination details for the notification rule.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the webhook destination is enabled.",
            "example": true
          },
          "webhookIds": {
            "type": "array",
            "description": "List of webhook subscription UUIDs for the notification rule.",
            "items": {
              "type": "string",
              "format": "uuid",
              "maxLength": 512,
              "example": "4d113fgh-abcd-ef"
            }
          }
        }
      },
      "NotificationRuleDestinationWebhookInput": {
        "type": "object",
        "description": "Webhook destination details for the notification rule.",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the webhook destination is enabled.",
            "example": true
          },
          "webhookIds": {
            "type": "array",
            "description": "List of webhook subscription UUIDs for the notification rule.\n  The contents of this field are ignored if webhook destination is not enabled.\nNOTE: Check the Webhook API details for fetching the list of supported webhook subscription details.",
            "items": {
              "type": "string",
              "format": "uuid",
              "maxLength": 512,
              "example": "4d113fgh-abcd-ef"
            }
          }
        }
      },
      "NotificationRuleSource": {
        "type": "object",
        "description": "Data source details for the notification rule.",
        "properties": {
          "alerts": {
            "$ref": "#/components/schemas/NotificationRuleSourceAlerts"
          }
        }
      },
      "NotificationRuleSourceAlerts": {
        "type": "object",
        "description": "Alert source details for the notification rule.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the alert source is enabled.",
            "example": true
          },
          "alertNames": {
            "type": "array",
            "description": "List of alert names for the notification rule.",
            "items": {
              "type": "string",
              "maxLength": 256,
              "example": "AP CPU Utilization"
            }
          },
          "minAlertSeverity": {
            "type": "string",
            "description": "Minimum alert severity for the notification rule.",
            "enum": [
              "CRITICAL",
              "MAJOR",
              "MINOR",
              "INFO"
            ]
          }
        }
      },
      "NotificationRuleSourceAlertsInput": {
        "type": "object",
        "description": "Alert source details for the notification rule.",
        "required": [
          "enabled",
          "alertNames"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Indicates whether the alert source is enabled. \nNOTE: This field should be true to use alert source type. \n If this field is false, the notification rule will not be created.",
            "example": true
          },
          "alertNames": {
            "type": "array",
            "description": "List of alert names for the notification rule.\nNOTE: Check the Alerts configuration API details for fetching the list of supported alerts.",
            "items": {
              "type": "string",
              "maxLength": 256,
              "example": "AP CPU Utilization"
            }
          },
          "minAlertSeverity": {
            "type": "string",
            "description": "Minimum alert severity for the notification rule.",
            "enum": [
              "CRITICAL",
              "MAJOR",
              "MINOR",
              "INFO"
            ]
          }
        }
      },
      "NotificationRuleSourceAlertsSummary": {
        "type": "object",
        "description": "Alert source details for the notification rule.",
        "properties": {
