        "properties": {
          "siteId": {
            "type": "string",
            "example": "165678616917"
          },
          "siteName": {
            "type": "string",
            "example": "Bengaluru (BLR) - Campus"
          },
          "impactedDeviceCount": {
            "type": "integer",
            "example": 0
          },
          "impactedClientCount": {
            "type": "integer",
            "example": 0
          }
        }
      },
      "AIOpsInsightsSchemasResult": {
        "type": "object",
        "required": [
          "schemaJson",
          "count"
        ],
        "properties": {
          "schemaJson": {
            "type": "string",
            "description": "JSON string containing schema definitions keyed by insight ID.",
            "example": "{\"702\":{\"analyzer_id\":\"string\",\"category\":\"string\",\"timestamp\":\"long\"}}"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of insight schemas returned.",
            "example": 1
          }
        }
      },
      "AIOpsSourceRecommendations": {
        "type": "object",
