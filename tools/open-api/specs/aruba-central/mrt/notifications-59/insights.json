      "name": "Insights",
      "description": "APIs for retrieving source recommendations."
    }
  ],
  "paths": {
    "/network-notifications/v1/insights": {
      "get": {
        "summary": "List source recommendations",
        "tags": [
          "Insights"
        ],
        "operationId": "getSourceRecommendationsV1",
        "description": "Returns AI-powered recommendations for optimizing performance. For site-level granularity `site-id` and `insight-id` filter shall be provided and for global recommendations `site-id` and `insight-id` filter shall be omitted. At the global level, the API returns global recommendations (across all sites) along with siteId and insightId.",
        "parameters": [
          {
            "name": "site-id",
            "description": "Site identifier. Omit site-id to retrieve global recommendations across all sites. For site-level recommendations site-id can be obtained from the same API from global recommendations through the field `siteId`.",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "6985764272"
            }
          },
          {
            "name": "insight-id",
            "description": "Insight identifier. `insight-id` is used to filter recommendations, it can be obtained from the same API from global-level recommendations through the field 'insightId'.",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "702"
            }
          },
          {
            "name": "limit",
            "description": "Maximum number of recommendations to return per page.",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 50
            }
          },
          {
            "name": "offset",
            "description": "Number of recommendations to skip before starting to collect the result set.",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "example": 0
            }
          },
          {
            "name": "sort",
            "description": "Sort order for recommendations based on implicit field insight-id.",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ],
              "example": "ASC"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SourceRecommendationsResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/network-notifications/v1/insights-schema": {
      "get": {
        "summary": "Get insight schemas",
        "tags": [
          "Insights"
        ],
        "operationId": "getInsightSchemasV1",
        "description": "Returns the JSON schema definition for one or all available insights.\n\nBehavior:\n- If `insight-id` is provided, returns only the schema for that specific insight.\n- If `insight-id` is omitted, returns schemas for all available insights as a JSON string.",
        "parameters": [
          {
            "name": "insight-id",
            "description": "Insight type identifier (e.g. `702`). When omitted, all insight schemas are returned. `insight-id` can be obtained from global-level recommendations through the field `insightId`.",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "702"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/InsightsSchemasResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AIOpsGlobalSites": {
        "type": "object",
