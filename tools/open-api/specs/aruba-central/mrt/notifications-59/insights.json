          "id",
          "type",
          "timestamp",
          "tenantId",
          "siteId",
          "title",
          "description",
          "category",
          "insightId"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "example": "1770858000000"
          },
          "tenantId": {
            "type": "string",
            "example": "c539f92800ea11edbc10aa7fd39913ac"
          },
          "siteId": {
            "type": "string",
            "example": "6985764272"
          },
          "title": {
            "type": "string",
            "example": "Access Point Firmware Recommendation"
          },
          "description": {
            "type": "string",
            "example": "New firmware recommendation available for 3 access point(s) in the site. These upgrades provide new features and bug fixes."
          },
          "category": {
            "type": "string",
            "example": "Wireless"
          },
          "insightId": {
            "type": "string",
            "example": "702"
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for this record.",
            "example": "c539f92800ea11edbc10aa7fd39913ac_6985764272_702_8646_4_1770855661607"
          },
          "type": {
            "type": "string",
            "example": "network-notifications/insight"
          },
          "impactedSites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AIOpsGlobalSites"
            }
          },
          "data": {
            "type": [
              "string",
              "null"
            ],
            "description": "Complete recommendation payload serialized as a JSON string. Contains detailed information about the recommendation, including root cause analysis, and suggested actions and impacted devices.",
            "example": "{\"analyzer_id\":\"c539f92800ea11edbc10aa7fd39913ac_6985764272_702_8646_4_1770855661607\"}"
          }
        }
      },
      "AIOpsSourceRecommendationsResult": {
        "type": "object",
        "required": [
          "id",
          "type",
          "items",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this API resource.",
            "example": "network-notifications/v1/insights"
