    "parameters": {
      "Filter": {
        "name": "filter",
        "in": "query",
        "required": false,
        "description": "OData Version 4.0 filter string (limited functionality). Supports only 'and' conjunction ('or' and 'not' are NOT supported). Supported fields and operators are in the below given table.\n| Field | Operators |\n| --------- | -------- |\n| `siteId` | `eq` and `in` |\n| `siteName` | `eq` and `in` |\n| `serialNumber` | `eq` and `in` |\n| `deviceName` | `eq` and `in` |\n| `deviceType` | `eq` and `in` |\n| `upgradeStatus` | `eq` and `in` |\n| `firmwareClassification` | `eq` and `in` |\n| `firmwareVersion` | `eq` and `in` |\n\n**The operators are implemented as follows:**\n\n* `eq`: Only values exactly matching the given value are returned.\n\n* `in`: Only values present in the given list are returned.\n\n",
        "example": "siteId eq '12345' and deviceType in ('ACCESS_POINT', 'GATEWAY')",
        "schema": {
          "type": "string",
          "format": "const",
          "maxLength": 256
        }
      },
      "SortV1": {
        "name": "sort",
