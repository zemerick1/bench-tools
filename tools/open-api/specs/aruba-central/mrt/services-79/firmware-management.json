        ],
        "operationId": "getFirmwareDetailsListV1",
        "summary": "Get device list with firmware details",
        "description": "This API endpoint retrieves list of device's firmware details such as firmware version, upgrade status, recommended version, firmware classification and last upgraded timestamp.\n",
