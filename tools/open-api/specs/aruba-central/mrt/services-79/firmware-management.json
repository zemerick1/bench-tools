          {
            "$ref": "#/components/parameters/Filter"
          },
          {
            "$ref": "#/components/parameters/SortV1"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Denotes the maximum number of items returned in the response. Maximum value is 1000.\n",
            "schema": {
              "$ref": "#/components/schemas/Limitfirmware"
            }
          },
          {
            "name": "next",
            "required": false,
            "in": "query",
            "description": "Specifies the pagination cursor for the next page of resources. The minimum value is 1.\n",
            "schema": {
              "$ref": "#/components/schemas/Next"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/FirmwareDetailsListResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
