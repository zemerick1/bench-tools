  "paths": {
    "/network-services/v1/location-analytics/sites/insights": {
      "get": {
        "tags": [
          "Location Analytics"
        ],
        "summary": "Get the insights for each site of a tenant for a given time range.",
        "description": "This API provides the insights for each site of a tenant for a given time range.",
        "operationId": "getLaSitesInsightsForAPIV1",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/start-at"
          },
          {
            "$ref": "#/components/parameters/end-at"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
