        }
      }
    },
    "/network-services/v1/location-analytics/trends": {
      "get": {
        "tags": [
          "Location Analytics"
        ],
        "summary": "Get all the trends of a client for a tenant or a site for a given time range.",
        "description": "This API provides the trends of visitors and passerby for a tenant across all the sites or for a specific site within the given time range.",
        "operationId": "getLaTrendsForAPIV1",
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/start-at"
