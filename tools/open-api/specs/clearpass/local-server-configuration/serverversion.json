{
  "openapi": "3.0.0",
  "info": {
    "title": "ServerVersion",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "ServerVersion",
      "description": "Get server version information"
    }
  ],
  "paths": {
    "/server/version": {
      "get": {
        "summary": "Get server version information",
        "description": "Get server version information",
        "operationId": "ServerVersionVersionGet",
        "deprecated": false,
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerVersionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "ServerVersion"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "InstalledPatchInfo": {
        "title": "InstalledPatchInfo",
        "type": "object",
        "properties": {
          "name": {
            "description": "Unique name of the patch",
            "type": "string"
          },
          "description": {
            "description": "Description of the patch",
            "type": "string"
          },
          "installed": {
            "description": "Time and date of the patch installation",
            "type": "string"
          }
        },
        "required": [
          "name",
          "installed"
        ]
      },
      "ServerVersionResponse": {
        "title": "ServerVersionResponse",
        "type": "object",
        "properties": {
          "cppm_version": {
            "description": "ClearPass Policy Manager version",
            "type": "string"
          },
          "guest_version": {
            "description": "ClearPass Guest version",
            "type": "string"
          },
          "installed_patches": {
            "description": "Patches that have been installed on this server",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstalledPatchInfo"
            }
          }
        },
        "required": [
          "cppm_version",
          "guest_version",
          "installed_patches"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ClearPass REST API. Authorization: Bearer <access_token>"
      }
    }
  }
}
