  "components": {
    "schemas": {
      "ADDomainJoin": {
        "title": "ADDomainJoin",
        "type": "object",
        "properties": {
          "domain_controller": {
            "description": "FQDN of the domain controller",
            "type": "string"
          },
          "netbios_name": {
            "description": "NetBIOS name of the domain",
            "type": "string"
          },
          "on_name_conflict": {
            "description": "Action to perform in case of a controller name conflict(1 - Use specified Domain Controller, 2 - Use Domain Controller returned by DNS query, 3 - Fail on conflict)",
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "description": "Domain username ",
            "type": "string"
          },
          "password": {
            "description": "Domain password",
            "type": "string"
          }
        },
        "required": [
          "domain_controller",
          "netbios_name",
          "on_name_conflict",
          "username",
          "password"
        ]
      },
      "ADDomainLeave": {
        "title": "ADDomainLeave",
        "type": "object",
        "properties": {
          "netbios_name": {
            "description": "NetBIOS name of the domain",
            "type": "string"
          },
          "username": {
            "description": "Domain username ",
            "type": "string"
          },
          "password": {
            "description": "Domain password",
            "type": "string"
          },
          "force_leave": {
            "description": "Leave domain even if AD is down",
            "type": "boolean"
          }
        },
        "required": [
          "netbios_name",
          "username",
          "password",
          "force_leave"
        ]
      },
      "ADDomainResult": {
        "title": "ADDomainResult",
        "type": "object",
        "properties": {
          "domain_controller": {
            "description": "FQDN of the domain controller",
            "type": "string"
          },
          "netbios_name": {
            "description": "NetBIOS name of the domain",
            "type": "string"
          },
          "password_servers": {
            "description": "List of Hostname or IP Address of the AD password servers",
            "type": "object"
          }
        },
        "required": [
          "domain_controller",
          "netbios_name",
          "password_servers"
        ]
      },
      "ADDomainStatus": {
        "title": "ADDomainStatus",
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "status_message": {
            "description": "Response message of AD domain join/leave operation",
            "type": "string"
          }
        },
        "required": [
          "status",
          "status_message"
        ]
      },
      "ADDomainUpdate": {
        "title": "ADDomainUpdate",
        "type": "object",
        "properties": {
          "netbios_name": {
            "description": "NetBIOS name of the domain",
            "type": "string"
          },
          "password_servers": {
            "description": "List of Hostname or IP Address of the AD password servers",
            "type": "object"
          }
        },
        "required": [
          "netbios_name",
          "password_servers"
        ]
      },
      "Status": {
        "title": "Status",
        "description": "Status of AD domain join/leave operation",
        "example": "SUCCESS",
        "type": "string",
        "enum": [
          "SUCCESS",
          "RUNNING"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ClearPass REST API. Authorization: Bearer <access_token>"
      }
    }
