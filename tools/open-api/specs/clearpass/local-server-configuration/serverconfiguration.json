  "components": {
    "schemas": {
      "ServerConfigurationChange": {
        "title": "ServerConfigurationChange",
        "type": "object",
        "properties": {
          "is_insight_enabled": {
            "description": "True if this server has Insight reporting enabled",
            "type": "boolean"
          }
        }
      },
      "ServerConfigurationResult": {
        "title": "ServerConfigurationResult",
        "type": "object",
        "properties": {
          "name": {
            "description": "Display name of server",
            "type": "string"
          },
          "local_server": {
            "description": "True if this server is processing this API request",
            "type": "boolean"
          },
          "server_uuid": {
            "description": "Unique identifier for server",
            "type": "string"
          },
          "server_dns_name": {
            "description": "Hostname of server",
            "type": "string"
          },
          "fqdn": {
            "description": "Fully-qualified domain name of server",
            "type": "string"
          },
          "server_ip": {
            "description": "IPv4 address of the server’s data port; may be null if not configured",
            "type": "string"
          },
          "management_ip": {
            "description": "IPv4 address of the server’s management port; may be null if not configured",
            "type": "string"
          },
          "ipv6_server_ip": {
            "description": "IPv6 address of the server’s data port; may be null if not configured",
            "type": "string"
          },
          "ipv6_management_ip": {
            "description": "IPv6 address of the server’s management port; may be null if not configured",
            "type": "string"
          },
          "is_publisher": {
            "description": "True if this server is the publisher within the cluster",
            "type": "boolean"
          },
          "is_insight_enabled": {
            "description": "True if this server has Insight reporting enabled",
            "type": "boolean"
          },
          "is_insight_primary": {
            "description": "True if this server is the Insight primary server",
            "type": "boolean"
          },
          "replication_status": {
            "description": "Indicates the replication status of this server within the cluster",
            "type": "string"
          },
          "last_replication_timestamp": {
            "description": "Last timestamp for replicated data; null if replication has never occurred",
            "type": "string"
          },
          "is_profiler_enabled": {
            "description": "True if this server is the Insight primary server",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "local_server",
          "server_uuid",
          "server_dns_name",
          "fqdn",
          "server_ip",
          "management_ip",
          "ipv6_server_ip",
          "ipv6_management_ip",
          "is_publisher",
          "is_insight_enabled",
          "is_insight_primary",
          "replication_status",
