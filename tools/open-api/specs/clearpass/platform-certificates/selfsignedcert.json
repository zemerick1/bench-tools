  "components": {
    "schemas": {
      "CertificateType": {
        "title": "CertificateType",
        "description": "Certificate Type",
        "example": "SERVER",
        "type": "string",
        "enum": [
          "SERVER",
          "SERVICE"
        ]
      },
      "DigestAlgorithm": {
        "title": "DigestAlgorithm",
        "description": "Digest Algorithm",
        "example": "SHA-1",
        "type": "string",
        "enum": [
          "SHA-1",
          "SHA-224",
          "SHA-256",
          "SHA-384",
          "SHA-512"
        ]
      },
      "PrivateKeyType": {
        "title": "PrivateKeyType",
        "description": "Private Key Type",
        "example": "2048-bit rsa",
        "type": "string",
        "enum": [
          "2048-bit rsa",
          "3072-bit rsa",
          "4096-bit rsa",
          "nist/secg curve over a 256 bit prime field",
          "nist/secg curve over a 384 bit prime field",
          "nist/secg curve over a 521 bit prime field"
        ]
      },
      "SelfSignedCertCreate": {
        "title": "SelfSignedCertCreate",
        "type": "object",
        "properties": {
          "certificate_type": {
            "$ref": "#/components/schemas/CertificateType"
          },
          "server": {
            "description": "Server hostname",
