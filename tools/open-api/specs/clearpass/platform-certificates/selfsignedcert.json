            "description": "Private Key Password",
            "type": "string"
          },
          "private_key_type": {
            "$ref": "#/components/schemas/PrivateKeyType"
          },
          "digest_algorithm": {
            "$ref": "#/components/schemas/DigestAlgorithm"
