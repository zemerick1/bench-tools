          "type": {
            "$ref": "#/components/schemas/Type"
          },
          "subject_CN": {
            "description": "Common Name (CN)",
            "type": "string"
          },
          "subject_O": {
            "description": "Organization (O)",
            "type": "string"
          },
          "subject_OU": {
            "description": "Organizational Unit (OU)",
            "type": "string"
          },
          "subject_L": {
            "description": "Location (L)",
            "type": "string"
          },
          "subject_ST": {
            "description": "State (ST)",
            "type": "string"
          },
          "subject_C": {
            "description": "Country (C)",
            "type": "string"
          },
          "subject_SAN": {
            "description": "Subject Alternate Name (SAN)",
            "type": "string"
          },
