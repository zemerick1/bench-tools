      "Type": {
        "title": "Type",
        "description": "Service Type",
        "example": "RADIUS/EAP Server Certificate",
        "type": "string",
        "enum": [
          "RADIUS/EAP Server Certificate",
          "HTTPS(ECC) Server Certificate",
          "HTTPS(RSA) Server Certificate",
          "RadSec Server Certificate",
          "Database Server Certificate"
        ]
      }
