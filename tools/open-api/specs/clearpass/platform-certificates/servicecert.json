  "components": {
    "schemas": {
      "HalLinks": {
        "title": "HalLinks",
        "type": "object",
        "properties": {
          "self": {
            "description": "URL of result",
            "type": "string"
          },
          "first": {
            "description": "URL of first page of results",
            "type": "string"
          },
          "last": {
            "description": "URL of last page of results",
            "type": "string"
          },
          "prev": {
            "description": "URL of previous page of results",
            "type": "string"
          },
          "next": {
            "description": "URL of next page of results",
            "type": "string"
          }
        },
        "required": [
          "self",
          "first"
        ]
      },
      "ServiceCertCreate": {
        "title": "ServiceCertCreate",
        "type": "object",
        "properties": {
          "certificate_url": {
            "description": "Certificate File URL",
            "type": "string"
          },
          "pkcs12_file_url": {
            "description": "PKCS12 File URL",
            "type": "string"
          },
          "pkcs12_passphrase": {
            "description": "PKCS12 passphrase",
            "type": "string"
          }
        }
      },
      "ServiceCertItems": {
        "title": "ServiceCertItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceCertResult"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ServiceCertList": {
        "title": "ServiceCertList",
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/ServiceCertItems"
          },
          "_links": {
            "$ref": "#/components/schemas/HalLinks"
          },
          "count": {
            "description": "Total number of items matching the filter; returned if calculate_count is true",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "_embedded",
          "_links"
        ]
      },
      "ServiceCertResult": {
        "title": "ServiceCertResult",
        "type": "object",
        "properties": {
          "id": {
            "description": "Numeric ID of the service certificate ",
            "format": "int64",
            "type": "integer"
          },
          "subject": {
            "description": "Subject of the service certificate ",
            "type": "string"
          },
          "expiry_date": {
            "description": "Expiry date of the service certificate ",
            "type": "string"
          },
          "issue_date": {
            "description": "Issue date of the service certificate",
            "type": "string"
          },
          "issue_by": {
            "description": "Service certificate issued by",
            "type": "string"
          },
          "validity": {
            "description": "Validity of the service certificate ",
            "type": "string"
          },
          "root_ca_cert": {
            "description": "Root CA Certificate",
            "type": "object"
          },
          "intermediate_ca_cert": {
            "description": "Intermediate CA Certificate",
            "type": "object"
          },
          "cert_file": {
            "description": "Certificate File",
            "type": "string"
          }
        },
        "required": [
          "id",
          "subject",
          "expiry_date",
          "issue_date",
          "issue_by",
          "validity",
          "root_ca_cert",
          "intermediate_ca_cert",
          "cert_file"
        ]
      }
    },
