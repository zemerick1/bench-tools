{
  "openapi": "3.0.0",
  "info": {
    "title": "CertSignRequest",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "tags": [
    {
      "name": "CertSignRequest",
      "description": "Manage Certificate Signing Requests"
    }
  ],
  "paths": {
    "/cert-sign-request": {
      "post": {
        "summary": "Post a certificate sign request",
        "description": "Post a certificate sign request",
        "operationId": "CertSignRequestPost",
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertSignRequestCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertSignRequestResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "CertSignRequest"
        ],
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "CertSignRequestCreate": {
        "title": "CertSignRequestCreate",
        "type": "object",
        "properties": {
          "subject_CN": {
            "description": "Common Name (CN)",
            "type": "string"
          },
          "subject_O": {
            "description": "Organization (O)",
            "type": "string"
          },
          "subject_OU": {
            "description": "Organizational Unit (OU)",
            "type": "string"
          },
          "subject_L": {
            "description": "Location (L)",
            "type": "string"
          },
          "subject_ST": {
            "description": "State (ST)",
            "type": "string"
          },
          "subject_C": {
            "description": "Country (C)",
            "type": "string"
          },
          "subject_SAN": {
            "description": "Subject Alternate Name (SAN)",
            "type": "string"
          },
          "private_key_password": {
            "description": "Private Key Password",
            "type": "string"
          },
          "private_key_type": {
            "$ref": "#/components/schemas/PrivateKeyType"
          },
          "digest_algorithm": {
            "$ref": "#/components/schemas/DigestAlgorithm"
          }
        },
        "required": [
          "subject_CN",
          "private_key_password",
          "private_key_type",
          "digest_algorithm"
        ]
      },
      "CertSignRequestResult": {
        "title": "CertSignRequestResult",
        "type": "object",
        "properties": {
          "cert_sign_request": {
            "description": "PEM encoded Certificate Signing Request ",
            "type": "string"
          }
        },
        "required": [
          "cert_sign_request"
        ]
      },
      "DigestAlgorithm": {
        "title": "DigestAlgorithm",
        "description": "Digest Algorithm",
        "example": "SHA-1",
        "type": "string",
        "enum": [
          "SHA-1",
          "SHA-224",
          "SHA-256",
          "SHA-384",
          "SHA-512"
        ]
      },
      "PrivateKeyType": {
        "title": "PrivateKeyType",
        "description": "Private Key Type",
        "example": "2048-bit rsa",
        "type": "string",
        "enum": [
          "2048-bit rsa",
          "3072-bit rsa",
          "4096-bit rsa",
          "nist/secg curve over a 256 bit prime field",
          "nist/secg curve over a 384 bit prime field",
          "nist/secg curve over a 521 bit prime field"
        ]
      }
    }
  }
}
