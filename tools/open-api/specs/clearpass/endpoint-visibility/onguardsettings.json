            "description": "Agent version. This is read only field",
            "type": "string"
          },
          "agentLibraryVersion": {
            "description": "Version of the OnGuard Agent Library. This is read-only field",
            "type": "string"
          },
          "installer_modified_time": {
            "description": "Time when Agent Installers was last updated. This is read only field",
            "type": "string"
          },
          "installer_modified_time_formatted": {
            "description": "Formatted Time when Agent Installers was last updated. This is read only field",
