          },
          "field_username_caption": {
            "description": "Caption for username field",
            "type": "string"
          },
          "field_password_caption": {
            "description": "Caption for password field",
            "type": "string"
          },
          "cert_filter_criteria": {
            "description": "Filter criteria used by OnGuard client to select certificates for authentication",
            "type": "string"
          },
          "upgrade_action": {
            "$ref": "#/components/schemas/UpgradeAction"
          },
          "install_vpn_component": {
            "description": "Install VIA component",
