        "enum": [
          "cert",
          "password"
        ]
      },
      "IpVersionAgentless": {
        "title": "IpVersionAgentless",
        "description": "IP Version for Server Communication (Agentless)",
        "example": "IPv4Only",
        "type": "string",
        "enum": [
          "IPv4Only",
          "IPv6Only",
          "dualPreferIPv4",
          "dualPreferIPv6",
          "dualBoth"
        ]
      },
      "IpVersionNative": {
        "title": "IpVersionNative",
        "description": "IP Version for Server Communication (Native)",
        "example": "IPv4Only",
        "type": "string",
        "enum": [
