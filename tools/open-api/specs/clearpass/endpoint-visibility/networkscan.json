  "components": {
    "schemas": {
      "DayOfWeek": {
        "title": "DayOfWeek",
        "description": "Day of Week for WEEKLY Network Scan",
        "example": "MONDAY",
        "type": "string",
        "enum": [
          "MONDAY",
          "TUESDAY",
          "WEDNESDAY",
          "THURSDAY",
          "FRIDAY",
          "SATURDAY",
          "SUNDAY"
        ]
      },
      "Depth": {
        "title": "Depth",
        "description": "Depth level for DISCOVERY Network Scan",
        "example": 1,
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4,
          5
        ]
      },
      "NetworkScanCreate": {
        "title": "NetworkScanCreate",
        "type": "object",
        "properties": {
          "zone": {
            "description": "Zone for the Network Scan",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/Type"
          },
          "seed_device_or_ip_subnet": {
            "description": "Network IP for DISCOVERY (e.g. [\"hostname.example.com\", \"1.2.3.4\"]) or IP Subnets for SUBNET (e.g. [\"10.1.0.0/16\"]) Network Scan",
            "type": "string"
          },
          "scan_frequency": {
            "$ref": "#/components/schemas/ScanFrequency"
          },
          "start_time": {
            "description": "Start time (HH:MM) of Network Scan  (e.g. [\"10:40\", \"23:20\"])",
            "type": "string"
          },
          "interval": {
            "description": "Interval in hours (3 - 350) for HOURLY Network Scan",
            "format": "int64",
            "type": "integer"
          },
          "day_of_week": {
            "$ref": "#/components/schemas/DayOfWeek"
          },
          "depth": {
            "$ref": "#/components/schemas/Depth"
          },
          "probe_arp": {
            "description": "Probe all ARP entries found (default=false for type=\"DISCOVERY\", not applicable for type=\"SUBNET\")",
            "type": "boolean"
          },
          "enabled": {
            "description": "Is Network Scan enabled? (default=true)",
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "zone",
          "seed_device_or_ip_subnet",
          "scan_frequency"
        ]
      },
