  "components": {
    "schemas": {
      "ApiClient": {
        "title": "ApiClient",
        "type": "object",
        "properties": {
          "access_lifetime": {
            "description": "Lifetime of an OAuth2 access token",
            "type": "string"
          },
          "access_token_lifetime": {
            "description": "Specify the lifetime of an OAuth2 access token",
            "type": "string"
          },
          "access_token_lifetime_units": {
            "description": "Specify the lifetime of an OAuth2 access token",
            "type": "string"
          },
          "auto_confirm": {
            "description": "Not supported at this time",
            "format": "int64",
            "type": "integer"
          },
          "client_description": {
            "description": "Use this field to store comments or notes about this API client",
            "type": "string"
          },
          "client_id": {
            "description": "The unique string identifying this API client.  Use this value in the OAuth2 “client_id” parameter",
            "type": "string"
          },
          "client_public": {
            "description": "Public clients have no client secret",
            "type": "boolean"
          },
          "client_refresh": {
            "description": "An OAuth2 refresh token may be used to obtain an updated access token.\nUse grant_type=refresh_token for this",
            "type": "boolean"
          },
          "client_secret": {
            "description": "Use this value in the OAuth2 “client_secret” parameter. NOTE: This value is encrypted when stored and cannot be retrieved.",
            "type": "string"
          },
          "enabled": {
            "description": "Enable API client",
            "type": "boolean"
          },
          "id": {
            "description": "The unique string identifying this API client.  Use this value in the OAuth2 “client_id” parameter",
            "type": "string"
          },
          "grant_types": {
            "description": "Only the selected authentication method will be permitted for use with this client ID",
            "type": "string"
          },
          "profile_id": {
            "description": "The operator profile applies role-based access control to authorized OAuth2 clients.\nThis determines what API objects and methods are available for use",
            "format": "int64",
            "type": "integer"
          },
          "profile_name": {
            "description": "Name of operator profile",
            "type": "string"
          },
          "redirect_uri": {
            "description": "Not supported at this time",
            "type": "string"
          },
          "refresh_lifetime": {
            "description": "Lifetime of an OAuth2 refresh token",
            "type": "string"
          },
          "refresh_token_lifetime": {
            "description": "Specify the lifetime of an OAuth2 refresh token",
            "type": "string"
          },
          "refresh_token_lifetime_units": {
            "description": "Specify the lifetime of an OAuth2 refresh token",
            "type": "string"
          },
          "scope": {
            "description": "Not supported at this time",
            "type": "string"
          },
          "user_id": {
            "description": "Not supported at this time",
            "type": "string"
          }
        },
        "required": [
          "access_token_lifetime",
          "access_token_lifetime_units",
          "client_id",
          "id",
          "refresh_token_lifetime",
          "refresh_token_lifetime_units"
        ]
      },
      "ApiClientItems": {
        "title": "ApiClientItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
