  "components": {
    "schemas": {
      "CurrentState": {
        "title": "CurrentState",
        "description": "Read-only property indicating the current state of the account",
        "example": "active",
        "type": "string",
        "enum": [
          "active",
          "disabled",
          "expired",
          "pending"
        ]
      },
      "DeviceCreate": {
        "title": "DeviceCreate",
        "type": "object",
        "properties": {
          "create_time": {
            "description": "Time at which the account was created",
            "format": "date-time",
            "type": "string"
          },
          "current_state": {
            "$ref": "#/components/schemas/CurrentState"
          },
          "enabled": {
            "description": "Flag indicating if the account is enabled",
            "type": "boolean"
          },
          "expire_time": {
            "description": "Time at which the account will expire",
            "format": "date-time",
            "type": "string"
          },
          "mac": {
            "description": "MAC address of the device",
            "type": "string"
          },
          "notes": {
            "description": "Comments or notes stored with the account",
            "type": "string"
          },
          "role_id": {
            "description": "Role to assign to the account",
            "format": "int64",
            "type": "integer"
          },
          "role_name": {
            "description": "Name of the role assigned to the account",
            "type": "string"
          },
          "source": {
            "description": "Origin of the account",
            "type": "string"
          },
          "sponsor_name": {
            "description": "Name of the sponsor of the account",
            "type": "string"
          },
          "sponsor_profile": {
            "description": "Numeric operator profile ID for the account’s sponsor",
            "type": "string"
          },
          "sponsor_profile_name": {
            "description": "Name of the operator profile for the account’s sponsor",
