  "components": {
    "schemas": {
      "CurrentState": {
        "title": "CurrentState",
        "description": "Read-only property indicating the current state of the account",
        "example": "active",
        "type": "string",
        "enum": [
          "active",
          "disabled",
          "expired",
          "pending"
        ]
      },
      "GuestUserCreate": {
        "title": "GuestUserCreate",
        "type": "object",
        "properties": {
          "create_time": {
            "description": "Time at which the account was created",
            "format": "date-time",
            "type": "string"
          },
          "do_expire": {
            "description": "Action to take when the expire_time is reached",
            "format": "int64",
            "type": "integer"
          },
          "email": {
            "description": "Email address for the account",
            "type": "string"
          },
          "enabled": {
            "description": "Flag indicating if the account is enabled",
            "type": "boolean"
          },
          "expire_time": {
            "description": "Time at which the account will expire",
            "format": "date-time",
            "type": "string"
          },
          "mac": {
            "description": "MAC address of the guest’s device",
            "type": "string"
          },
          "notes": {
            "description": "Comments or notes stored with the account",
            "type": "string"
          },
          "password": {
            "description": "Password for the account",
            "type": "string"
          },
          "role_id": {
            "description": "Role to assign to the account",
            "format": "int64",
            "type": "integer"
          },
          "simultaneous_use": {
