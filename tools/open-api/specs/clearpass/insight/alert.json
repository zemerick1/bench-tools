  "components": {
    "schemas": {
      "Alert": {
        "title": "Alert",
        "type": "object",
        "properties": {
          "id": {
            "description": "Numeric id of the alert",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "description": "Name of the alert",
            "type": "string"
          },
          "description": {
            "description": "Description of the alert",
            "type": "string"
          },
          "category": {
            "description": "Category of the alert",
            "type": "string"
          },
          "subcategory": {
            "description": "Sub category is the template name of the alert",
            "type": "string"
          },
          "email_targets": {
            "description": "Send alert notification to the configured email targets, e.g. \"email_targets\":[\"...\", \"...\"]",
            "type": "object"
          },
          "sms_targets": {
            "description": "Send alert notification to the configured SMS targets, e.g. \"sms_targets\":[\"...\", \"...\"]",
            "type": "object"
          },
          "config": {
            "description": "Setting the alert filter configurations & adding CSV columns for the CSV report,\n                    e.g. \"config\": {\n                            \"filter\": {\n                                \"auth.ap_name\": {\n                                    \"operator\": \"EQUALS\",\n                                    \"value\": [\"...\"]\n                                },\n                                \"cppm_cluster.hostname\": {\n                                    \"operator\":\"CONTAINS\",\n                                    \"value\":[\"...\", \"...\"]\n                                }\n                            }\n                        }",
            "type": "object"
          },
          "severity": {
            "description": "Severity of the alert, either \"critical\" or \"warning\"",
            "type": "string"
          },
          "threshold": {
            "description": "Triggering the alert when reaching the specified numeric threshold value",
            "format": "int64",
            "type": "integer"
          },
          "interval": {
            "description": "Triggering the alert at the numeric interval",
            "format": "int64",
            "type": "integer"
          },
          "interval_unit": {
            "description": "Interval units either \"minute\" or \"hour\"",
            "type": "string"
          },
          "is_enabled": {
            "description": "Enable/Disable the alert",
            "type": "boolean"
          },
          "is_muted": {
            "description": "Mute/Unmute the alert",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "subcategory",
          "email_targets",
          "severity",
          "threshold",
          "interval",
          "interval_unit"
        ]
      }
    },
    "requestBodies": {
      "Alert": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Alert"
            }
          }
        },
        "description": "Request body",
        "required": true
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ClearPass REST API. Authorization: Bearer <access_token>"
      }
    }
  }
