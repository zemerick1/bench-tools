  "components": {
    "schemas": {
      "Report": {
        "title": "Report",
        "type": "object",
        "properties": {
          "id": {
            "description": "Numeric id of the report",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "description": "Name of the report",
            "type": "string"
          },
          "description": {
            "description": "Description of the report",
            "type": "string"
          },
          "language": {
            "description": "Language of the report",
            "type": "string"
          },
          "category": {
            "description": "Category of the report",
            "type": "string"
          },
          "subcategory": {
            "description": "Sub category is the template name of the report",
            "type": "string"
          },
          "email_targets": {
            "description": "Send report to the configured email targets, e.g. \"email_targets\":[\"...\", \"...\"]",
            "type": "object"
          },
          "sms_targets": {
            "description": "Send report to the configured SMS targets, e.g. \"sms_targets\":[\"...\", \"...\"]",
            "type": "object"
          },
          "copy_remote": {
            "description": "Enable to copy the report to the configured SCP/SFTP server",
            "type": "boolean"
          },
          "config": {
            "description": "Setting the report filter configurations & adding CSV columns for the CSV report,\n                    e.g. \"config\": {\n                            \"filter\": {\n                                \"auth.ap_name\": {\n                                    \"operator\": \"EQUALS\",\n                                    \"value\": [\"...\"]\n                                },\n                                \"cppm_cluster.hostname\": {\n                                    \"operator\":\"CONTAINS\",\n                                    \"value\":[\"...\", \"...\"]\n                                }\n                            },\n                            csv_cols\": [\"...\", \"...\", \"...\"]\n                        }",
            "type": "object"
          },
          "schedule": {
            "description": "Scheduling the report. Options are [noRepeat, daily, weekly, monthly],\n                    e.g. when running the report \"now\" itself => \"schedule\": {} - then \"begin_dt\" & \"end_dt\" are mandatory,\n                         when scheduling the report at \"daily\" => \"schedule\": {\"freq\": \"daily\", \"hour\": 12}\n                         when scheduling the report at \"weekly\" => \"schedule\": {\"freq\": \"weekly\", \"day\": 0, \"hour\": 12}\n                         when scheduling the report at \"monthly\" => \"schedule\": {\"freq\": \"monthly\", \"date\": 1, \"hour\": 12}\n                ",
            "type": "object"
          },
          "begin_dt": {
            "description": "Collect the data for the report from this \"begin_dt\"",
            "format": "int64",
            "type": "integer"
          },
          "end_dt": {
            "description": "Collect the data for the report till this \"end_dt\"",
            "type": "string"
          },
          "is_enabled": {
            "description": "Enable/Disable the report",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "subcategory"
        ]
      }
    },
