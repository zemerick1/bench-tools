  "components": {
    "schemas": {
      "EndpointInfo": {
        "title": "EndpointInfo",
        "type": "object",
        "properties": {
          "mac": {
            "description": "MAC Address of the endpoint",
            "type": "string"
          },
          "ip": {
            "description": "IP Address of the endpoint",
            "type": "string"
          },
          "ipv6": {
            "description": "IPv6 Address list of the endpoint",
            "type": "object"
          },
          "user": {
            "description": "Username of the endpoint",
            "type": "string"
          },
          "domain": {
            "description": "Domain of the endpoint",
            "type": "string"
          },
          "roles": {
            "description": "Roles list of the endpoint",
            "type": "object"
          },
          "spt": {
            "$ref": "#/components/schemas/Spt"
          },
          "aruba_user_role": {
            "description": "Aruba user role of the session",
            "type": "string"
          },
          "aruba_user_vlan": {
            "description": "Aruba user vlan of the session",
            "type": "string"
          },
          "device_category": {
            "description": "Device category of the endpoint",
            "type": "string"
          },
          "device_family": {
            "description": "Device family of the endpoint",
            "type": "string"
          },
          "device_name": {
            "description": "Device name of the endpoint",
            "type": "string"
          },
          "is_conflict": {
            "description": "Flag indicating if the endpoint has conflict",
            "type": "boolean"
          },
          "other_category": {
            "description": "Other category of the endpoint",
            "type": "string"
          },
          "other_family": {
            "description": "Other family of the endpoint",
            "type": "string"
          },
          "other_name": {
            "description": "Other name of the endpoint",
            "type": "string"
          },
          "updated_at": {
            "description": "Time at which the endpoint is updated",
            "type": "string"
          },
          "is_online": {
            "description": "Flag indicating if the endpoint is online",
            "type": "boolean"
          }
        },
        "required": [
          "mac",
          "ip",
          "ipv6",
          "user",
          "domain",
          "roles",
          "spt",
          "aruba_user_role",
          "aruba_user_vlan",
          "device_category",
          "device_family",
          "device_name",
          "is_conflict",
          "other_category",
          "other_family",
          "other_name",
          "is_online",
          "updated_at"
        ]
      },
      "EndpointInfoItems": {
        "title": "EndpointInfoItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EndpointInfo"
            }
          }
        }
      },
      "EndpointInfoList": {
        "title": "EndpointInfoList",
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/EndpointInfoItems"
          }
        }
      },
      "Spt": {
        "title": "Spt",
        "description": "System posture token of the endpoint",
        "example": "HEALTHY",
        "type": "string",
        "enum": [
          "HEALTHY",
          "CHECKUP",
          "TRANSITION",
          "QUARANTINE",
          "INFECTED",
          "UNKNOWN"
        ]
      }
    }
  }
