        "properties": {
          "username": {
            "description": "User name",
            "type": "string"
          },
          "timestamp": {
            "description": "Timestamp at which the query is executed",
            "type": "string"
          },
          "last_successful_login": {
            "description": "Contains details of previous successful login",
            "type": "object"
          },
          "last_failure_login": {
            "description": "Contains all failure attempts in-between previous successful login and now",
            "type": "object"
          }
        },
        "required": [
          "timestamp",
          "username",
          "last_successful_login",
          "last_failure_login"
        ]
