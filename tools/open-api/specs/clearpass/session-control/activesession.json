{
  "openapi": "3.0.0",
  "info": {
    "title": "ActiveSession",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "tags": [
    {
      "name": "ActiveSession",
      "description": "Manage active sessions"
    }
  ],
  "paths": {
    "/session": {
      "get": {
        "summary": "Get a list of active sessions",
        "description": "Get a list of active sessions. ",
        "operationId": "ActiveSessionGet",
        "deprecated": false,
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "JSON filter expression specifying the items to return",
            "schema": {
              "type": "string",
              "default": "{}"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort ordering for returned items (default -id)",
            "schema": {
              "type": "string",
              "default": "-id"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Zero based offset to start from",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": "0"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of items to return (1 – 1000)",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": "25"
            }
          },
          {
            "name": "calculate_count",
            "in": "query",
            "required": false,
            "description": "Whether to calculate the total item count",
            "schema": {
              "type": "boolean",
              "default": "false"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveSessionList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "ActiveSession"
        ],
        "security": []
      }
    },
    "/session/{id}": {
      "get": {
        "summary": "Get an active session",
        "description": "Get an active session",
        "operationId": "ActiveSessionByIdGet",
        "deprecated": false,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "URL parameter id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveSession"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
