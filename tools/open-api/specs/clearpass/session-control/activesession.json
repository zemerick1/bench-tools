  "components": {
    "schemas": {
      "ActiveSession": {
        "title": "ActiveSession",
        "type": "object",
        "properties": {
          "id": {
            "description": "Accounting identifier of the record",
            "type": "string"
          },
          "acctsessionid": {
            "description": "Policy Manager session identifier",
            "type": "string"
          },
          "username": {
            "description": "Username associated with the session",
            "type": "string"
          },
          "nasipaddress": {
            "description": "IP address of the network access device",
            "type": "string"
          },
          "framedipaddress": {
            "description": "IP address of the client",
            "type": "string"
          },
          "callingstationid": {
            "description": "Calling-Station-Id attribute; often the MAC address of the client",
            "type": "string"
          },
          "calledstationid": {
            "description": "MAC address of the network access device",
            "type": "string"
          },
          "nasportid": {
            "description": "Port identifier assigned by the network access device",
            "type": "string"
          },
          "nasporttype": {
            "description": "Port type reported by the network access device",
            "type": "string"
          },
          "nas_name": {
            "description": "Name of the network device",
            "type": "string"
          },
          "servicetype": {
            "description": "Service type",
            "type": "string"
          },
          "ssid": {
            "description": "SSID associated with the session",
            "type": "string"
          },
          "state": {
            "description": "The current state of the session (active, stale, closed).",
            "type": "string"
          },
          "ap_name": {
            "description": "Access point name associated with the session",
            "type": "string"
          },
          "acctstarttime": {
            "description": "Start time of the session",
            "format": "date-time",
            "type": "string"
          },
          "acctstoptime": {
            "description": "End time of the session",
            "format": "date-time",
            "type": "string"
          },
          "acctsessiontime": {
            "description": "Duration of the session, in seconds",
            "format": "int64",
            "type": "integer"
          },
          "acctterminatecause": {
            "description": "Reason for termination of this session",
            "type": "string"
          },
          "acctoutputoctets": {
            "description": "Number of octets sent to the client during the session",
            "format": "int64",
            "type": "integer"
          },
          "acctinputoctets": {
            "description": "Number of octets received from the client during the session",
            "format": "int64",
            "type": "integer"
          },
          "tipsrole": {
            "description": "Tips role of the session",
            "type": "string"
          },
          "arubauserrole": {
            "description": "Aruba user role of the session",
            "type": "string"
          },
          "arubauservlan": {
            "description": "Aruba user vlan of the session",
            "type": "string"
          },
          "total_traffic": {
            "description": "Total number of octets sent and received during the session",
            "format": "int64",
            "type": "integer"
          },
          "updated_at": {
            "description": "Time when the session record was last updated",
            "format": "date-time",
            "type": "string"
          },
          "cppm_uuid": {
            "description": "UUID of the CPPM server",
            "type": "string"
          },
          "mac_address": {
            "description": "MAC address of the client device",
            "type": "string"
          },
          "visitor_name": {
            "description": "The visitor’s name",
            "type": "string"
          },
          "visitor_company": {
            "description": "The visitor’s company name",
            "type": "string"
          },
          "visitor_carrier": {
            "description": "The visitor’s mobile carrier",
            "type": "string"
          },
          "visitor_phone": {
            "description": "The visitor’s phone number",
            "type": "string"
          },
          "sponsor_name": {
            "description": "Sponsor of the guest user associated with the session",
            "type": "string"
          },
          "sponsor_email": {
            "description": "Email address of the sponsor",
            "type": "string"
          },
          "sponsor_profile_name": {
            "description": "Operator profile name of the sponsor",
            "type": "string"
          },
          "role_name": {
            "description": "Role name of the user associated with the session",
            "type": "string"
          }
        }
      },
      "ActiveSessionItems": {
        "title": "ActiveSessionItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActiveSession"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ActiveSessionList": {
        "title": "ActiveSessionList",
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/ActiveSessionItems"
          },
          "_links": {
            "$ref": "#/components/schemas/HalLinks"
          },
          "count": {
            "description": "Total number of items matching the filter; returned if calculate_count is true",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "_embedded",
          "_links"
        ]
      },
      "HalLinks": {
        "title": "HalLinks",
        "type": "object",
        "properties": {
          "self": {
            "description": "URL of result",
            "type": "string"
          },
          "first": {
            "description": "URL of first page of results",
            "type": "string"
          },
          "last": {
            "description": "URL of last page of results",
            "type": "string"
          },
          "prev": {
            "description": "URL of previous page of results",
            "type": "string"
          },
          "next": {
            "description": "URL of next page of results",
            "type": "string"
          }
        },
        "required": [
          "self",
          "first"
        ]
      }
    }
  }
}
