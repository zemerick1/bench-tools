  "components": {
    "schemas": {
      "SessionAction": {
        "title": "SessionAction",
        "type": "object",
        "properties": {
          "session_id": {
            "description": "Policy Manager session identifier",
            "type": "string"
          },
          "success": {
            "description": "Is the session processed successfully",
            "type": "boolean"
          },
          "message": {
            "description": "SessionControl action message either success or failure",
            "type": "string"
          },
          "dyn_authz_action_name": {
            "description": "Name of SessionControl action that was used (enforcement profile name)",
            "type": "string"
          },
          "_links": {
            "description": "Contains a list of links.",
            "type": "object"
          }
        }
      },
      "SessionActionItems": {
        "title": "SessionActionItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionAction"
            }
          }
        }
      },
      "SessionActionList": {
        "title": "SessionActionList",
        "type": "object",
        "properties": {
          "action_id": {
            "description": "Unique ID to fetch synchronously or an asynchronously performed session action",
            "type": "string"
          },
          "status": {
            "description": "pending || running || complete || failed",
            "type": "string"
          },
          "count": {
            "description": "Total number of sessions matched by the filter",
            "format": "int64",
            "type": "integer"
          },
          "count_success": {
            "description": "Number of sessions that have been processed successfully",
            "format": "int64",
            "type": "integer"
          },
          "count_failed": {
            "description": "Number of sessions that have been processed with failure or not able to process",
            "format": "int64",
            "type": "integer"
          },
          "count_queue": {
            "description": "Number of sessions that have not yet been processed",
            "format": "int64",
            "type": "integer"
          },
          "_embedded": {
            "$ref": "#/components/schemas/SessionActionItems"
          }
        },
        "required": [
          "action_id",
          "status"
        ]
      },
