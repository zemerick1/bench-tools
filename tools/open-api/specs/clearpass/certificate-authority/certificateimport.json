{
  "openapi": "3.0.0",
  "info": {
    "title": "CertificateImport",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "tags": [
    {
      "name": "CertificateImport",
      "description": "Import a code-signing, trusted, or CA certificate"
    }
  ],
  "paths": {
    "/certificate/import": {
      "post": {
        "summary": "Import a code-signing, trusted, or CA certificate",
        "description": "Import a code-signing, trusted, or CA certificate",
        "operationId": "CertificateImportImportPost",
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateImport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Certificate"
                }
              }
            }
          },
          "400": {
            "description": "Client Error",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "CertificateImport"
        ],
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "CaId": {
        "title": "CaId",
        "description": "Numeric ID of the certificate authority",
        "example": 1,
        "type": "integer",
        "enum": [
          1
        ]
      },
      "Certificate": {
        "title": "Certificate",
        "type": "object",
        "properties": {
          "id": {
            "description": "Numeric ID of the certificate",
            "format": "int64",
            "type": "integer"
          },
          "action_notification_sent_at": {
            "description": "Time of the last check for expiration actions",
            "format": "date-time",
            "type": "string"
          },
          "ca_id": {
            "description": "Numeric ID of the Onboard certificate authority; null if not an Onboard-issued certificate",
            "format": "int64",
            "type": "integer"
          },
          "ca_name": {
            "description": "Name of the Onboard certificate authority; null if not an Onboard-issued certificate",
            "type": "string"
          },
          "certificate_pem": {
            "description": "Text representation of the X509 certificate",
            "type": "string"
          },
          "certificate_sub_type": {
            "$ref": "#/components/schemas/CertificateSubType"
          },
          "certificate_type": {
            "$ref": "#/components/schemas/CertificateType"
          },
          "certificate_version": {
            "description": "Version number of the X509 certificate",
            "format": "int64",
            "type": "integer"
          },
          "csr_rejected_at": {
            "description": "Time at which the certificate signing request was rejected; may be null",
            "format": "date-time",
            "type": "string"
          },
          "fingerprint_sha1": {
            "description": "SHA-1 fingerprint of the certificate",
            "type": "string"
          },
          "fingerprint_sha256": {
            "description": "SHA-256 fingerprint of the certificate",
            "type": "string"
          },
          "has_certificate": {
            "description": "True if certificate is present, or false for certificate signing requests",
            "type": "boolean"
          },
          "has_key": {
            "description": "True if server holds the private key for the certificate",
            "type": "boolean"
          },
          "is_valid": {
            "description": "True if the certificate has not expired and has not been revoked",
            "type": "boolean"
          },
          "issuer": {
            "description": "Path representation of certificate issuer’s distinguished name; components separated with forward slash (/)",
            "type": "string"
          },
          "issuer_common_name": {
            "description": "Common name of the certificate issuer",
            "type": "string"
          },
          "issuer_country": {
            "description": "Country (C) of the certificate issuer",
            "type": "string"
          },
          "issuer_dn": {
            "$ref": "#/components/schemas/DistinguishedName"
          },
          "issuer_email_address": {
            "description": "Email address of the certificate issuer",
            "type": "string"
          },
          "issuer_locality": {
            "description": "Locality (L) of the certificate issuer",
            "type": "string"
          },
          "issuer_organization": {
            "description": "Organization (O) of the certificate issuer",
            "type": "string"
          },
          "issuer_organizational_unit": {
            "description": "Organizational unit (OU) of the certificate issuer",
            "type": "string"
          },
          "issuer_state": {
            "description": "State or province name (ST) of the certificate issuer",
            "type": "string"
          },
          "key_type": {
            "$ref": "#/components/schemas/KeyType"
          },
          "key_usage": {
            "description": "List of asserted key usage bits",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key_usage_extended": {
            "description": "List of object identifiers for extended key usage",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mdps_custom_field": {
            "description": "Custom field from certificate subject alternative name",
            "type": "string"
          },
          "mdps_device_iccid": {
            "description": "Device ICCID from certificate subject alternative name",
            "type": "string"
          },
          "mdps_device_imei": {
            "description": "Device IMEI from certificate subject alternative name",
            "type": "string"
          },
          "mdps_device_name": {
            "description": "Device name from certificate subject alternative name",
            "type": "string"
          },
          "mdps_device_serial": {
            "description": "Device serial from certificate subject alternative name",
            "type": "string"
          },
          "mdps_device_type": {
            "description": "Device type from certificate subject alternative name",
            "type": "string"
          },
          "mdps_device_udid": {
            "description": "Device UDID from certificate subject alternative name",
            "type": "string"
          },
          "mdps_email_address": {
            "description": "User email address from certificate subject alternative name",
            "type": "string"
          },
          "mdps_mac_address": {
            "description": "List of MAC addresses from certificate subject alternative name",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mdps_product_name": {
            "description": "Product name from certificate subject alternative name",
            "type": "string"
          },
          "mdps_product_version": {
            "description": "Product version from certificate subject alternative name",
            "type": "string"
          },
          "mdps_user_name": {
            "description": "Username from certificate subject alternative name",
            "type": "string"
          },
          "revoked_at": {
            "description": "Time at which the certificate was revoked; may be null",
            "format": "date-time",
            "type": "string"
          },
          "self_signed": {
            "description": "True if the certificate is a self-signed CA certificate",
            "type": "boolean"
          },
          "serial_number": {
            "description": "Serial number of the certificate",
            "type": "string"
          },
          "signature_algorithm": {
            "description": "Algorithm used to digitally sign the certificate",
            "type": "string"
          },
          "subject": {
            "description": "Path representation of certificate subject’s distinguished name; components separated with forward slash (/)",
            "type": "string"
          },
          "subject_alt_name_dn": {
            "description": "String or object containing certificate’s alternative name properties; may be null",
            "type": "string"
          },
          "subject_common_name": {
            "description": "Common name (CN) from certificate subject",
            "type": "string"
          },
          "subject_country": {
            "description": "Country (C) from certificate subject",
            "type": "string"
          },
          "subject_dn": {
            "$ref": "#/components/schemas/DistinguishedName"
          },
          "subject_email_address": {
            "description": "Email address from certificate subject",
            "type": "string"
          },
          "subject_keyid": {
            "description": "Unique identifier of the certificate’s public key",
            "type": "string"
          },
          "subject_locality": {
            "description": "Locality (L) from certificate subject",
            "type": "string"
          },
          "subject_organization": {
            "description": "Organization (O) from certificate subject",
            "type": "string"
          },
          "subject_organizational_unit": {
            "description": "Organizational unit (OU) from certificate subject",
            "type": "string"
          },
          "subject_state": {
            "description": "State or province name (ST) from certificate subject",
            "type": "string"
          },
          "valid_from": {
            "description": "Time at which the certificate will become valid",
            "format": "date-time",
            "type": "string"
          },
          "valid_to": {
            "description": "Time at which the certificate will expire",
            "format": "date-time",
            "type": "string"
          }
        }
      },
      "CertificateFileEncoding": {
        "title": "CertificateFileEncoding",
        "description": "Encoding used for 'certificate_file' parameter",
        "example": "base64",
        "type": "string",
        "enum": [
          "base64",
          "text"
        ]
      },
      "CertificateImport": {
        "title": "CertificateImport",
        "type": "object",
        "properties": {
          "ca_id": {
            "$ref": "#/components/schemas/CaId"
          },
          "type": {
            "$ref": "#/components/schemas/Type"
          },
          "certificate_file": {
            "description": "Contents of certificate to import",
            "type": "string"
          },
          "certificate_file_encoding": {
            "$ref": "#/components/schemas/CertificateFileEncoding"
          },
          "key_file": {
            "description": "Contents of private key to import",
            "type": "string"
          },
          "key_file_encoding": {
            "$ref": "#/components/schemas/KeyFileEncoding"
          },
          "key_passphrase": {
            "description": "Enter the passphrase that was used to encrypt the private key. If the private key is not encrypted, leave this field blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "certificate_file",
          "certificate_file_encoding"
        ]
      },
      "CertificateSubType": {
        "title": "CertificateSubType",
        "description": "Subclassification of the type of certificate; may be null",
        "example": "profile-signing",
        "type": "string",
        "enum": [
          "profile-signing"
        ]
      },
      "CertificateType": {
        "title": "CertificateType",
        "description": "Type of this certificate",
        "example": "ca",
        "type": "string",
        "enum": [
          "ca",
          "scep-client",
          "tls-client",
          "trusted",
          "code-signing",
          "scep-server",
          "https"
        ]
      },
      "DistinguishedName": {
        "title": "DistinguishedName",
        "type": "object",
        "properties": {
          "C": {
            "description": "ISO 3166 country code",
            "type": "string"
          },
          "ST": {
            "description": "State or province name",
            "type": "string"
          },
          "L": {
            "description": "Locality name, e.g. city",
            "type": "string"
          },
          "O": {
            "description": "Organization name",
            "type": "string"
          },
          "OU": {
            "description": "Organizational unit name",
            "type": "string"
          },
          "CN": {
            "description": "Common name",
            "type": "string"
          },
          "emailAddress": {
            "description": "Email address",
            "type": "string"
          }
        }
      },
      "KeyFileEncoding": {
        "title": "KeyFileEncoding",
        "description": "Encoding used for 'key_file' parameter",
        "example": "base64",
        "type": "string",
        "enum": [
          "base64",
          "text"
        ]
      },
      "KeyType": {
        "title": "KeyType",
        "description": "Type of private key; may be null",
        "example": "rsa_1024",
        "type": "string",
        "enum": [
          "rsa_1024",
          "rsa_2048",
          "rsa_4096",
          "ec_prime256v1",
          "ec_secp384r1"
        ]
      },
      "Type": {
        "title": "Type",
        "description": "Type of certificate to import",
        "example": "trusted",
        "type": "string",
        "enum": [
          "trusted",
          "ca",
          "code-signing"
        ]
      }
    }
  }
}
