          }
        }
      },
      "OnboardUserItems": {
        "title": "OnboardUserItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OnboardUser"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "OnboardUserList": {
        "title": "OnboardUserList",
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/OnboardUserItems"
          },
          "_links": {
            "$ref": "#/components/schemas/HalLinks"
          },
          "count": {
            "description": "Total number of items matching the filter; returned if calculate_count is true",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "_embedded",
          "_links"
        ]
      },
      "Status": {
        "title": "Status",
        "description": "Determines whether the user can enroll devices",
        "example": "allowed",
        "type": "string",
        "enum": [
          "allowed",
          "denied"
        ]
      }
