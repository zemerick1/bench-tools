{
  "openapi": "3.0.0",
  "info": {
    "title": "CertificateExport",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "tags": [
    {
      "name": "CertificateExport",
      "description": "Export a certificate or certificate signing request"
    }
  ],
  "paths": {
    "/certificate/{cert_id}/export": {
      "post": {
        "summary": "Export a certificate or certificate signing request",
        "description": "Export a certificate or certificate signing request",
        "operationId": "CertificateExportByCert_idExportPost",
        "deprecated": false,
        "parameters": [
          {
            "name": "cert_id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the certificate",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateExport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/x-x509-ca-cert": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateExportResponse"
                }
              },
              "application/x-pkcs7-certificates": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateExportResponse"
                }
              },
              "application/pkcs10": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateExportResponse"
                }
              },
              "application/x-pkcs12": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateExportResponse"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateExportResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/x-x509-ca-cert": {
                "schema": {}
              },
              "application/x-pkcs7-certificates": {
                "schema": {}
              },
              "application/pkcs10": {
                "schema": {}
              },
              "application/x-pkcs12": {
                "schema": {}
              },
              "text/plain": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/x-x509-ca-cert": {
                "schema": {}
              },
              "application/x-pkcs7-certificates": {
                "schema": {}
              },
              "application/pkcs10": {
                "schema": {}
              },
              "application/x-pkcs12": {
                "schema": {}
              },
              "text/plain": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/x-x509-ca-cert": {
                "schema": {}
              },
              "application/x-pkcs7-certificates": {
                "schema": {}
              },
              "application/pkcs10": {
                "schema": {}
              },
              "application/x-pkcs12": {
                "schema": {}
              },
              "text/plain": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/x-x509-ca-cert": {
                "schema": {}
              },
              "application/x-pkcs7-certificates": {
                "schema": {}
              },
              "application/pkcs10": {
                "schema": {}
              },
              "application/x-pkcs12": {
                "schema": {}
              },
              "text/plain": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/x-x509-ca-cert": {
                "schema": {}
              },
              "application/x-pkcs7-certificates": {
                "schema": {}
              },
              "application/pkcs10": {
                "schema": {}
              },
              "application/x-pkcs12": {
                "schema": {}
              },
              "text/plain": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/x-x509-ca-cert": {
                "schema": {}
              },
              "application/x-pkcs7-certificates": {
                "schema": {}
              },
              "application/pkcs10": {
                "schema": {}
              },
              "application/x-pkcs12": {
                "schema": {}
              },
              "text/plain": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "CertificateExport"
        ],
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "CertificateExport": {
        "title": "CertificateExport",
        "type": "object",
        "properties": {
          "export_format": {
            "$ref": "#/components/schemas/ExportFormat"
          },
          "include_chain": {
            "description": "Select this option to include the certificates for the CA and any intermediate certificate authorities",
            "type": "boolean"
          },
          "include_ca": {
            "$ref": "#/components/schemas/IncludeCa"
          },
          "export_password": {
            "description": "Passphrase to protect the PKCS#12 file",
            "type": "string"
          },
          "export_password2": {
            "description": "Re-enter the passphrase",
            "type": "string"
          }
        },
        "required": [
          "export_format"
        ]
      },
      "CertificateExportResponse": {
        "title": "CertificateExportResponse",
        "type": "object",
        "properties": {
          "HTTP:Content-Disposition": {
            "description": "attachment; The response is file data and does not contain JSON",
            "default": "attachment",
            "type": "string"
          }
        }
      },
      "ExportFormat": {
        "title": "ExportFormat",
        "description": "Select the file format for the exported item",
        "example": "p7b",
        "type": "string",
        "enum": [
          "p7b",
          "pem",
          "crt",
          "txt",
          "p12"
        ]
      },
      "IncludeCa": {
        "title": "IncludeCa",
        "description": "Select which certificate authorities to include.",
        "example": "all",
        "type": "string",
        "enum": [
          "all",
          "intermediate"
        ]
      }
    }
  }
}
