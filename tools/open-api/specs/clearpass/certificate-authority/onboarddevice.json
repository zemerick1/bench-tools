  "components": {
    "schemas": {
      "DeviceType": {
        "title": "DeviceType",
        "description": "Device type",
        "example": "Other",
        "type": "string",
        "enum": [
          "Other",
          "Android",
          "iOS",
          "OS X",
          "Windows",
          "Ubuntu",
          "Chromebook",
          "Web",
          "External"
        ]
      },
      "HalLinks": {
        "title": "HalLinks",
        "type": "object",
        "properties": {
          "self": {
            "description": "URL of result",
            "type": "string"
          },
          "first": {
            "description": "URL of first page of results",
            "type": "string"
          },
          "last": {
            "description": "URL of last page of results",
            "type": "string"
          },
          "prev": {
            "description": "URL of previous page of results",
            "type": "string"
          },
          "next": {
            "description": "URL of next page of results",
            "type": "string"
          }
        },
        "required": [
          "self",
          "first"
        ]
      },
      "OnboardDevice": {
        "title": "OnboardDevice",
        "type": "object",
        "properties": {
          "id": {
            "description": "Numeric ID of the device",
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "device_type": {
            "$ref": "#/components/schemas/DeviceType"
          },
          "device_name": {
            "description": "Device name",
            "type": "string"
          },
          "device_udid": {
            "description": "Unique device identifier",
            "type": "string"
          },
          "device_imei": {
            "description": "International Mobile Station Equipment Identity, if available",
            "type": "string"
          },
          "device_iccid": {
            "description": "SIM card unique serial number, if available",
            "type": "string"
          },
          "device_serial": {
            "description": "Serial number of the device, if available",
            "type": "string"
          },
          "product_name": {
            "description": "Product name of the device, if available",
            "type": "string"
          },
          "product_version": {
            "description": "Product version string of the device, if available",
            "type": "string"
          },
          "mac_address": {
            "description": "List of MAC addresses associated with the device",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "serial_number": {
            "description": "Serial number of device certificate, if device type is \"External\"",
            "type": "string"
          },
          "usernames": {
            "description": "Usernames that have enrolled this device",
            "type": "string"
          },
          "enrolled": {
            "description": "Flag indicating device has been provisioned and currently has a valid certificate",
            "type": "boolean"
          },
          "expanded_type": {
            "description": "Marketing name for the product",
            "type": "string"
          },
          "mdm_managed": {
            "description": "Mobile device management (MDM) vendor name, if an endpoint context server reports the device as managed",
            "type": "string"
          },
          "device_identifier": {
            "description": "Unique identifier string ",
            "type": "string"
          }
        }
      },
      "OnboardDeviceItems": {
        "title": "OnboardDeviceItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OnboardDevice"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "OnboardDeviceList": {
        "title": "OnboardDeviceList",
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/OnboardDeviceItems"
          },
          "_links": {
            "$ref": "#/components/schemas/HalLinks"
          },
          "count": {
            "description": "Total number of items matching the filter; returned if calculate_count is true",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "_embedded",
          "_links"
        ]
      },
      "Status": {
        "title": "Status",
        "description": "Determines whether the user can enroll devices",
        "example": "allowed",
        "type": "string",
        "enum": [
          "allowed",
          "denied"
        ]
      }
    }
