      "delete": {
        "summary": "Delete a device",
        "description": "Delete a device.\n<table>\n  <thead>\n    <tr>\n      <th>Details about this operation</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Certificates issued to the device by Onboard will be revoked.</td>\n    </tr>\n    <tr>\n      <td>The device will be disconnected from the network, if <span class=\"code\">disconnect_active_sessions</span> is true.</td>\n    </tr>\n    <tr>\n      <td>If this device has been provisioned with certificates signed by an external source, you must revoke these certificates manually.\nOtherwise the device will still be able to access the network until these certificates expire.</td>\n    </tr>\n    <tr>\n      <td>If this device has <strong>not</strong> been provisioned with certificates signed by an external source, the device will be blocked from accessing the network.</td>\n    </tr>\n    <tr>\n      <td>The device will be allowed to enroll with Onboard again.</td>\n    </tr>\n  </tbody>\n</table>\n",
        "operationId": "OnboardDeviceDeviceByIdDelete",
        "deprecated": false,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the device",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "disconnect_active_sessions",
            "in": "query",
            "required": false,
            "description": "<b>true:</b> Disconnects the device from the network (default)<br/><b>false:</b> No action is taken",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ignore_disconnect_errors",
            "in": "query",
            "required": false,
            "description": "\n<b>true:</b> Optional Disconnect — failure to disconnect will be ignored and the device will be forcibly deleted<br/>\n<b>false:</b> Require Disconnect (Recommended) — failure to disconnect will stop the device from being deleted (default)<br/>\nWhen false (‘Require Disconnect’), the device will only be deleted if all other sessions can be disconnected,\nwhich ensures that the device does not retain access to the network through a currently active session.\nYou should only select true (‘Optional Disconnect’) if necessary.<br/>\nThis parameter is ignored if <span class=\"code\">disconnect_active_sessions</span> is false.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": {
                "schema": {}
