{
  "openapi": "3.0.0",
  "info": {
    "title": "TokenEndpoint",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "tags": [
    {
      "name": "TokenEndpoint",
      "description": "Obtain an OAuth2 access token for making API calls"
    }
  ],
  "paths": {
    "/oauth": {
      "post": {
        "summary": "Obtain an OAuth2 access token for making API calls",
        "description": "Obtain an OAuth2 access token for making API calls",
        "operationId": "TokenEndpointPost",
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenEndpoint"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2Response"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "TokenEndpoint"
        ],
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "GrantType": {
        "title": "GrantType",
        "description": "OAuth2 authentication method",
        "example": "client_credentials",
        "type": "string",
        "enum": [
          "client_credentials",
          "password",
          "refresh_token"
        ]
      },
      "OAuth2Response": {
        "title": "OAuth2Response",
        "type": "object",
        "properties": {
          "access_token": {
            "description": "Access token issued by the authorization server",
            "type": "string"
          },
          "token_type": {
            "description": "Type of access token. Always set to \"Bearer\"",
            "type": "string"
          },
          "expires_in": {
            "description": "The lifetime in seconds of the access token",
            "type": "integer"
          },
          "refresh_token": {
            "description": "Refresh token, if enabled for this API client. Can be used to obtain a new access token",
            "type": "string"
          },
          "scope": {
            "description": "Scope of the access token",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ]
      },
      "TokenEndpoint": {
        "title": "TokenEndpoint",
        "type": "object",
        "properties": {
          "grant_type": {
            "$ref": "#/components/schemas/GrantType"
          },
          "client_id": {
            "description": "Client ID defined in API Clients",
            "type": "string"
          },
          "client_secret": {
            "description": "Client secret, required if the API client is not a public client",
            "type": "string"
          },
          "username": {
            "description": "Username for authentication, required for grant_type \"password\"",
            "type": "string"
          },
          "password": {
            "description": "Password for authentication, required for grant_type \"password\"",
            "type": "string"
          },
          "scope": {
            "description": "Scope of the access request",
            "type": "string"
          },
          "refresh_token": {
            "description": "Refresh token issued to the client, required for grant_type \"refresh_token\"",
            "type": "string"
          }
        },
        "required": [
          "grant_type",
          "client_id"
        ]
      }
    }
  }
}
