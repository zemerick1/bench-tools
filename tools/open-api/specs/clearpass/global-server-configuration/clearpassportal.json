  "components": {
    "schemas": {
      "AppName": {
        "title": "AppName",
        "description": "If specified, User will be redirected to the selected ClearPass application login page",
        "example": "ClearPass Guest",
        "type": "string",
        "enum": [
          "ClearPass Guest",
          "ClearPass Insight",
          "ClearPass Policy Manager",
          "ClearPass Onboard"
        ]
      },
      "ClearPassPortal": {
        "title": "ClearPassPortal",
        "type": "object",
        "properties": {
          "title": {
            "description": "Default Landing page Title",
            "type": "string"
          },
          "header": {
            "description": "Default Landing page Header",
            "type": "string"
          },
          "footer": {
            "description": "Default Landing page Footer",
            "type": "string"
          },
          "copyright": {
            "description": "Default Landing page Copyright text",
            "type": "string"
          },
          "app_name": {
            "$ref": "#/components/schemas/AppName"
          },
          "guest_portal": {
            "description": "If specified, User will be redirected to the selected Guest Web Login/Self-Registration Portal",
            "type": "string"
          },
          "url": {
            "description": "Redirect URL constructed based on the Guest Portal name(guest_portal) or Application Login Page(app_name)",
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ClearPass REST API. Authorization: Bearer <access_token>"
      }
    }
  }
