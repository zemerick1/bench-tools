          }
        },
        "required": [
          "license_key"
        ]
      },
      "ApplicationLicenseResult": {
        "title": "ApplicationLicenseResult",
        "type": "object",
        "properties": {
          "id": {
            "description": "Numeric ID of License",
            "format": "int64",
            "type": "integer"
          },
          "product_id": {
            "description": "Product ID",
            "format": "int64",
            "type": "integer"
          },
          "product_name": {
            "$ref": "#/components/schemas/ProductName"
          },
          "license_key": {
            "description": "License key",
            "type": "string"
          },
          "license_type": {
            "$ref": "#/components/schemas/LicenseType"
          },
          "user_count": {
            "description": "Number of Endpoints for the license",
            "format": "int64",
            "type": "integer"
          },
          "duration": {
            "description": "Subscription duration of the license(in years)",
            "format": "int64",
            "type": "integer"
          },
          "duration_units": {
            "description": "Subscription duration unit",
            "type": "string"
          },
          "license_added_on": {
            "description": "Date of the license added",
            "type": "string"
          },
          "activation_status": {
            "description": "Activation status of the license",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "product_id",
          "product_name",
          "license_key",
          "license_type",
          "user_count",
          "duration",
          "duration_units",
          "license_added_on",
          "activation_status"
        ]
      },
      "ApplicationLicenseSummaryResult": {
        "title": "ApplicationLicenseSummaryResult",
        "type": "object",
        "properties": {
          "license_type": {
            "$ref": "#/components/schemas/LicenseType"
          },
          "licensed_count": {
            "description": "Total count",
            "format": "int64",
            "type": "integer"
          },
          "used_count": {
            "description": "Used count",
            "format": "int64",
            "type": "integer"
          },
          "updated_at": {
            "description": "Last updated at",
            "type": "string"
          }
        },
        "required": [
          "license_type",
          "licensed_count",
          "used_count",
          "updated_at"
        ]
      },
      "LicenseType": {
        "title": "LicenseType",
        "description": "License type",
        "example": "Permanent",
        "type": "string",
        "enum": [
          "Permanent",
          "Evaluation"
        ]
      },
      "ProductName": {
        "title": "ProductName",
        "description": "Product name",
        "example": "Access",
        "type": "string",
        "enum": [
          "Access",
          "OnGuard",
          "Onboard",
          "Entry",
          "Access Upgrade"
        ]
      }
