          "MD5",
          "SHA"
        ]
      },
      "CLISettings": {
        "title": "CLISettings",
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/Type"
          },
          "port": {
            "description": "SSH/Telnet port number of the network device",
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "description": "Username of the network device",
            "type": "string"
          },
          "password": {
