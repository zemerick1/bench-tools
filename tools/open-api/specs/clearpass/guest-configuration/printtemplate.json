            "type": "string"
          }
        },
        "required": [
          "self",
          "first"
        ]
      },
      "PrintTemplate": {
        "title": "PrintTemplate",
        "type": "object",
        "properties": {
          "id": {
            "description": "Numeric ID of the template",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "description": "Name of the template",
            "type": "string"
          },
          "enabled": {
            "description": "Flag indicating if the template is enabled",
            "type": "boolean"
          },
          "columns": {
            "description": "Columns in a template.",
            "format": "int64",
            "type": "integer"
          },
          "per_account": {
            "description": "HTML template code used to generate a single account receipt",
            "type": "string"
          },
          "header": {
            "description": "HTML template code used at the beginning of the document",
            "type": "string"
          },
          "footer": {
            "description": "HTML template code used at the end of the document",
            "type": "string"
          },
          "wizard_template": {
            "description": "Style of print template to use",
            "type": "string"
          },
          "wizard_logo": {
            "description": "Image to use on the template",
            "type": "string"
          },
          "wizard_title": {
            "description": "Title which will be displayed on the template",
            "type": "string"
          },
          "wizard_subtitle": {
            "description": "Subtitle to display on the template",
            "type": "string"
          },
          "wizard_field_header": {
            "description": "Field header for the details displayed on the template",
            "type": "string"
          },
          "wizard_fields": {
            "description": "Visitor account fields",
            "type": "string"
          },
          "wizard_notes": {
            "description": "Notes to display on the template",
            "type": "string"
          },
          "wizard_footer": {
            "description": "Footer text to display on the template",
            "type": "string"
          }
        }
      },
      "PrintTemplateItems": {
        "title": "PrintTemplateItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrintTemplate"
            }
          }
        },
        "required": [
          "items"
