          "trapeze_3576",
          "trendnet",
          "xirrus"
        ]
      },
      "GRadiusInternalAuthType": {
        "title": "GRadiusInternalAuthType",
        "description": "Controls the RADIUS authentication type used for internal RADIUS authentication requests",
        "example": "pap",
        "type": "string",
        "enum": [
          "pap",
          "chap",
          "mschap"
        ]
      },
      "GuestAuthenticationConfiguration": {
        "title": "GuestAuthenticationConfiguration",
        "type": "object",
        "properties": {
          "g_admin_access_guest_require_https": {
            "description": "If checked, HTTP access by guests will be redirected to use HTTPS instead",
            "type": "boolean"
          },
          "change_of_authorization": {
            "description": "Global to automatically send disconnects when enabled/role values change.\nRequires a NAS Type supporting RFC-3576",
            "type": "boolean"
          },
          "g_radius_default_vendor": {
            "$ref": "#/components/schemas/GRadiusDefaultVendor"
          },
          "g_radius_server_bind_3576": {
            "description": "Force a specific bind address for RFC-3576 requests.  This may be needed in an AirGroup environment.\nDefaults to '0.0.0.0' or '::' depending on your network",
            "type": "string"
          },
          "g_radius_internal_auth_type": {
            "$ref": "#/components/schemas/GRadiusInternalAuthType"
          }
        },
        "required": [
          "g_radius_internal_auth_type"
        ]
      }
