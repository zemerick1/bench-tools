      "GRadiusDefaultVendor": {
        "title": "GRadiusDefaultVendor",
        "description": "Select the default type for network access servers",
        "example": "other",
        "type": "string",
        "enum": [
          "other",
          "rfc3576",
          "coa_3576",
          "appauth_3576",
          "appauthz_3576",
