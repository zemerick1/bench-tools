      "WebLogin": {
        "title": "WebLogin",
        "type": "object",
        "properties": {
          "id": {
            "description": "Unique ID of the web login",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "description": "Enter a name for this web login page",
            "type": "string"
          },
          "page_name": {
            "description": "Enter a page name for this web login.\nThe web login will be accessible from “/guest/page_name.php”",
            "type": "string"
          },
          "description": {
            "description": "Comments or descriptive text about the web login",
            "type": "string"
          },
          "vendor_preset": {
            "description": "Select a predefined group of settings suitable for standard network configurations",
            "type": "string"
          },
          "vendor_ip": {
            "description": "Enter the hostname (FQDN) of the vendor’s product here.\nWhen using Secure Login over HTTPS, this name should match the name of the HTTPS certificate installed on your device",
            "type": "string"
          },
          "require_https": {
            "description": "Select a security option to apply to the web login process",
            "type": "string"
          },
          "webauth": {
            "description": "Select how the user’s network login will be handled.\nServer-initiated logins require the user’s MAC address to be available, usually from the captive portal redirection process",
            "type": "string"
          },
          "form_action": {
            "description": "The URL of the NAS device’s login form",
            "type": "string"
          },
          "form_method": {
            "description": "Choose the method to use when submitting the login form to the NAS",
            "type": "string"
          },
          "form_username_label": {
            "description": "The form label for the username field.  \nLeave blank to use the default (Username:)",
            "type": "string"
          },
          "form_username": {
            "description": "The name of the username field for the login form. This will be passed to the NAS device when the form is submitted",
            "type": "string"
          },
          "form_username_suffix": {
            "description": "The suffix is automatically appended to the username before submitting the login form to the NAS",
            "type": "string"
          },
          "form_password_label": {
            "description": "The form label for the password field.  \nLeave blank to use the default (Password:)",
            "type": "string"
          },
          "form_password": {
            "description": "The name of the password field for the login form. This will be passed to the NAS device when the form is submitted",
            "type": "string"
          },
          "form_extra": {
            "description": "Specify any additional field names and values to send to the NAS device as name=value pairs, one per line",
            "type": "string"
          },
          "submit_label": {
            "description": "The form label for the log in button.  \nLeave blank to use the default (Log In)",
            "type": "string"
          },
          "form_password_encryption": {
            "description": "Choose the type of password encryption to use when submitting the login form",
            "type": "string"
          },
          "uam_secret": {
            "description": "Enter the shared secret between the NAS device and the web login form",
            "type": "string"
          },
          "url": {
            "description": "The name of the destination field required by the NAS",
            "type": "string"
          },
          "default_url": {
            "description": "Enter the default URL to redirect clients.\nPlease ensure you prepend \"http://\" for any external domain",
            "type": "string"
          },
          "default_url_override": {
            "description": "If selected, the client’s default destination will be overridden regardless of its value",
            "type": "boolean"
          },
          "dynamic_address": {
            "description": "In multi-controller deployments, it is often required to post credentials to different addresses made available as part of the original redirection.\nThe address above will be used whenever the parameter is not available or fails the requirements below",
            "type": "boolean"
          },
          "dynamic_allowlist": {
            "description": "Enter the IP addresses and networks from which dynamic addresses are permitted",
            "type": "string"
          },
          "dynamic_denylist": {
            "description": "Enter the IP addresses and networks from which dynamic addresses are denied",
            "type": "string"
          },
          "access_allowlist": {
            "description": "Enter the IP addresses and networks from which logins are permitted",
            "type": "string"
          },
          "access_denylist": {
            "description": "Enter the IP addresses and networks that are denied login access",
            "type": "string"
          },
          "access_if_denied": {
            "description": "Select the response of the system to a request that is not permitted",
            "type": "string"
          },
          "login_title": {
            "description": "The title to display on the web login page.  \nLeave blank to use the default (Login)",
            "type": "string"
          },
          "login_header": {
            "description": "HTML template code displayed before the login form",
