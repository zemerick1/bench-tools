{
  "openapi": "3.0.0",
  "info": {
    "title": "ExtensionInstanceLog",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "tags": [
    {
      "name": "ExtensionInstanceLog",
      "description": "Read logs from an installed extension"
    }
  ],
  "paths": {
    "/extension/instance/{id}/log": {
      "get": {
        "summary": "Get the log output from an installed extension",
        "description": "Get the log output from an installed extension. <p><img src=\"images/icon-warn22.png\" width=\"22\" height=\"22\" border=\"0\" alt=\"Warning\" title=\"Warning\"> Using <tt>tail=all</tt> may cause browser issues if the extension has a large amount of logs.</p>",
        "operationId": "ExtensionInstanceLogInstanceByIdLogGet",
        "deprecated": false,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the extension instance",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stdout",
            "in": "query",
            "required": false,
            "description": "Include extension’s standard-output messages",
            "schema": {
              "type": "boolean",
              "default": "true"
            }
          },
          {
            "name": "stderr",
            "in": "query",
            "required": false,
            "description": "Include extension’s standard-error messages",
            "schema": {
              "type": "boolean",
              "default": "true"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Specify a UNIX timestamp to only return log entries since that time",
            "schema": {
              "type": "integer",
              "default": "0"
            }
          },
          {
            "name": "timestamps",
            "in": "query",
            "required": false,
            "description": "Prefix every log line with its UTC timestamp",
            "schema": {
              "type": "boolean",
              "default": "false"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "description": "Return this number of lines at the end of the logs, or \"all\" for everything",
            "schema": {
              "type": "string",
              "default": "100"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionInstanceLog"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "ExtensionInstanceLog"
        ],
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ExtensionInstanceLog": {
        "title": "ExtensionInstanceLog",
        "type": "object",
        "properties": {
          "log": {
            "description": "Log messages generated by the extension instance",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
