{
  "openapi": "3.0.0",
  "info": {
    "title": "ExtensionInstanceReinstall",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "ExtensionInstanceReinstall",
      "description": "Reinstall an extension"
    }
  ],
  "paths": {
    "/extension/instance/{id}/reinstall": {
      "post": {
        "summary": "Reinstall an extension",
        "description": "\tReinstalls an extension instance.\n<p>\n\tThe reinstall process will recreate the extension using the same settings it currently has.\n</p>\n<p>\n\tThis operation will download the latest updates for this version of the extension from the extension store.\n</p>\n<p>\n\tThe body parameters <tt>state</tt>, <tt>files</tt> and/or <tt>ip_address</tt>, if non-null,\n\tcan be used to change the current settings of the extension. If these parameters are not supplied\n\tor set to null the existing settings will be used.\n</p>\n<p>\n\tThe query parameter <tt>sync=true</tt> may be provided to make this a synchronous operation.\n\tIn this case, the operation produces JSON status updates during the operation using HTTP chunked transfer encoding.\n</p>\n<p>\n\tThe default is asynchronous operation.  To check on the progress of the operation, use <tt>GET /extension/instance/{id}</tt>.\n\tThe <tt>install_time</tt> property will be updated when the extension is reinstalled.\n</p>",
        "operationId": "ExtensionInstanceReinstallInstanceByIdReinstallPost",
        "deprecated": false,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the extension instance",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtensionInstanceReinstall"
              }
            }
          },
          "description": "Extension reinstall options",
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionInstance"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "ExtensionInstanceReinstall"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ExtensionInstance": {
        "title": "ExtensionInstance",
        "type": "object",
        "properties": {
          "id": {
            "description": "ID of the extension instance",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "state_details": {
            "description": "Additional information about the current state of the extension",
            "type": "string"
          },
          "store_id": {
            "description": "ID of the extension in the store",
            "type": "string"
          },
          "name": {
            "description": "Name of the extension",
            "type": "string"
          },
          "version": {
            "description": "Version number of the extension",
            "type": "string"
          },
          "description": {
            "description": "Description of the extension",
            "type": "string"
          },
          "icon_href": {
            "description": "URL for the extension’s icon",
            "type": "string"
          },
          "about_href": {
            "description": "URL for the extension’s documentation",
            "type": "string"
          },
          "hostname": {
            "description": "Hostname assigned to the extension",
            "type": "string"
          },
          "network_ports": {
            "description": "List of network ports provided by the extension",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionInstanceNetworkPort"
            }
          },
          "extension_hrefs": {
            "description": "List of URLs provided by the extension",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionInstanceHref"
            }
          },
          "files": {
            "description": "Map of extension file IDs to local content items, with ‘public:’ or ‘private:’ prefix",
            "type": "object"
          },
          "file_descriptions": {
            "description": "Contains a description of each extension file ID",
            "type": "object"
          },
          "internal_ip_address": {
            "description": "Internal IP address of the extension",
            "type": "string"
          },
          "needs_reinstall": {
            "description": "Indicates that the extension is out-of-date and should be reinstalled",
            "type": "boolean"
          },
          "reinstall_details": {
            "description": "State details for any background reinstall operation that is in progress",
            "type": "string"
          },
          "has_config": {
            "description": "Indicates that the extension has configuration settings",
            "type": "boolean"
          },
          "install_time": {
            "description": "Time at which the extension was installed",
            "type": "string"
          }
        }
      },
      "ExtensionInstanceHref": {
        "title": "ExtensionInstanceHref",
        "type": "object",
        "properties": {
          "description": {
            "description": "Description of the URL",
            "type": "string"
          },
          "href": {
            "description": "Server-relative URL path",
            "type": "string"
          }
        },
        "required": [
          "href"
        ]
      },
      "ExtensionInstanceNetworkPort": {
        "title": "ExtensionInstanceNetworkPort",
        "type": "object",
        "properties": {
          "description": {
            "description": "Description of the service provided on this port",
            "type": "string"
          },
          "protocol": {
            "$ref": "#/components/schemas/Protocol"
          },
          "host_port": {
            "description": "Port number for the server",
            "type": "integer"
          },
          "extension_port": {
            "description": "Port number internal to the extension",
            "type": "integer"
          }
        },
        "required": [
          "protocol",
          "host_port",
          "extension_port"
        ]
      },
      "ExtensionInstanceReinstall": {
        "title": "ExtensionInstanceReinstall",
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "files": {
            "description": "Maps extension file IDs to local content items, with ‘public:’ or ‘private:’ prefix",
            "type": "object"
          },
          "ip_address": {
            "description": "IP address to allocate to the extension, or null",
            "type": "string"
          }
        }
      },
      "Protocol": {
        "title": "Protocol",
        "description": "Protocol used for syslog target",
        "example": "UDP",
        "type": "string",
        "enum": [
          "UDP",
          "TCP"
        ]
      },
      "State": {
        "title": "State",
        "description": "Desired state of the extension",
        "example": "stopped",
        "type": "string",
        "enum": [
          "stopped",
          "running"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ClearPass REST API. Authorization: Bearer <access_token>"
      }
    }
  }
