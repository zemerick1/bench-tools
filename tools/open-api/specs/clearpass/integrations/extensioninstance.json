    "/extension/instance": {
      "get": {
        "summary": "Get a list of installed extensions",
        "description": "Get a list of installed extensions. ",
        "operationId": "ExtensionInstanceInstanceGet",
        "deprecated": false,
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "JSON filter expression specifying the items to return",
            "schema": {
              "type": "string",
              "default": "{}"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort ordering for returned items (default +name)",
            "schema": {
              "type": "string",
              "default": "+name"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Zero based offset to start from",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": "0"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of items to return (1 – 1000)",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": "25"
            }
          },
          {
            "name": "calculate_count",
            "in": "query",
            "required": false,
            "description": "Whether to calculate the total item count",
            "schema": {
              "type": "boolean",
              "default": "false"
            }
          }
        ],
