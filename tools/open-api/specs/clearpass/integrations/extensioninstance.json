  "components": {
    "schemas": {
      "ExtensionInstance": {
        "title": "ExtensionInstance",
        "type": "object",
        "properties": {
          "id": {
            "description": "ID of the extension instance",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "state_details": {
            "description": "Additional information about the current state of the extension",
            "type": "string"
          },
          "store_id": {
            "description": "ID of the extension in the store",
            "type": "string"
          },
          "name": {
            "description": "Name of the extension",
            "type": "string"
          },
          "version": {
            "description": "Version number of the extension",
            "type": "string"
          },
          "description": {
            "description": "Description of the extension",
            "type": "string"
          },
          "icon_href": {
            "description": "URL for the extension’s icon",
            "type": "string"
          },
          "about_href": {
            "description": "URL for the extension’s documentation",
            "type": "string"
          },
          "hostname": {
            "description": "Hostname assigned to the extension",
            "type": "string"
          },
          "network_ports": {
            "description": "List of network ports provided by the extension",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionInstanceNetworkPort"
            }
          },
          "extension_hrefs": {
            "description": "List of URLs provided by the extension",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionInstanceHref"
            }
          },
          "files": {
            "description": "Map of extension file IDs to local content items, with ‘public:’ or ‘private:’ prefix",
            "type": "object"
          },
          "file_descriptions": {
            "description": "Contains a description of each extension file ID",
            "type": "object"
          },
          "internal_ip_address": {
            "description": "Internal IP address of the extension",
            "type": "string"
          },
          "needs_reinstall": {
            "description": "Indicates that the extension is out-of-date and should be reinstalled",
            "type": "boolean"
          },
          "reinstall_details": {
            "description": "State details for any background reinstall operation that is in progress",
            "type": "string"
          },
          "has_config": {
            "description": "Indicates that the extension has configuration settings",
            "type": "boolean"
          },
          "install_time": {
            "description": "Time at which the extension was installed",
            "type": "string"
          }
        }
      },
      "ExtensionInstanceCreate": {
        "title": "ExtensionInstanceCreate",
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "store_id": {
            "description": "ID from the extension store",
            "type": "string"
          },
          "files": {
            "description": "Maps extension file IDs to local content items, with ‘public:’ or ‘private:’ prefix",
            "type": "object"
          },
          "ip_address": {
            "description": "IP address to allocate to the extension, or null",
            "type": "string"
          },
          "note": {
            "description": "Note to be displayed with the extension.",
            "type": "string"
          }
        },
        "required": [
          "store_id"
        ]
      },
      "ExtensionInstanceHref": {
        "title": "ExtensionInstanceHref",
        "type": "object",
        "properties": {
          "description": {
            "description": "Description of the URL",
            "type": "string"
          },
          "href": {
            "description": "Server-relative URL path",
            "type": "string"
          }
        },
        "required": [
          "href"
        ]
      },
      "ExtensionInstanceItems": {
        "title": "ExtensionInstanceItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionInstance"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ExtensionInstanceList": {
        "title": "ExtensionInstanceList",
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/ExtensionInstanceItems"
          },
          "_links": {
            "$ref": "#/components/schemas/HalLinks"
          },
          "count": {
            "description": "Total number of items matching the filter; returned if calculate_count is true",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "_embedded",
          "_links"
        ]
      },
      "ExtensionInstanceModify": {
        "title": "ExtensionInstanceModify",
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "note": {
            "description": "Note to be displayed with the extension.",
            "type": "string"
          }
        }
      },
      "ExtensionInstanceNetworkPort": {
        "title": "ExtensionInstanceNetworkPort",
        "type": "object",
        "properties": {
          "description": {
            "description": "Description of the service provided on this port",
            "type": "string"
          },
          "protocol": {
            "$ref": "#/components/schemas/Protocol"
          },
          "host_port": {
            "description": "Port number for the server",
            "type": "integer"
          },
          "extension_port": {
            "description": "Port number internal to the extension",
            "type": "integer"
          }
        },
        "required": [
          "protocol",
          "host_port",
          "extension_port"
        ]
      },
      "HalLinks": {
        "title": "HalLinks",
        "type": "object",
        "properties": {
          "self": {
            "description": "URL of result",
            "type": "string"
          },
          "first": {
            "description": "URL of first page of results",
            "type": "string"
          },
          "last": {
            "description": "URL of last page of results",
            "type": "string"
          },
          "prev": {
            "description": "URL of previous page of results",
            "type": "string"
          },
          "next": {
            "description": "URL of next page of results",
            "type": "string"
          }
        },
        "required": [
          "self",
          "first"
        ]
      },
      "Protocol": {
        "title": "Protocol",
        "description": "Protocol used for syslog target",
        "example": "UDP",
        "type": "string",
        "enum": [
          "UDP",
          "TCP"
        ]
      },
      "State": {
        "title": "State",
        "description": "Desired state of the extension",
        "example": "stopped",
        "type": "string",
        "enum": [
          "stopped",
          "running"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ClearPass REST API. Authorization: Bearer <access_token>"
      }
    }
  }
}
