{
  "openapi": "3.0.0",
  "info": {
    "title": "ExtensionStore",
    "version": "6.12.7"
  },
  "servers": [
    {
      "url": "https://clearpass-hostname/api"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "ExtensionStore",
      "description": "Query the extension store"
    }
  ],
  "paths": {
    "/extension/store": {
      "get": {
        "summary": "Find a extension in the store",
        "description": "Find a extension in the store. ",
        "operationId": "ExtensionStoreStoreGet",
        "deprecated": false,
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "JSON filter expression specifying the items to return",
            "schema": {
              "type": "string",
              "default": "{}"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort ordering for returned items (default +name)",
            "schema": {
              "type": "string",
              "default": "+name"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Zero based offset to start from",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": "0"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of items to return (1 – 1000)",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": "25"
            }
          },
          {
            "name": "calculate_count",
            "in": "query",
            "required": false,
            "description": "Whether to calculate the total item count",
            "schema": {
              "type": "boolean",
              "default": "false"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionStoreList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "ExtensionStore"
        ]
      }
    },
    "/extension/store/{id}": {
      "get": {
        "summary": "Get details of an extension in the store",
        "description": "Get details of an extension in the store",
        "operationId": "ExtensionStoreStoreByIdGet",
        "deprecated": false,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "URL parameter id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionStore"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "tags": [
          "ExtensionStore"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ExtensionStore": {
        "title": "ExtensionStore",
        "type": "object",
        "properties": {
          "id": {
            "description": "ID of the extension",
            "type": "string"
          },
          "name": {
            "description": "Name of the extension",
            "type": "string"
          },
          "version": {
            "description": "Version number of the extension",
            "type": "string"
          },
          "description": {
            "description": "Description of the extension",
            "type": "string"
          },
          "icon_href": {
            "description": "URL for the extension’s icon",
            "type": "string"
          },
          "about_href": {
            "description": "URL for the extension’s documentation",
            "type": "string"
          },
          "files": {
            "description": "Describes each of the file IDs required by this extension",
            "type": "object"
          },
          "subscribed": {
            "description": "Subscribed to this extension",
            "type": "string"
          }
        }
      },
      "ExtensionStoreItems": {
        "title": "ExtensionStoreItems",
        "type": "object",
        "properties": {
          "items": {
            "description": "List of items matching the filter",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtensionStore"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ExtensionStoreList": {
        "title": "ExtensionStoreList",
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/ExtensionStoreItems"
          },
          "_links": {
            "$ref": "#/components/schemas/HalLinks"
          },
          "count": {
            "description": "Total number of items matching the filter; returned if calculate_count is true",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "_embedded",
          "_links"
        ]
      },
      "HalLinks": {
        "title": "HalLinks",
        "type": "object",
        "properties": {
          "self": {
            "description": "URL of result",
            "type": "string"
          },
          "first": {
            "description": "URL of first page of results",
            "type": "string"
          },
          "last": {
            "description": "URL of last page of results",
            "type": "string"
          },
          "prev": {
            "description": "URL of previous page of results",
            "type": "string"
          },
          "next": {
            "description": "URL of next page of results",
            "type": "string"
          }
        },
        "required": [
          "self",
          "first"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ClearPass REST API. Authorization: Bearer <access_token>"
      }
    }
  }
}
