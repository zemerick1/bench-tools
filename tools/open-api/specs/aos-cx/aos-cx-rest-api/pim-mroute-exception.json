                        "ttl1_drop_counter": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Specifies number of multicast packet dropped due to ttl 1"
                        }
                      }
                    },
                    "packet_rx_rate": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Number of Multicast Packets received per minute for this multicast stream."
