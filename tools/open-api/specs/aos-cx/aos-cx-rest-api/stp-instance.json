                          "format": "int64",
                          "description": "VSX peer device's path cost from the  transmitting bridge to the CIST regional root.",
                          "maximum": 4294967295,
                          "minimum": 0
                        },
                        "mstp_cist_regional_root": {
                          "type": "string",
                          "description": "VSX peer device's regional root bridge  for the CIST instance.",
                          "maxLength": 45
                        },
                        "remaining_hops": {
                          "type": "integer",
