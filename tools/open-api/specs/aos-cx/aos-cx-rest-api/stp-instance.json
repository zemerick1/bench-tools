                        "designated_bridge": {
                          "type": "string",
                          "description": "VSX peer device's designated bridge name  for this STP instance.",
                          "maxLength": 45
                        },
                        "designated_port": {
                          "type": "string",
                          "description": "VSX peer device's designated port name  for this STP instance.",
                          "maxLength": 45
                        },
                        "designated_port_priority": {
                          "type": "integer",
                          "description": "VSX peer device's designated port priority  for this STP instance.",
