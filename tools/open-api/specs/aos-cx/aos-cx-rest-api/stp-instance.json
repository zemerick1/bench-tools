{
  "openapi": "3.0.0",
  "info": {
    "title": "STP_Instance",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "STP_Instance"
    }
  ],
  "paths": {
    "/system/stp_instances": {
      "get": {
        "tags": [
          "STP_Instance"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "bridge_identifier": {
                      "type": "string",
                      "description": "Unique Identifier of a bridge. It is a 64-bit value,  (4-bit priority, 12-bit instance ID, 48-bit system MAC address)",
                      "maxLength": 45
                    },
                    "designated_bridge": {
                      "type": "string",
                      "description": "The designated bridge name for this STP instance.",
                      "maxLength": 45
                    },
                    "designated_port": {
                      "type": "string",
                      "description": "The designated port name for this STP instance.",
                      "maxLength": 45
                    },
                    "designated_port_priority": {
                      "type": "integer",
                      "description": "The designated port priority for this STP instance.",
                      "maximum": 256,
                      "minimum": 0
                    },
                    "designated_root": {
                      "type": "string",
                      "description": "The root bridge name for this STP instance.",
                      "maxLength": 45
                    },
                    "forward_delay": {
                      "type": "integer",
                      "description": "The time in seconds that is spent in the  listening and learning states.",
                      "maximum": 30,
                      "minimum": 4
                    },
                    "fully_provisioned": {
                      "type": "boolean",
                      "description": "Identifies when all appropriate interfaces have fully joined the instance. Might be `false` at the time of initial provisioning of the instance."
                    },
                    "hardware_grp_id": {
                      "type": "integer",
                      "format": "int64",
                      "description": "RPVST hardware group ID."
                    },
                    "hello_time": {
                      "type": "integer",
                      "description": "The time in seconds between consecutive BPDUs sent to a port.",
                      "maximum": 10,
                      "minimum": 2
                    },
                    "instance_type": {
                      "type": "string",
                      "description": "Reference Resource: [STP_Instance](#/STP_Instance)<br>Identifies, which specific STP protocol the instance is associated with.",
                      "enum": [
                        "mstp",
                        "rpvst"
                      ]
                    },
                    "joined_vlans": {
                      "type": "array",
                      "description": "Reference Resource: [VLAN](#/VLAN)<br>The set of VLANs that actually joined the instance.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 4094
                    },
                    "max_age": {
                      "type": "integer",
                      "description": "The time in seconds a device waits without  receiving spanning tree configuration messages before  attempting a reconfiguration for this instance.",
                      "maximum": 40,
                      "minimum": 6
                    },
                    "mst_stg_id": {
                      "type": "integer",
                      "description": "MSTP hardware group ID.",
                      "maximum": 4094,
                      "minimum": 0
                    },
                    "mstp_cist_path_cost": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The path cost from the transmitting bridge to the CIST regional root.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "mstp_cist_regional_root": {
                      "type": "string",
                      "description": "The regional root bridge for the CIST instance.",
                      "maxLength": 45
                    },
                    "mstp_fid_to_msti": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The FID to MSTID mapping of the spanning tree."
                    },
                    "oper_forward_delay": {
                      "type": "integer",
                      "description": "The operating forward delay time in seconds for this instance.",
                      "maximum": 30,
                      "minimum": 4
                    },
                    "oper_hello_time": {
                      "type": "integer",
                      "description": "The operating hello time in seconds for this instance.",
                      "maximum": 10,
                      "minimum": 1
                    },
                    "oper_max_age": {
                      "type": "integer",
                      "description": "The operating maximum-aging time in seconds for this instance.",
                      "maximum": 40,
                      "minimum": 6
                    },
                    "origin": {
                      "type": "string",
                      "description": "Specifies whether the instance is created by the system   (MST CIST or RPVST), or by user configuration.",
                      "enum": [
                        "built-in",
                        "configuration"
                      ]
                    },
                    "priority": {
                      "type": "integer",
                      "description": "The configured priority value. The lower the value, the higher the priority.",
                      "maximum": 15,
                      "minimum": 0
                    },
                    "remaining_hops": {
                      "type": "integer",
                      "description": "The hop count after which the BPDU of this instance  is discarded.",
                      "maximum": 40,
                      "minimum": 0
                    },
                    "root_path_cost": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The path cost from the transmitting Bridge to the Root Bridge for this instance.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "root_port": {
                      "type": "string",
                      "description": "The root port name for this instance.",
                      "maxLength": 45
                    },
                    "root_priority": {
                      "type": "integer",
                      "description": "The root bridge priority. The lower the value, the higher the priority.",
                      "maximum": 61440,
                      "minimum": 0
                    },
                    "stp_instance_id": {
                      "type": "integer",
                      "description": "Reference Resource: [STP_Instance](#/STP_Instance)<br>Unique identifier of the STP Instance.",
                      "maximum": 4094,
                      "minimum": 0
                    },
                    "stp_instance_ports": {},
                    "time_of_top_change": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The time at which the last topology change occurred for this instance. Calculated as time (in seconds) from epoch."
                    },
                    "topology_change_count": {
                      "type": "integer",
                      "description": "The total number of topology changes that have occurred for this instance.",
                      "maximum": 2147483647,
                      "minimum": 0
                    },
                    "topology_change_trap_enable": {
                      "type": "boolean",
                      "description": "Enables the topology change trap for this MSTP instance."
                    },
                    "topology_unstable": {
                      "type": "boolean",
                      "description": "Set to 'true' just after a topology change. Set  to 'false' once the topology stabilizes."
                    },
                    "vlan_ids": {
                      "type": "array",
                      "description": "Identifiers of the VLANs that should be joined into the instance. VLANs might already exist or will be created later due to user configuration, MVRP discovery or any other reason. For the list of actually joined VLANs, refer to 'joined_vlans'.",
