{
  "openapi": "3.0.0",
  "info": {
    "title": "Multicast_Replication_Portset",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Multicast_Replication_Portset"
    }
  ],
  "paths": {
    "/system/multicast_replication_portsets": {
      "get": {
        "tags": [
          "Multicast_Replication_Portset"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "egress_port": {
                      "type": "string",
                      "description": "Reference Resource: [Port](#/Port)<br>Reference to the underlying egress port corresponding to the l3_port. For example, a tunnel l3_port has a given egress port (ex. 1/1/1)."
                    },
                    "l2_portset": {
                      "type": "array",
                      "description": "Reference Resource: [Port](#/Port)<br>Reference to a list of Ports that belongs to a bridge.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000
                    },
                    "l2_portset_behavior": {
                      "type": "string",
                      "description": "Behavior of the replication portset (explicit flood or filter) when l2_portset is empty.",
                      "enum": [
                        "flood_when_empty",
                        "filter_when_empty"
                      ]
                    },
                    "l3_port": {
                      "type": "string",
                      "description": "Reference Resource: [Port](#/Port)<br>Reference to a routing port in [Port](#/Port) that belongs to a VRF."
                    },
                    "type": {
                      "type": "string",
                      "description": "Whether the replication portset corresponds to an upstream or  downstream multicast source.",
                      "enum": [
                        "upstream",
                        "downstream"
                      ]
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "type",
                  "l3_port",
                  "egress_port",
                  "l2_portset",
                  "l2_portset_behavior"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "responses": {
      "304": {
        "description": "Not Modified"
      },
      "400": {
        "description": "Bad Request"
      },
      "401": {
        "description": "Unauthorized"
      },
      "403": {
        "description": "Forbidden"
      },
      "404": {
        "description": "Not Found"
      },
      "500": {
        "description": "Internal Server Error"
      },
      "501": {
        "description": "Not Implemented"
      },
      "503": {
        "description": "Service Unavailable"
      }
    }
  }
