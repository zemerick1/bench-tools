                      "type": "string",
                      "description": "Reference Resource: [Virtual_Network_ID](#/Virtual_Network_ID)<br>Virtual Network Identifier of the upstream L3VNI interface."
                    },
                    "upstream_state": {
                      "type": "string",
                      "description": "Upstream state for this flow.",
                      "enum": [
                        "joined",
                        "not-joined",
                        "spt-joined",
                        "pruned"
                      ]
                    }
                  },
                  "type": "object"
                }
