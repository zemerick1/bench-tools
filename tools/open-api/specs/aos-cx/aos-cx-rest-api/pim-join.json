        "tags": [
          "PIM_Join"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "address_family": {
                      "type": "string",
                      "description": "Multicast stream's IP version.",
                      "enum": [
                        "ipv4",
                        "ipv6"
                      ]
                    },
                    "creation_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time in seconds since epoch when this upstream join was instantiated in the system."
                    },
                    "creation_time_micro_seconds": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time in micro seconds since epoch when this upstream join was instantiated in the system."
                    },
                    "downstream_interfaces": {
                      "type": "array",
                      "description": "Reference Resource: [Port](#/Port)<br>List of downstream interfaces participating in this flow.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000
                    },
                    "downstream_l3_vni": {
                      "type": "string",
                      "description": "Reference Resource: [Virtual_Network_ID](#/Virtual_Network_ID)<br>Virtual Network Identifier of the downstream L3VNI interface that is part of the Olist."
                    },
                    "from": {
                      "type": "string",
                      "description": "Multicast protocol that owns this entry.",
                      "enum": [
                        "pim"
                      ]
                    },
                    "group_address": {
                      "type": "string",
                      "description": "Reference Resource: [PIM_Join](#/PIM_Join)<br>Multicast stream group address.",
