                    },
                    "is_l3_vni_join": {
                      "type": "boolean",
                      "description": "Indicates if this contains L3VNI interface as upstream or downstream interface"
                    },
                    "pim_router": {
                      "type": "string",
                      "description": "Reference Resource: [PIM_Join](#/PIM_Join)<br>The [PIM_Router](#/PIM_Router) on which this join is learnt."
                    },
                    "rpf_neighbor": {
                      "type": "string",
                      "description": "Upstream RPF neighbor for the specified flow.",
                      "maxLength": 45
                    },
                    "source_address": {
                      "type": "string",
                      "description": "Reference Resource: [PIM_Join](#/PIM_Join)<br>Source address of the multicast stream. For PIM (*, G) joins, this is set to 0.0.0.0 for IPv4 flows and :: for IPv6 flows.",
                      "maxLength": 45
                    },
                    "type": {
                      "type": "string",
                      "description": "Reference Resource: [PIM_Join](#/PIM_Join)<br>Type of this join/prune sent to upstream interface.",
                      "enum": [
                        "starg",
                        "sg",
                        "sgrpt"
