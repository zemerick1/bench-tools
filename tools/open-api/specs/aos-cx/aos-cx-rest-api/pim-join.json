          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "upstream_interface",
                  "upstream_state",
                  "downstream_l3_vni",
                  "is_l3_vni_join",
                  "creation_time_micro_seconds",
                  "pim_router",
                  "group_address",
