        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "hw_default": {
                      "type": "boolean",
                      "description": "When true, this row signifies the hardware default schedule profile.  Default schedule profile is \"Strict Priority\" when any of the following occur:  +No row in this table has hw_default true +More than one row in this table has hw_default true +Any [Queue](#/Queue) rows referenced do not have their hw_default true"
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [QoS](#/QoS)<br>There must be a user-defined name of the schedule profile.",
                      "maxLength": 64,
                      "minLength": 1
                    },
                    "queues": {
                      "type": "object",
                      "description": "Reference Resource: [Queue](#/Queue)<br>Schedule parameters for individual queues.  Queues are numbered in *priority order*, with zero being the lowest priority. The maximum number of queues is hardware dependent.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Queue"
                        }
                      }
                    },
                    "vsx_sync": {
                      "type": "array",
                      "description": "Controls which attributes should be synchronized between VSX peers. 'all_attributes_and_dependents': the entire schedule profile, including its entries, should be synchronized.",
                      "items": {
                        "type": "string",
                        "enum": [
                          "all_attributes_and_dependents"
                        ]
                      },
                      "maxItems": 9223372036854776000
                    }
                  },
                  "required": [
                    "name"
