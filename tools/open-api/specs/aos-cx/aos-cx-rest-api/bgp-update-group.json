                      "enum": [
                        "internal",
                        "external"
                      ]
                    },
                    "slow_group": {
                      "type": "boolean",
                      "description": "Indicates whether the update-group comprises of slow peers."
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [BGP_Update_Group](#/BGP_Update_Group)<br>VRF associated with this update-group."
