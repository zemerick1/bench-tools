{
  "openapi": "3.0.0",
  "info": {
    "title": "MACsec_KaY_MKA",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "MACsec_KaY_MKA"
    }
  ],
  "paths": {
    "/system/interfaces/{Interface.name}/macsec_secies/{MACsec_SecY.id}/kay_mka": {
      "get": {
        "tags": [
          "MACsec_KaY_MKA"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "actor_priority": {
                      "type": "integer",
                      "description": "Key Server priority associated with the KaY.",
                      "maximum": 255,
                      "minimum": 0
                    },
                    "actor_sci": {
                      "type": "string",
                      "description": "Secure Channel Identifier (SCI) associated with the Key Agreement Entity (KaY).",
                      "maxLength": 16,
                      "minLength": 16
                    },
                    "id": {
                      "type": "integer",
                      "description": "Reference Resource: [MACsec_KaY_MKA](#/MACsec_KaY_MKA)<br>MACSec Key Agreement Entity associated with this SecY."
                    },
                    "keyserver_priority": {
                      "type": "integer",
                      "description": "Priority associated with the operational key server for this session. This matches the actor_priority if the actor is the Key Server.",
                      "maximum": 255,
                      "minimum": 0
                    },
                    "keyserver_sci": {
                      "type": "string",
                      "description": "SCI associated with the operational key server for this session. This matches the actor_sci if the actor is the Key Server.",
                      "maxLength": 16,
                      "minLength": 16
                    },
                    "mka_statistics": {
                      "type": "object",
                      "properties": {
                        "mkapdus_invalid_ckn": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of MKA PDUs received with invalid CKN."
                        },
                        "mkapdus_invalid_version": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of MKA PDUs received with invalid version."
                        }
                      }
                    },
                    "participants": {
                      "type": "object",
                      "description": "Reference Resource: [MACsec_KaY_MKA_Participant](#/MACsec_KaY_MKA_Participant)<br>MKA instances running on this KaY, one for each Connectivity Association Key Name (CKN).",
                      "properties": {
                        "string": {
                          "type": "string",
                          "description": "Reference resource URI of MACsec_KaY_MKA_Participant"
                        }
                      }
                    },
                    "rx_an": {
                      "type": "integer",
                      "description": "Association Number assigned by the Key Server for use with rx_kn.",
                      "maximum": 3,
                      "minimum": 0
                    },
                    "rx_kn": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Key Number assigned by the Key Server to the oldest SAK currently being used for reception.",
                      "maximum": 4294967295,
                      "minimum": 1
                    },
                    "tx_an": {
                      "type": "integer",
                      "description": "Association Number assigned by the Key Server for use with tx_kn.",
                      "maximum": 3,
                      "minimum": 0
                    },
                    "tx_kn": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Key Number assigned by the Key Server to the SAK currently being used for transmission.",
                      "maximum": 4294967295,
                      "minimum": 1
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "Interface.name",
            "in": "path",
            "description": "Reference Resource: [Interface](#/Interface)<br>The interface name. For non-bonded ports, the interface name is the same as the associated port name. The name must otherwise be unique across all ports and interfaces of the system.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "MACsec_SecY.id",
            "in": "path",
            "description": "Reference Resource: [MACsec_SecY](#/MACsec_SecY)<br>The identifier associated with the SecY.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "keyserver_priority",
                  "tx_kn",
                  "rx_kn",
                  "mka_statistics",
                  "actor_sci",
                  "actor_priority",
                  "rx_an",
                  "participants",
                  "keyserver_sci",
                  "tx_an"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
