{
  "openapi": "3.0.0",
  "info": {
    "title": "Boot",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Boot"
    }
  ],
  "paths": {
    "/boot": {
      "post": {
        "description": "Reboot the specified firmware image(s).",
        "summary": "Reboot the specified firmware image(s).",
        "tags": [
          "Boot"
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "name": "image",
            "in": "query",
            "description": "Image(s) to reboot.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "save_running_config",
            "in": "query",
            "description": "Set the value to true for saving running configuration before rebooting. Default value true.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "allow_non_failsafe_updates",
            "in": "query",
            "description": "Set the value to true for allowing non failsafe updates. Default value false.",
            "schema": {
              "type": "boolean"
            }
          }
        ]
      }
    }
  }
}
