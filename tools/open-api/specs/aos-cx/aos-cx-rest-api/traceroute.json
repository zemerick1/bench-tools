{
  "openapi": "3.0.0",
  "info": {
    "title": "Traceroute",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Traceroute"
    }
  ],
  "paths": {
    "/traceroute": {
      "get": {
        "description": "Get traceroute result to a destination.<br><br>  This URI is not supported by Notifications or NAE.",
        "summary": "Traceroute result.",
        "tags": [
          "Traceroute"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "name": "ip",
            "in": "query",
            "description": "destination IP. IPv4, IPv6, or hostname",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "is_ipv4",
            "in": "query",
            "description": "Set the value to true if the destination is an IPV4 address.",
            "schema": {
              "type": "boolean"
            },
            "required": true
          },
          {
            "name": "loose_source_ip",
            "in": "query",
            "description": "IPv4 address. Destination IP must be IPv4.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination_port",
            "in": "query",
            "description": "Integer in range 1-34000",
            "schema": {
              "type": "integer",
              "maximum": 34000,
              "minimum": 0
            }
          },
          {
            "name": "max_ttl",
            "in": "query",
            "description": "maximum time-to-live (TTL), integer in range 1-255, default value 30.",
            "schema": {
              "type": "integer",
              "maximum": 255,
              "minimum": 1
            }
          },
          {
            "name": "probes",
            "in": "query",
            "description": "integer in range 1-5, default value 3",
            "schema": {
              "type": "integer",
              "maximum": 5,
              "minimum": 1
            }
          },
          {
            "name": "timeout",
            "in": "query",
            "description": "nteger in range 1-60, default value 3",
            "schema": {
              "type": "integer",
              "maximum": 60,
              "minimum": 1
            }
          },
          {
            "name": "mgmt",
            "in": "query",
            "description": "VRF name/Management mutually exclusive. default value false",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "vrf_name",
            "in": "query",
            "description": "VRF name/Management mutually exclusive. default value 'swns'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
