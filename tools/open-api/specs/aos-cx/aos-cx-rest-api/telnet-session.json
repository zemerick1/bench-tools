                      "type": "string",
                      "description": "Reference Resource: [TELNET_Session](#/TELNET_Session)<br>IPv4 address of the remote TELNET client."
                    },
                    "client_port": {
                      "type": "integer",
                      "description": "Reference Resource: [TELNET_Session](#/TELNET_Session)<br>TELNET client port.",
                      "maximum": 65535,
                      "minimum": 1
                    },
                    "server_ip": {
                      "type": "string",
                      "description": "Device IPv4 address that this TELNET connection was established on.",
                      "maxLength": 45
                    },
                    "server_port": {
                      "type": "integer",
                      "description": "TELNET server port.",
                      "maximum": 65535,
                      "minimum": 1
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [TELNET_Session](#/TELNET_Session)<br>VRF corresponding to this TELNET session."
