{
  "openapi": "3.0.0",
  "info": {
    "title": "Authentication_Modes",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Authentication_Modes"
    }
  ],
  "paths": {
    "/authentication_modes": {
      "get": {
        "description": "Get the status of the https-server authentication modes.<br><br>  This URI is not supported by Notifications or NAE.",
        "summary": "Get the status of the https-server authentication modes.",
        "tags": [
          "Authentication_Modes"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "certificate": {
                      "properties": {
                        "status": {
                          "enum": [
                            "disabled",
                            "enabled"
                          ],
                          "type": "string"
                        }
                      }
                    },
                    "password": {
                      "properties": {
                        "status": {
                          "enum": [
                            "enabled",
                            "disabled"
                          ],
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  }
}
