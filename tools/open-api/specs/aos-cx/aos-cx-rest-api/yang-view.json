      "get": {
        "tags": [
          "YANG_View"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "injected_view": {
                      "type": "string",
                      "description": "Injected view content a tarball encoded in Base64 with the required files for having an injected view. In case built-in views this column will remain empty. The max length represents a 256KB script.",
                      "maxLength": 342000
                    },
                    "invalid_reason": {
                      "type": "string",
                      "description": "'not_applicable': this column is not applicable to this row. (i.e. no failure) 'bad_file_name': bad filename/path/permissions. 'invalid_type': injected views' type should be declared as injected. 'invalid_YANG': the YANG view contains invalid YANG statements. 'invalid_protocol_buffer': the Protocol Buffer definition contains invalid statements. 'max_amount_of_injected_views_reached': reached the maximum amount of injected views. 'error_uncompressing': Failed uncompressing YANG View. 'error_loading': Failed loading YANG View. 'error_deleting': Failed removing YANG View. 'error_initializing': Failed to initialize the YANG View. 'unsupported_extension': The YANG view contains an unsupported extension. 'unsupported_model_relationship': The YANG view contains an unsupported model relationship.",
                      "enum": [
                        "not_applicable",
                        "bad_file_name",
                        "invalid_type",
                        "invalid_YANG",
                        "invalid_protocol_buffer",
                        "max_amount_of_injected_views_reached",
                        "error_uncompressing",
                        "error_loading",
                        "error_deleting",
                        "error_initializing",
                        "unsupported_extension",
                        "unsupported_model_relationship"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [YANG_View](#/YANG_View)<br>Specifies the YANG view name.",
                      "maxLength": 255,
                      "minLength": 1
                    },
                    "revision": {
                      "type": "string",
                      "description": "The YANG view revision.",
                      "maxLength": 255
                    },
                    "sha256sum": {
                      "type": "string",
                      "description": "sha256sum associated to the injected file.",
                      "maxLength": 255
                    },
                    "state": {
                      "type": "string",
                      "description": "'uninitialized': the YANG view has not been yet initialized. 'validating': the YANG view is being validated. 'invalid': the YANG view is invalid. See 'invalid_reason' for more details. 'active': the YANG View is active and can be accessed by external users.",
                      "enum": [
                        "uninitialized",
                        "validating",
                        "invalid",
                        "active"
                      ]
                    },
                    "type": {
                      "type": "string",
                      "description": "'built-in': the view corresponds to a built-in view. 'injected':  the view corresponds to an injected view",
                      "enum": [
                        "built-in",
                        "injected"
                      ]
                    }
                  },
                  "required": [
                    "injected_view",
                    "name"
                  ],
                  "type": "object"
                }
