                    },
                    "preferred": {
                      "type": "boolean",
                      "description": "Deprecated. Using this column will have no effect."
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [Container_Network](#/Container_Network)<br>VRF to which the container would be connected."
