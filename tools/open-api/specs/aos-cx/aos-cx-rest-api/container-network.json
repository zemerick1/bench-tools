                      "type": "string",
                      "description": "Reference Resource: [Container_Network](#/Container_Network)<br>Container to which this network belongs."
                    },
                    "port_mapping": {
                      "type": "object",
                      "description": "Specifies the configuration required to apply port mapping. This is a map of the form {PROTOCOL: {HOST_PORT: CONTAINER_PORT}}, with PROTOCOL being one of either \"tcp\" or \"udp\", and the HOST_PORT and CONTAINER_PORT being an unused port number, from 1 to 65535.",
