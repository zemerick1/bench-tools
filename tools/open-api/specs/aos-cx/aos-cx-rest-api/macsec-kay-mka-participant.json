{
  "openapi": "3.0.0",
  "info": {
    "title": "MACsec_KaY_MKA_Participant",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "MACsec_KaY_MKA_Participant"
    }
  ],
  "paths": {
    "/system/interfaces/{Interface.name}/macsec_secies/{MACsec_SecY.id}/kay_mka/{MACsec_KaY_MKA.id}/participants": {
      "get": {
        "tags": [
          "MACsec_KaY_MKA_Participant"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "cak": {
                      "type": "string",
                      "description": "Secure Connectivity Assocation Key (CAK) associated with this MKA participant."
                    },
                    "ckn": {
                      "type": "string",
                      "description": "Reference Resource: [MACsec_KaY_MKA_Participant](#/MACsec_KaY_MKA_Participant)<br>MKA instances running on this KaY, one for each Connectivity Association Key Name (CKN)."
                    },
                    "member_identifier": {
                      "type": "string",
                      "description": "Member Identifier (MI) associated with the MKA pariticipant.",
                      "maxLength": 24,
                      "minLength": 24
                    },
                    "message_number": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Message Number (MN) associated with the MKA pariticipant.",
                      "maximum": 4294967295,
                      "minimum": 1
                    },
                    "mka_statistics": {
                      "type": "object",
                      "properties": {
                        "mkapdus_duplicate_mi": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of MKA PDUS received with duplicate MI."
                        },
                        "mkapdus_invalid_icv": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of MKA PDUS received with invalid ICV."
                        },
                        "mkapdus_invalid_mn": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of MKA PDUs received with invalid MN."
                        },
                        "mkapdus_rx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of MKA PDUs received."
                        },
                        "mkapdus_tx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of MKA PDUs transmitted."
                        },
                        "saks_distributed": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of SAKs distributed."
                        },
                        "saks_recieved": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of SAKs received."
                        }
                      }
                    },
                    "peers": {
                      "type": "object",
                      "description": "Reference Resource: [MACsec_KaY_MKA_Peer](#/MACsec_KaY_MKA_Peer)<br>Member identifier associated with the MKA peer.",
                      "properties": {
                        "string": {
                          "type": "string",
                          "description": "Reference resource URI of MACsec_KaY_MKA_Peer"
                        }
                      }
                    },
                    "transmit_sc": {
                      "type": "string",
                      "description": "Reference Resource: [MACsec_Secure_Channel](#/MACsec_Secure_Channel)<br>Transmit SC associated with the MKA participant."
                    }
                  },
                  "required": [
                    "ckn"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "Interface.name",
            "in": "path",
            "description": "Reference Resource: [Interface](#/Interface)<br>The interface name. For non-bonded ports, the interface name is the same as the associated port name. The name must otherwise be unique across all ports and interfaces of the system.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "MACsec_SecY.id",
            "in": "path",
            "description": "Reference Resource: [MACsec_SecY](#/MACsec_SecY)<br>The identifier associated with the SecY.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "MACsec_KaY_MKA.id",
            "in": "path",
            "description": "Reference Resource: [MACsec_KaY_MKA](#/MACsec_KaY_MKA)<br>MACSec Key Agreement Entity associated with this SecY.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "transmit_sc",
                  "message_number",
                  "peers",
                  "member_identifier",
                  "cak",
                  "mka_statistics"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
