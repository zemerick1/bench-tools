{
  "openapi": "3.0.0",
  "info": {
    "title": "Replication_Group",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Replication_Group"
    }
  ],
  "paths": {
    "/system/replication_groups": {
      "get": {
        "tags": [
          "Replication_Group"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "hw_id": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Identifier of the hardware multicast ID."
                    },
                    "hw_status": {
                      "type": "object",
                      "description": "Status information to indicate the current state of the hardware.",
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "Human readable error string."
                        }
                      }
                    },
                    "multidest_type": {
                      "type": "string",
                      "description": "'bridge_control':     Product of the IGMP/MLD protocol. The Replication Group entries with                       this type must be referenced from Multicast_L3_Bridge_Control_Forwarding 'mcast_routing':      Product of the PIM protocol. The Replication Group entries with                       this type must be referenced from Multicast_L3_Forwarding 'vlan_flooding':      Product of VLAN flooding. The Replication Group entries with                       this type must be referenced from VLAN. 'neighbor':           Product of an IP directed broadcast host.                       The Replication Group entries with this type must be referenced from Neighbor. 'vxlan':              Product of the VxLAN protocol. The Replication Group entries with                       this type must be referenced from Virtual_Network_ID.",
                      "enum": [
                        "bridge_control",
                        "mcast_routing",
                        "vlan_flooding",
                        "neighbor",
                        "vxlan"
                      ]
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "multidest_type",
                  "hw_id",
                  "hw_status"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "responses": {
      "304": {
        "description": "Not Modified"
      },
      "400": {
        "description": "Bad Request"
      },
      "401": {
        "description": "Unauthorized"
      },
      "403": {
        "description": "Forbidden"
      },
      "404": {
        "description": "Not Found"
      },
      "500": {
        "description": "Internal Server Error"
      },
      "501": {
        "description": "Not Implemented"
      },
      "503": {
        "description": "Service Unavailable"
      }
    }
  }
}
