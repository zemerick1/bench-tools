{
  "openapi": "3.0.0",
  "info": {
    "title": "CLI",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "CLI"
    }
  ],
  "paths": {
    "/cli": {
      "post": {
        "description": "Execute troubleshooting CLI show command",
        "summary": "Execute troubleshooting CLI show command",
        "tags": [
          "CLI"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "cmd": "show uptime"
                },
                "properties": {
                  "cmd": {
                    "description": "CLI allowed command",
                    "type": "string"
                  }
                },
                "required": [
                  "cmd"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "example": "System has been up 22 weeks, 1 hour, 36 minutes",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "502": {
            "description": "Bad Gateway"
          }
        }
      }
    },
    "/cli/commands": {
      "get": {
        "description": "Retrieve a list of allowed CLI commands",
        "summary": "Retrieve a list of allowed CLI commands",
        "tags": [
          "CLI"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": [
                  "show version",
                  "show uptime"
                ],
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  }
}
