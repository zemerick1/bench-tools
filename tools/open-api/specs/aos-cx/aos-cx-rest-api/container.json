              "application/json": {
                "schema": {
                  "properties": {
                    "allow_unsigned_image": {
                      "type": "boolean",
                      "description": "Indicate if unsigned images are allowed for the container."
                    },
                    "container_mounts": {},
                    "container_networks": {},
                    "enable": {
                      "type": "boolean",
                      "description": "Indicate if container is enabled or disabled."
                    },
                    "encrypted_environment_variables": {
                      "type": "object",
                      "description": "Encrypted environment variables to be exposed in container when it is started. Any updates to environment variables will result in the container being restarted.",
                      "properties": {
                        "string": {
                          "type": "string"
                        }
                      }
                    },
                    "environment_variables": {
                      "type": "object",
                      "description": "Environment variables to be exposed in container when it is started. Any updates to environment variables will result in the container being restarted.",
                      "properties": {
                        "string": {
                          "type": "string"
                        }
                      }
                    },
                    "error_message": {
                      "type": "string",
                      "description": "Message describing a possible error in the container configuration."
                    },
                    "image_download_vrf": {
                      "type": "string",
                      "description": "Reference Resource: [VRF](#/VRF)<br>VRF on which container image should be downloaded."
                    },
                    "image_location": {
                      "type": "string",
                      "description": "URL through which the image can be obtained.",
                      "maxLength": 1024
                    },
                    "image_status": {
                      "type": "string",
                      "description": "State of the container Image: no_image                        : Image is not available. download_in_progress            : Image is being downloaded. download_failed                 : Image download failed. image_size_exceeded             : Image size exceeds the maximum allowed. downloaded                      : Image downloaded successfully. verified                        : Image verified successfully. verification_failed             : Image verification failed. allowed_without_signature       : Image is unsigned, but unsigned images are allowed. unpack_failed                   : Image unpacking failed. load_failed                     : Image load failed. compatibility_check_failed      : Image compatibility check failed. incompatible_with_host_platform : Image incompatible with host CPU architecture.",
                      "enum": [
                        "no_image",
                        "download_in_progress",
                        "download_failed",
                        "downloaded",
                        "image_size_exceeded",
                        "verified",
                        "verification_failed",
                        "allowed_without_signature",
                        "unpack_failed",
                        "load_failed",
                        "compatibility_check_failed",
                        "incompatible_with_host_platform"
                      ]
                    },
                    "image_version": {
                      "type": "string",
                      "description": "Version of the image."
                    },
                    "manifest": {
                      "type": "string",
                      "description": "Reference Resource: [Container_Manifest](#/Container_Manifest)<br>Metadata found in the container's manifest file."
                    },
                    "manifest_status": {
                      "type": "string",
                      "description": "State of the container manifest: missing : Container does not have a manifest file. success : Container has a manifest file and was successfully parsed. error   : Container has a manifest file but there was an error parsing it. pending : Container image has not been mounted, so it is not possible to know if there is a manifest.",
                      "enum": [
                        "missing",
                        "success",
                        "error",
                        "pending"
                      ]
                    },
                    "manifest_status_reason": {
                      "type": "string",
                      "description": "Message describing details about the manifest status for the container."
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Container](#/Container)<br>Name of the container.",
                      "maxLength": 40,
                      "minLength": 1
                    },
                    "runtime_constraints": {
                      "type": "object",
                      "description": "Constraints to be applied on the container to avoid impact on the base operation of the switch.",
                      "properties": {
                        "cpu": {
                          "type": "integer",
                          "description": "Maximum percent of the CPU capacity to be permitted for the container.",
                          "maximum": 20,
                          "minimum": 1
                        },
                        "memory": {
                          "type": "integer",
                          "description": "Maximum amount of DRAM (in MB) to be permitted for the container.",
                          "maximum": 1024,
                          "minimum": 1
                        }
                      }
                    },
                    "status": {
                      "type": "string",
                      "description": "State of the container: down                          : Container is down. initializing                  : Container is initializing. operational                   : Container is up and running. network_failed                : Network provisioning failed. failed                        : Container failed to execute. configuration_failed          : User-applied configuration failed. container_waiting             : Container is waiting for config pre-requisites. container_acquiring           : Container is acquiring an image. container_deploying           : Container is deploying. container_deployed            : Container is deployed. container_exited              : Container has exited. acquire_failed                : Container failed to acquire image. deploy_failed                 : Container failed to deploy. run_failed                    : Container failed while running.",
                      "enum": [
                        "down",
                        "disabled",
                        "initializing",
                        "operational",
                        "network_failed",
                        "failed",
                        "configuration_failed",
                        "container_waiting",
                        "container_acquiring",
                        "container_deploying",
                        "container_deployed",
                        "container_exited",
                        "acquire_failed",
                        "deploy_failed",
                        "run_failed"
                      ]
                    },
                    "vrfs": {
                      "type": "array",
                      "description": "Reference Resource: [VRF](#/VRF)<br>Deprecated. Please refer to the Container_Network table to define the network configurations used by the container.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000
                    }
