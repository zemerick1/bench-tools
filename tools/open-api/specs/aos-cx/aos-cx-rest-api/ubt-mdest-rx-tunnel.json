{
  "openapi": "3.0.0",
  "info": {
    "title": "UBT_MDEST_RX_Tunnel",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "UBT_MDEST_RX_Tunnel"
    }
  ],
  "paths": {
    "/system/ubt_mdest_rx_tunnels": {
      "get": {
        "tags": [
          "UBT_MDEST_RX_Tunnel"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "controller_ip": {
                      "type": "string",
                      "description": "Reference Resource: [UBT_MDEST_RX_Tunnel](#/UBT_MDEST_RX_Tunnel)<br>SAC or S-SAC IP address of the zone that this tunnel belongs to.",
                      "maxLength": 45
                    },
                    "gre_key": {
                      "type": "integer",
                      "format": "int64",
                      "description": "GRE key associated with this tunnel.",
                      "maximum": 4294967295,
                      "minimum": 1
                    },
                    "local_ip": {
                      "type": "string",
                      "description": "Reference Resource: [UBT_MDEST_RX_Tunnel](#/UBT_MDEST_RX_Tunnel)<br>Switch local IP address.",
                      "maxLength": 45
                    },
                    "statistics": {
                      "type": "object",
                      "description": "Tunnel statistics for the number of MDEST  (Broadcast and Multicast) packets received from the Controller.",
                      "properties": {
                        "ingress_bytes": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of bytes of data received on this tunnel."
                        },
                        "ingress_packets": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of packets received on this tunnel."
                        }
                      }
                    },
                    "tunnel_state": {
                      "type": "string",
                      "description": "Tunnel status.  `activating`:          Tunnel is being provisioned in the hardware.  `activated`:           Tunnel has been provisioned in the hardware.  `deactivating`:        Request to delete tunnel from the hardware.  `deactivated`:         Tunnel has been deleted from the hardware.  `activation_failed`:   Tunnel provisioning in the hardware failed.  `deactivation_failed`: Hardware tunnel deletion failed.",
                      "enum": [
                        "activating",
                        "activated",
                        "deactivating",
                        "deactivated",
                        "activation_failed",
                        "deactivation_failed"
                      ]
                    },
                    "ubt_statistics_clear_performed": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Number of times statistics information for this tunnel was cleared.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "ubt_statistics_clear_requested": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Number of times request was made to clear statistics for this tunnel.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "ubt_zone": {
                      "type": "string",
                      "description": "Reference Resource: [UBT_Zone](#/UBT_Zone)<br>Zone associated with this tunnel."
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [UBT_MDEST_RX_Tunnel](#/UBT_MDEST_RX_Tunnel)<br>VRF instance that this tunnel belongs to."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ubt_zone",
                  "vrf",
                  "tunnel_state",
                  "statistics",
                  "ubt_statistics_clear_requested",
                  "ubt_statistics_clear_performed",
                  "local_ip",
                  "controller_ip",
                  "gre_key"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
