{
  "openapi": "3.0.0",
  "info": {
    "title": "Captive_Portal_Profile",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Captive_Portal_Profile"
    }
  ],
  "paths": {
    "/system/captive_portal_profiles": {
      "get": {
        "tags": [
          "Captive_Portal_Profile"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Captive_Portal_Profile](#/Captive_Portal_Profile)<br>Name of the captive portal profile.",
                      "maxLength": 128,
                      "minLength": 2
                    },
                    "origin": {
                      "type": "string",
                      "description": "Origin of the captive portal profile, i.e., how the captive portal profile  is created.  `local`:      captive portal profile is configured locally on the switch.  `downloaded`: downloaded from Clearpass server.  `radius`:     translated from the attributes assigned by RADIUS server.",
                      "enum": [
                        "downloaded",
                        "local",
                        "radius"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "description": "Captive portal redirect URL. Ex: http://www.testme.com/testme.cgi",
                      "maxLength": 1024,
                      "minLength": 1
                    },
                    "url_hash_key": {
                      "type": "string",
                      "description": "A URL Hash key to provide security for the captive portal exchange with Clearpass. The key is a shared secret between Clearpass and the switch.",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
