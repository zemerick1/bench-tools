{
  "openapi": "3.0.0",
  "info": {
    "title": "Hot_Patch",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Hot_Patch"
    }
  ],
  "paths": {
    "/system/hot_patches": {
      "get": {
        "tags": [
          "Hot_Patch"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "compatible_sw_version": {
                      "type": "string",
                      "description": "Version of software that is compatible with this hot-patch."
                    },
                    "control_state": {
                      "type": "string",
                      "description": "Defines the state of the hot patch. Valid values are: `active`:   The hot-patch is configured to be applied. `inactive`: The hot-patch is configured to not be applied.",
                      "enum": [
                        "active",
                        "inactive"
                      ]
                    },
                    "download_url": {
                      "type": "string",
                      "description": "The source file path for upload and download.",
                      "maxLength": 2048
                    },
                    "download_vrf": {
                      "type": "string",
                      "description": "Name of VRF to use for transfer."
                    },
                    "issues_fixed": {
                      "type": "string",
                      "description": "Issues fixed by this hot-patch."
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Hot_Patch](#/Hot_Patch)<br>Name of the hot-patch file.",
                      "maxLength": 256,
                      "minLength": 1
                    },
                    "origin": {
                      "type": "string",
                      "description": "Indicator of whether the hot-patch is built-in (system-defined) or configured. Built-in hot-patches cannot be modified or deleted by users.",
                      "enum": [
                        "built-in",
                        "configuration"
                      ]
                    },
                    "patch_info": {
                      "type": "object",
                      "description": "Information about the hot-patch file.",
                      "properties": {
                        "build_date": {
                          "type": "string",
                          "description": "The build date of the hot-patch in format YYYY-MM-DD HH:MM:SS TZD."
                        },
                        "build_id": {
                          "type": "string",
                          "description": "The build id string of the hot-patch."
                        },
                        "build_sha": {
                          "type": "string",
                          "description": "The build sha of the hot-patch."
                        },
                        "os_name": {
                          "type": "string",
                          "description": "Name of the operating system used by the hot-patch."
                        },
                        "sha_256": {
                          "type": "string",
                          "description": "The SHA256 calculated for the hot-patch file."
                        }
                      }
                    },
                    "phase_completed": {
                      "type": "string",
                      "description": "Indicates the installation phase completed."
                    },
                    "phase_requested": {
                      "type": "string",
                      "description": "Indicates the installation phase requested by orchestration."
                    },
                    "status": {
                      "type": "string",
                      "description": "State of the hot-patch: not_applied    : Hot-patch is not applied. applying       : Hot-patch is currently being applied applied        : Hot-patch has been applied. apply_failed   : Hot-patch failed to apply. incompatible   : Hot-patch is incompatible with this system or running software. not_applicable : Hot-patch does not apply to this system. invalid        : Hot-patch is invalid. missing        : Hot-patch file is missing. unapplying     : Hot-patch is currently being un-applied. unapply_failed : Hot-Patch failed to unapply.",
                      "enum": [
                        "not_applied",
                        "applying",
                        "applied",
                        "apply_failed",
                        "incompatible",
                        "not_applicable",
                        "invalid",
                        "missing",
                        "unapplying",
                        "unapply_failed"
                      ]
                    },
                    "subsystem_exclude": {
                      "type": "object",
                      "description": "Reference Resource: [Subsystem](#/Subsystem)<br>Indication that a subsystem is to be excluded from hot-patch installation. `true`   : Do not install the hot-patch on this subsystem. `false`  : Install the hot-patch on this subsystem.",
                      "properties": {
                        "URI": {
                          "type": "boolean"
                        }
                      }
                    },
                    "subsystem_phase": {
                      "type": "object",
                      "description": "Reference Resource: [Subsystem](#/Subsystem)<br>The most recent phase completed by the referenced subsystem.",
                      "properties": {
                        "URI": {
                          "type": "string"
                        }
                      }
                    },
                    "subsystem_status": {
                      "type": "object",
                      "description": "Reference Resource: [Subsystem](#/Subsystem)<br>State of the hot-patch on the referenced subsystem. Valid values are: not_applied    : Hot-patch is not applied. applying       : Hot-patch is currently being applied. applied        : Hot-patch has been applied. apply_failed   : Hot-patch failed to apply. incompatible   : Hot-patch is incompatible with this system or running software. not_applicable : Hot-patch does not apply to this system. invalid        : Hot-patch is invalid. missing        : Hot-patch file is missing. unapplying     : Hot-patch is currently being un-applied. unapply_failed : Hot-Patch failed to unapply.",
                      "properties": {
                        "URI": {
                          "type": "string",
                          "enum": [
                            "not_applied",
                            "applying",
                            "applied",
                            "apply_failed",
                            "incompatible",
                            "not_applicable",
                            "invalid",
                            "missing",
                            "unapplying",
                            "unapply_failed"
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    "download_url",
                    "name",
                    "download_vrf"
                  ],
                  "type": "object"
                }
