{
  "openapi": "3.0.0",
  "info": {
    "title": "Class",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Class"
    }
  ],
  "paths": {
    "/system/classes": {
      "get": {
        "tags": [
          "Class"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "cfg_entries": {
                      "type": "object",
                      "description": "Reference Resource: [Class_Entry](#/Class_Entry)<br>Class entries as configured by the user. An empty column value indicates that no match criteria is specified for this list.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Class_Entry"
                        }
                      }
                    },
                    "cfg_version": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The version of 'cfg_entries' that should be changed to a random value each time 'cfg_entries' is modified. An empty column value will indicate that the user does not want the system to process this configuration yet.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991
                    },
                    "cur_entries": {
                      "type": "object",
                      "description": "Reference Resource: [Class_Entry](#/Class_Entry)<br>Class entries that are currently programmed in the data path.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Class_Entry"
                        }
                      }
                    },
                    "in_progress_entries": {
                      "type": "object",
                      "description": "Reference Resource: [Class_Entry](#/Class_Entry)<br>Class entries that are being processed for installation into the data path.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Class_Entry"
                        }
                      }
                    },
                    "in_progress_version": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The version of the 'in_progress' Class.  This value is copied from 'cfg_version' when Class processing begins. This value is cleared when the Class status is updated to 'applied' or 'rejected.'",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Class](#/Class)<br>Name of a Classifier Class (Class).",
                      "maxLength": 64,
                      "minLength": 1
                    },
                    "origin": {
                      "type": "string",
                      "description": "Origin of the class, i.e., how the class is provisioned:  `dynamic`:    class is provisioned dynamically via DUR from                Clearpass server or via a NAS-Filter-Rule                attribute from a RADIUS server. `synthesized`: class has been dynamically synthesized                by the system.  `static`:     class is provisioned by the administrator                via CLI or REST.",
                      "enum": [
                        "dynamic",
                        "synthesized",
                        "static"
                      ]
                    },
                    "status": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Numeric error code.  Expected to be 0 when state is 'applied'."
                        },
                        "message": {
                          "type": "string",
                          "description": "Detailed reason for error state.  Expected empty when state is 'applied'."
                        },
                        "state": {
                          "type": "string",
                          "description": "Valid values are 'applied', 'in_progress', 'canceled', 'rejected'.",
                          "enum": [
                            "applied",
                            "in_progress",
                            "canceled",
                            "rejected"
                          ]
                        },
                        "version": {
                          "type": "integer",
                          "format": "int64",
                          "description": "The version of 'cfg_entries' that corresponds to this status."
                        }
                      }
                    },
                    "type": {
                      "type": "string",
                      "description": "Reference Resource: [Class](#/Class)<br>Type of a Class.",
                      "enum": [
                        "ipv4",
                        "ipv6",
                        "mac",
                        "gbp-ipv4",
                        "gbp-ipv6",
                        "gbp-mac"
                      ]
                    },
                    "vsx_sync": {
                      "type": "array",
                      "description": "Controls which attributes should be synchronized between VSX peers. 'all_attributes_and_dependents': the entire class and its entries should be synchronized. This column value can be empty.",
                      "items": {
                        "type": "string",
                        "enum": [
                          "all_attributes_and_dependents"
                        ]
                      },
                      "maxItems": 9223372036854776000
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
