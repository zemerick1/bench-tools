        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "authorized_keys": {
                      "type": "object",
                      "description": "Public keys for public key authentication of a user.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "maxLength": 8192
                        }
                      }
                    },
                    "current_password": {
                      "type": "string",
                      "description": "The plaintext password of the user, required for password updates when password complexity is enabled.",
                      "maxLength": 192
                    },
                    "is_user_lockedout": {
                      "type": "boolean",
                      "description": "Indicates whether this user is currently locked out from accessing the device."
                    },
                    "login_failure_attempts": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Number of failed login attempts for this user since last successful login."
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [User](#/User)<br>Name of the user.",
                      "maxLength": 32,
                      "minLength": 1
                    },
                    "origin": {
                      "type": "string",
                      "description": "Indicator of whether the user is built-in (system-defined) or configured. Unlike user configured users, built-in users cannot be deleted.",
                      "enum": [
                        "built-in",
                        "configuration"
                      ]
                    },
                    "password": {
                      "type": "string",
                      "description": "SHA1 or SHA512 encrypted password of the user. If not set, it indicates that the user is created with an empty password.",
                      "maxLength": 192
                    },
                    "user_group": {
                      "type": "string",
                      "description": "Reference Resource: [User_Group](#/User_Group)<br>User group to which the user belongs. If not populated, `operators` group would be assumed."
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
