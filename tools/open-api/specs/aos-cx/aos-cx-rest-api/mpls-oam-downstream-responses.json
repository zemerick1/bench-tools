        "tags": [
          "MPLS_OAM_Downstream_Responses"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "downstream_address": {
                      "type": "string",
                      "description": "Downstream LSR's Router ID or interface address",
                      "maxLength": 45
                    },
                    "label": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Downstream Label",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "mru": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Maximum receive unit of response packet"
                    },
                    "sequence_id": {
                      "type": "integer",
                      "description": "Reference Resource: [MPLS_OAM_Downstream_Responses](#/MPLS_OAM_Downstream_Responses)<br>For each sequence_id, which is the outer key, a map where  key is the downstream_interface_address(inner key) and value is  the reference to MPLS_OAM_Downstream_Responses row which  contains the respective downstream information."
                    },
                    "status": {
                      "type": "string",
                      "description": "Downstream response status",
                      "enum": [
                        "no_response",
                        "valid_response"
                      ]
                    }
                  },
                  "required": [
                    "sequence_id"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
