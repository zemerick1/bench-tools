            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "MPLS_OAM.target_address",
            "in": "path",
            "description": "Reference Resource: [MPLS_OAM](#/MPLS_OAM)<br>Indicates the target address (FEC) for the request packet.",
            "schema": {
              "type": "string"
