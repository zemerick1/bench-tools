{
  "openapi": "3.0.0",
  "info": {
    "title": "Service_Label",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Service_Label"
    }
  ],
  "paths": {
    "/system/service_labels": {
      "get": {
        "tags": [
          "Service_Label"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "address_family": {
                      "type": "string",
                      "description": "When service_type is l3-vpn, this field indicates the L3 service address family that is being carried.",
                      "enum": [
                        "ipv4",
                        "ipv6"
                      ]
                    },
                    "forwarding_state": {
                      "type": "string",
                      "description": "The forwarding state for the Service_Label entry that will be updated by the Data Plane.",
                      "enum": [
                        "operational",
                        "no-hw-resource",
                        "not-configured"
                      ]
                    },
                    "service_label": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Indicates the service label for the Label Switch Path.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "service_label_index": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Indicates the service label entry index for the Label Switch Path.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "service_type": {
                      "type": "string",
                      "description": "Type of Label Switch Path: 'l3-vpn'          : Indicates that the Label Switch Path carries l3-vpn service. 'l2-vpn'          : Indicates that the Label Switch Path carries l2-vpn service.",
                      "enum": [
                        "l3-vpn",
                        "l2-vpn"
                      ]
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "service_label_index",
                  "address_family",
                  "forwarding_state",
                  "service_label",
                  "service_type"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "responses": {
      "304": {
        "description": "Not Modified"
      },
      "400": {
        "description": "Bad Request"
      },
      "401": {
        "description": "Unauthorized"
      },
      "403": {
        "description": "Forbidden"
      },
      "404": {
        "description": "Not Found"
      },
      "500": {
        "description": "Internal Server Error"
      },
      "501": {
        "description": "Not Implemented"
      },
      "503": {
        "description": "Service Unavailable"
      }
    }
  }
}
