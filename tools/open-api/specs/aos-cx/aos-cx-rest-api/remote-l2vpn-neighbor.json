{
  "openapi": "3.0.0",
  "info": {
    "title": "Remote_L2VPN_Neighbor",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Remote_L2VPN_Neighbor"
    }
  ],
  "paths": {
    "/system/vrfs/{VRF.name}/remote_l2vpn_neighbors": {
      "get": {
        "tags": [
          "Remote_L2VPN_Neighbor"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "address_family": {
                      "type": "string",
                      "description": "Address family corresponding to the neighbor's IP address.",
                      "enum": [
                        "ipv4",
                        "ipv6"
                      ]
                    },
                    "from": {
                      "type": "string",
                      "description": "Reference Resource: [Remote_L2VPN_Neighbor](#/Remote_L2VPN_Neighbor)<br>Source of the Neighbor IP address: `evpn`:     added by EVPN.",
                      "enum": [
                        "evpn_l3"
                      ]
                    },
                    "ip_address": {
                      "type": "string",
                      "description": "Reference Resource: [Remote_L2VPN_Neighbor](#/Remote_L2VPN_Neighbor)<br>IPv4 or IPv6 address of the neighbor.",
                      "maxLength": 45
                    },
                    "mac": {
                      "type": "string",
                      "description": "MAC address of the neighbor.",
                      "maxLength": 17,
                      "minLength": 17
                    },
                    "port": {
                      "type": "string",
                      "description": "Reference Resource: [Remote_L2VPN_Neighbor](#/Remote_L2VPN_Neighbor)<br>Reference to logical L3 VLAN interface associated with neighbor."
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [Remote_L2VPN_Neighbor](#/Remote_L2VPN_Neighbor)<br>Reference to the VRF table associated with the neighbor."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
