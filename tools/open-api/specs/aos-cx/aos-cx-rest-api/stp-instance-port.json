{
  "openapi": "3.0.0",
  "info": {
    "title": "STP_Instance_Port",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "STP_Instance_Port"
    }
  ],
  "paths": {
    "/system/stp_instances/{STP_Instance.instance_type},{STP_Instance.stp_instance_id}/stp_instance_ports": {
      "get": {
        "tags": [
          "STP_Instance_Port"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "admin_path_cost": {
                      "type": "integer",
                      "description": "The cost to reach root port.",
                      "maximum": 200000000,
                      "minimum": 0
                    },
                    "boundary_port": {
                      "type": "boolean",
                      "description": "Set to true when the port receives an MSTP BPDU from other regions."
                    },
                    "designated_bridge": {
                      "type": "string",
                      "description": "The designated bridge for this port."
                    },
                    "designated_bridge_priority": {
                      "type": "integer",
                      "description": "The designated bridge priority at this port.",
                      "maximum": 61440,
                      "minimum": 0
                    },
                    "designated_path_cost": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The path cost for designated bridge.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "designated_port": {
                      "type": "string",
                      "description": "The designated port ID.",
                      "maxLength": 45
                    },
                    "designated_port_priority": {
                      "type": "integer",
                      "description": "The designated port priority for this port.",
                      "maximum": 256,
                      "minimum": 0
                    },
                    "designated_root": {
                      "type": "string",
                      "description": "The root bridge name for an instance."
                    },
                    "designated_root_priority": {
                      "type": "integer",
                      "description": "The priority value for designated port.",
                      "maximum": 61440,
                      "minimum": 0
                    },
                    "mstp_cist_path_cost": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The CIST path cost from the transmitting bridge to the CIST regional root.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "mstp_cist_regional_root_id": {
                      "type": "string",
                      "description": "The regional Root Id for the CIST."
                    },
                    "oper_path_cost": {
                      "type": "integer",
                      "description": "The cost to reach root port. If cost is not configured, value is determined from the interface speed. Bandwidth            Port cost 10 Mbps              2,000,000 100 Mbps             200,000 1 Gigabit Ethernet   20,000 10 Gigabit Ethernet  2,000",
                      "maximum": 200000000,
                      "minimum": 0
                    },
                    "port": {
                      "type": "string",
                      "description": "Reference Resource: [STP_Instance_Port](#/STP_Instance_Port)<br>Specifies the port for the STP instance."
                    },
                    "port_inconsistent": {
                      "type": "object",
                      "description": "This represents information regarding STP instance port level inconsistency.",
                      "properties": {
                        "bpdu_guard": {
                          "type": "boolean",
                          "description": "Indicates whether BPDU guard finds the port inconsistent."
                        },
                        "loop_guard": {
                          "type": "boolean",
                          "description": "Indicates whether LOOP guard finds the port inconsistent."
                        },
                        "pvid_mismatch": {
                          "type": "boolean",
                          "description": "Indicates whether PVID-mismatch check finds the port inconsistent."
                        },
                        "root_guard": {
                          "type": "boolean",
                          "description": "Indicates whether ROOT guard finds the port inconsistent."
                        },
                        "rpvst_guard": {
                          "type": "boolean",
                          "description": "Indicates whether RPVST guard finds the port inconsistent."
                        }
                      }
                    },
                    "port_priority": {
                      "type": "integer",
                      "description": "The priority value used along with the switch MAC address to determine which device is root. Configured as a multiple of 16. The lower a priority value, the higher the priority. For LAGs, the default is 4. For other interfaces the default is 8",
                      "maximum": 15,
                      "minimum": 0
                    },
                    "port_role": {
                      "type": "string",
                      "description": "The role of the port in the active Spanning tree topology. The possible port roles and their definitons are: 'Root' port provides the best path (lowest cost) when the switch forwards packets to the root bridge. 'Designated' port connects to the designated switch, which incurs the lowest path cost when  forwarding packets from that LAN to the root bridge. The port through which the designated switch  is attached to the LAN is called the designated port. 'Alternate' port offers an alternate path towards the root bridge to the one provided by the current root port. 'Backup' port acts as a backup for the path provided by a designated port towards the leaves of the  spanning tree. 'Conductor' (MSTP only) port provides the best possible path to reach the common internal spanning-tree (CIST) root  bridge from any MSTP region. 'Disabled' port has no role within the operation of the spanning tree.",
                      "enum": [
                        "Root",
                        "Designated",
                        "Alternate",
                        "Backup",
                        "Conductor",
                        "Disabled"
                      ]
                    },
                    "port_state": {
                      "type": "string",
                      "description": "The state of the port in the active topology. The possible port states and their definitons are: 'Blocking' means the Layer 2 LAN port does not participate in frame forwarding. 'Learning' means the Layer 2 LAN port prepares to participate in frame forwarding. 'Forwarding' means the Layer 2 LAN port forwards frames. 'Disabled' means the Layer 2 LAN port does not participate in STP and is not forwarding frames.",
                      "enum": [
                        "Blocking",
                        "Learning",
                        "Forwarding",
                        "Disabled"
                      ]
                    },
                    "reset_at": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Epoch time of the last port reset."
                    },
                    "statistics": {
                      "type": "object",
                      "properties": {
                        "BPDUs_Rx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "The received MSTP BPDU count."
                        },
                        "BPDUs_Tx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "The transmitted MSTP BPDU count."
                        },
                        "TCN_Rx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of Topology Change Notification PDUs received by this port on this instance."
                        },
                        "TCN_Tx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of Topology Change Notification PDUs that have been transmitted out of this port on this instance."
                        },
                        "forward_transition_count": {
                          "type": "integer",
                          "description": "The number of times this port has transitioned to the forwarding state.",
                          "maximum": 2147483647,
                          "minimum": 0
                        }
                      }
                    },
                    "stp_instance": {
                      "type": "string",
                      "description": "Reference Resource: [STP_Instance_Port](#/STP_Instance_Port)<br>Specifies the set of STP instances."
                    },
                    "vsx_peer_info": {
                      "type": "object",
                      "description": "Specifies the VSX peer device's information for this STP  instance port. For the documentation of each key, please refer to the corresponding STP Instance Port attribute.",
                      "properties": {
                        "designated_bridge": {
                          "type": "string",
                          "maxLength": 45
                        },
                        "designated_bridge_priority": {
                          "type": "integer",
                          "maximum": 61440,
                          "minimum": 0
                        },
                        "designated_path_cost": {
                          "type": "integer",
                          "format": "int64",
                          "maximum": 4294967295,
                          "minimum": 0
                        },
                        "designated_port": {
                          "type": "string",
                          "maxLength": 45
                        },
                        "designated_port_priority": {
                          "type": "integer",
                          "maximum": 256,
                          "minimum": 0
                        },
                        "designated_root": {
                          "type": "string",
                          "maxLength": 45
                        },
                        "designated_root_priority": {
                          "type": "integer",
                          "maximum": 61440,
                          "minimum": 0
                        },
                        "mstp_cist_path_cost": {
                          "type": "integer",
                          "format": "int64",
                          "maximum": 4294967295,
                          "minimum": 0
                        },
                        "mstp_cist_regional_root_id": {
                          "type": "string",
                          "maxLength": 45
                        },
                        "oper_path_cost": {
                          "type": "integer",
                          "maximum": 200000000,
                          "minimum": 0
                        },
                        "port_inconsistent_bpdu_guard": {
                          "type": "boolean"
                        },
                        "port_inconsistent_loop_guard": {
                          "type": "boolean"
                        },
                        "port_inconsistent_pvid_mismatch": {
                          "type": "boolean"
                        },
                        "port_inconsistent_root_guard": {
                          "type": "boolean"
                        },
                        "port_inconsistent_rpvst_guard": {
                          "type": "boolean"
                        },
                        "port_role": {
                          "type": "string",
                          "enum": [
                            "Root",
                            "Designated",
                            "Alternate",
                            "Backup",
                            "Conductor",
                            "Disabled"
                          ]
                        },
                        "port_state": {
                          "type": "string",
                          "enum": [
                            "Blocking",
                            "Learning",
                            "Forwarding",
                            "Disabled"
                          ]
                        }
                      }
                    }
                  },
                  "type": "object"
                }
              }
