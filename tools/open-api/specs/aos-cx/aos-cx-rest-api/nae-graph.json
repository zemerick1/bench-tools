                      "description": "Custom title to be used for a specific NAE Graph. Here are some examples for NAE Graph custom title: Averaged CPU utilization. Averaged CPU utilization for CPU {}. Every {} would be substituted by the value from  title_arguments."
                    },
                    "title_arguments": {
                      "type": "object",
                      "description": "Reference Resource: [NAE_Parameter](#/NAE_Parameter)<br>References to the NAE Parameters used as arguments in the custom title for a specific NAE Graph. The map key contains a position on the custon title and the map value contains the parameter name of the argument in that position.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of NAE_Parameter"
                        }
                      }
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "NAE_Script.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Script](#/NAE_Script)<br>Name of a NAE Script. This has to be a valid canonical name (CNAME) (i.e com.arubanetworks.bgp_monitor).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "NAE_Agent.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Agent](#/NAE_Agent)<br>Name of a NAE Agent. This has to be a CNAME starting with NAE Script name followed by its own name (i.e com.arubanetworks.bgp_monitor.agent1).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "NAE_Graph.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Graph](#/NAE_Graph)<br>Graphs related to the NAE Agent.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
