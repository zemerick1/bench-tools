{
  "openapi": "3.0.0",
  "info": {
    "title": "NAE_Graph",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "NAE_Graph"
    }
  ],
  "paths": {
    "/system/nae_scripts/{NAE_Script.name}/nae_agents/{NAE_Agent.name}/nae_graphs": {
      "get": {
        "tags": [
          "NAE_Graph"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "dashboard_display": {
                      "type": "boolean",
                      "description": "Indicates whether the graph is to be displayed in dashboard  view of the Web UI."
                    },
                    "nae_monitors": {
                      "type": "array",
                      "description": "Reference Resource: [NAE_Monitor](#/NAE_Monitor)<br>References the NAE Monitors related to the graph.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000,
                      "minItems": 1
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [NAE_Graph](#/NAE_Graph)<br>Graphs related to the NAE Agent."
                    },
                    "title": {
                      "type": "string",
                      "description": "Custom title to be used for a specific NAE Graph. Here are some examples for NAE Graph custom title: Averaged CPU utilization. Averaged CPU utilization for CPU {}. Every {} would be substituted by the value from  title_arguments."
                    },
                    "title_arguments": {
                      "type": "object",
                      "description": "Reference Resource: [NAE_Parameter](#/NAE_Parameter)<br>References to the NAE Parameters used as arguments in the custom title for a specific NAE Graph. The map key contains a position on the custon title and the map value contains the parameter name of the argument in that position.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of NAE_Parameter"
                        }
                      }
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "NAE_Script.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Script](#/NAE_Script)<br>Name of a NAE Script. This has to be a valid canonical name (CNAME) (i.e com.arubanetworks.bgp_monitor).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "NAE_Agent.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Agent](#/NAE_Agent)<br>Name of a NAE Agent. This has to be a CNAME starting with NAE Script name followed by its own name (i.e com.arubanetworks.bgp_monitor.agent1).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "title",
                  "title_arguments",
                  "nae_monitors",
                  "dashboard_display"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/system/nae_scripts/{NAE_Script.name}/nae_agents/{NAE_Agent.name}/nae_graphs/{NAE_Graph.name}": {
