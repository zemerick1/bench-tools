          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "l2_composite_group_type",
                  "hw_config",
                  "applied_hw_config",
                  "active_tunnel_endpoints",
                  "state"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
