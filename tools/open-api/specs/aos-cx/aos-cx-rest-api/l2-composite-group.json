{
  "openapi": "3.0.0",
  "info": {
    "title": "L2_Composite_Group",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "L2_Composite_Group"
    }
  ],
  "paths": {
    "/system/l2_composite_groups": {
      "get": {
        "tags": [
          "L2_Composite_Group"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "active_tunnel_endpoints": {
                      "type": "array",
                      "description": "Reference Resource: [Tunnel_Endpoint](#/Tunnel_Endpoint)<br>The list of tunnel_endpoints which will be used in this Composite Group.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000
                    },
                    "applied_hw_config": {
                      "type": "object",
                      "description": "The hardware value assigned by the platform to a group indicated by type",
                      "properties": {
                        "port_id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Port value assigned to group of type 'port' by the platform"
                        },
                        "tunnel_group_id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Hardware value assigned to group of type 'vxlan_tunnel_ecmp' by the platform"
                        },
                        "tunnel_id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Hardware value assigned to group of type 'vxlan_tunnel_single' by the platform"
                        }
                      }
                    },
                    "hw_config": {
                      "type": "object",
                      "description": "The abstracted value used in the group indicated by a type",
                      "properties": {
                        "port_id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Port value assigned to group of type 'port'"
                        },
                        "tunnel_group_id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Abstracted value which is generated to identify group of type 'vxlan_tunnel_ecmp'"
                        },
                        "tunnel_id": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Hardware value which is assigned to identify group of type 'vxlan_tunnel_single'"
                        }
                      }
                    },
                    "id": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Reference Resource: [L2_Composite_Group](#/L2_Composite_Group)<br>Abstracted value which is generated to identify each of the  Composite Groups.",
                      "maximum": 4294967295,
                      "minimum": 1
                    },
                    "l2_composite_group_type": {
                      "type": "string",
                      "description": "Indicates the type of l2 Composite Group: `port`:  Used to configure MACs over ports `vxlan_tunnel_ecmp`:  Used to configure remote MACs over multiple vxlan tunnels `vxlan_tunnel_single`:  Used to configure remote MACs over single vxlan tunnel",
                      "enum": [
                        "port",
                        "vxlan_tunnel_ecmp",
                        "vxlan_tunnel_single"
                      ]
                    },
                    "state": {
                      "type": "string",
                      "description": "State of this Composite Group. 'operational':     Hardware value fully provisioned in the forwarding path 'no_hw_resources': Hardware value provisioning failed due to insufficient resources 'not_configured':  Hardware value not configured in hardware",
                      "enum": [
                        "operational",
                        "no_hw_resources",
                        "not_configured"
                      ]
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
