    "title": "Container_Mount",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Container_Mount"
    }
  ],
  "paths": {
    "/system/containers/{Container.name}/container_mounts": {
      "get": {
        "tags": [
          "Container_Mount"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "container": {
                      "type": "string",
                      "description": "Reference Resource: [Container_Mount](#/Container_Mount)<br>Container to which this mount belongs."
                    },
                    "destination_path": {
                      "type": "string",
                      "description": "Mount target path in container. This is an absolute path in the container filesystem. Example: \"/myapp/mount1\" will be a path in the container filesystem."
                    },
                    "id": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Reference Resource: [Container_Mount](#/Container_Mount)<br>Unique identifier of the mount.",
                      "maximum": 4294967295,
                      "minimum": 1
                    },
                    "source_path": {
                      "type": "string",
                      "description": "Mount source path in host, relative to the source type. Example: \"/app1/dir1\" source path with \"usb\" source type maps to \"usb:/app1/dir1\"."
                    },
                    "source_type": {
                      "type": "string",
                      "description": "Specifies the mount source type. Currently, only the \"usb\" source type is supported.",
                      "enum": [
                        "usb"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "container"
                  ],
                  "type": "object"
                }
              }
            }
