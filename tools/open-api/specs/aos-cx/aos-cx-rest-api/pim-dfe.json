{
  "openapi": "3.0.0",
  "info": {
    "title": "PIM_DFE",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "PIM_DFE"
    }
  ],
  "paths": {
    "/system/pim_dves": {
      "get": {
        "tags": [
          "PIM_DFE"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "address_family": {
                      "type": "string",
                      "description": "IP version of the RP-address.",
                      "enum": [
                        "ipv4",
                        "ipv6"
                      ]
                    },
                    "df_winner": {
                      "type": "string",
                      "description": "The IP address of PIM DF Election winner.",
                      "maxLength": 45
                    },
                    "metric": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Unicast routing metric to reach the RP Address."
                    },
                    "port": {
                      "type": "string",
                      "description": "Reference Resource: [PIM_DFE](#/PIM_DFE)<br>The [Port](#/Port) on which PIM DF Election happened."
                    },
                    "rp_address": {
                      "type": "string",
                      "description": "Reference Resource: [PIM_DFE](#/PIM_DFE)<br>RP-address for which PIM DF Election happened.",
                      "maxLength": 45
                    },
                    "winner_timestamp": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The epoch time at which the DF Election winner was created for the Port, RP-address pair."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "winner_timestamp",
                  "port",
                  "rp_address",
                  "df_winner",
                  "address_family",
                  "metric"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
