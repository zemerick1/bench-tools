          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "key_id": {
                      "type": "integer",
                      "description": "Reference Resource: [NTP_Key](#/NTP_Key)<br>Specifies a key_id which is used for NTP authentication. If this is not set, NTP will not use authenticate for the configured NTP server.",
                      "maximum": 65534,
                      "minimum": 1
                    },
                    "key_password": {
                      "type": "string",
                      "description": "Specifies an encrypted key_password which is used for NTP authentication.",
                      "maxLength": 128,
                      "minLength": 8
                    },
                    "key_type": {
                      "type": "string",
                      "description": "Specifies an encrypted key_type which is used for NTP authentication.",
                      "enum": [
                        "md5",
                        "sha1"
                      ]
                    },
                    "trust_enable": {
                      "type": "boolean",
                      "description": "Enables trust settings for this key_id.."
                    }
                  },
                  "required": [
                    "key_id",
                    "key_password",
                    "trust_enable"
