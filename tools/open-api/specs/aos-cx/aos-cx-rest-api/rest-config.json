{
  "openapi": "3.0.0",
  "info": {
    "title": "REST_Config",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "REST_Config"
    }
  ],
  "paths": {
    "/system/rest_config": {
      "get": {
        "tags": [
          "REST_Config"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "": {
                      "type": "string",
                      "description": "Reference Resource: [REST_Config](#/REST_Config)<br>REST configuration and status."
                    },
                    "certificate_authentication": {
                      "type": "object",
                      "description": "Indicates the certificate authentication mode configuration.",
                      "properties": {
                        "authorization": {
                          "type": "string",
                          "description": "Indicates the authorization mode to perform authorize-only.",
                          "enum": [
                            "radius"
                          ]
                        },
                        "enabled": {
                          "type": "boolean",
                          "description": "Indicates whether the user has explicitly enabled the certificate authentication mode. It is disabled by default."
                        },
                        "username": {
                          "type": "string",
                          "description": "Indicates the field in the certificate to be used as username. The options available correspond to the Common Name and Subject Alternative Name User Principal Name. Subject Alternative Name User Principal Name corresponds to the default option.",
                          "enum": [
                            "common_name",
                            "user_principal_name"
                          ]
                        }
                      }
                    },
                    "certificate_authentication_status": {
                      "type": "object",
                      "description": "Indicates the current status of the certificate authentication mode.",
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "This value will contain an error message in case certificate authentication mode could not be enabled."
                        },
                        "status": {
                          "type": "string",
                          "description": "Indicates the certificate authentication mode status.",
                          "enum": [
                            "enabled",
                            "disabled"
                          ]
                        }
                      }
                    },
                    "password_authentication": {
                      "type": "boolean",
                      "description": "Indicates whether the user has explicitly enabled the password authentication mode. It is enabled by default."
                    },
                    "password_authentication_status": {
                      "type": "object",
                      "description": "Indicates the current status of the password authentication mode.",
                      "properties": {
                        "error": {
                          "type": "string",
                          "description": "This value will contain an error message in case password authentication mode could not be enabled."
                        },
                        "status": {
                          "type": "string",
                          "description": "Indicates the password authentication mode status.",
                          "enum": [
                            "enabled",
                            "disabled"
                          ]
                        }
                      }
                    },
                    "swagger_documentation": {
                      "type": "boolean",
                      "description": "Indicates whether the latest Swagger UI page should be enabled, false by default."
                    },
                    "swagger_documentation_status": {
                      "type": "object",
                      "description": "Indicates the current status of the Swagger UI page.",
                      "properties": {
                        "error_message": {
                          "type": "string",
                          "description": "This indicates the error message when the Swagger UI page generation process failed"
                        },
                        "status": {
                          "type": "string",
                          "description": "Indicates the latest Swagger UI page status: disabled: feature is disabled. enabling: feature is being enabled but not yet ready to be used. enabled: feature is enabled and ready to be used. error: an error occurred while enabling the feature. Check the \"error_message\"        key to read the error message",
                          "enum": [
                            "disabled",
                            "enabling",
                            "enabled",
                            "error"
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    ""
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "swagger_documentation",
                  "swagger_documentation_status",
                  "password_authentication",
                  "password_authentication_status",
                  "certificate_authentication",
                  "certificate_authentication_status"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "put": {
        "tags": [
          "REST_Config"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "certificate_authentication": {
                    "type": "object",
                    "description": "Indicates the certificate authentication mode configuration.",
                    "properties": {
                      "authorization": {
                        "type": "string",
                        "description": "Indicates the authorization mode to perform authorize-only.",
                        "enum": [
                          "radius"
                        ]
                      },
                      "enabled": {
                        "type": "boolean",
                        "description": "Indicates whether the user has explicitly enabled the certificate authentication mode. It is disabled by default."
                      },
                      "username": {
                        "type": "string",
                        "description": "Indicates the field in the certificate to be used as username. The options available correspond to the Common Name and Subject Alternative Name User Principal Name. Subject Alternative Name User Principal Name corresponds to the default option.",
                        "enum": [
                          "common_name",
                          "user_principal_name"
                        ]
                      }
                    }
                  },
                  "password_authentication": {
                    "type": "boolean",
                    "description": "Indicates whether the user has explicitly enabled the password authentication mode. It is enabled by default."
                  },
                  "swagger_documentation": {
                    "type": "boolean",
                    "description": "Indicates whether the latest Swagger UI page should be enabled, false by default."
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "patch": {
        "tags": [
          "REST_Config"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "certificate_authentication": {
                    "type": "object",
                    "description": "Indicates the certificate authentication mode configuration.",
                    "properties": {
                      "authorization": {
                        "type": "string",
                        "description": "Indicates the authorization mode to perform authorize-only.",
                        "enum": [
                          "radius"
                        ]
                      },
                      "enabled": {
                        "type": "boolean",
                        "description": "Indicates whether the user has explicitly enabled the certificate authentication mode. It is disabled by default."
                      },
                      "username": {
                        "type": "string",
                        "description": "Indicates the field in the certificate to be used as username. The options available correspond to the Common Name and Subject Alternative Name User Principal Name. Subject Alternative Name User Principal Name corresponds to the default option.",
                        "enum": [
                          "common_name",
                          "user_principal_name"
                        ]
                      }
                    }
                  },
                  "password_authentication": {
                    "type": "boolean",
                    "description": "Indicates whether the user has explicitly enabled the password authentication mode. It is enabled by default."
                  },
                  "swagger_documentation": {
                    "type": "boolean",
                    "description": "Indicates whether the latest Swagger UI page should be enabled, false by default."
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
