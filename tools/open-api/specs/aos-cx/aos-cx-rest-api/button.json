{
  "openapi": "3.0.0",
  "info": {
    "title": "Button",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Button"
    }
  ],
  "paths": {
    "/system/subsystems/{Subsystem.type},{Subsystem.name}/buttons": {
      "get": {
        "tags": [
          "Button"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Button](#/Button)<br>Keeps track of all buttons in a certain subsystem."
                    },
                    "state": {
                      "type": "object",
                      "properties": {
                        "led_mode": {
                          "type": "string",
                          "description": "State of the led_mode type of button. act: Activity of each port. spd: Speed, shows if port is using max speed or less. stk: Stack, shows the member number of each switch. poe: Power over Ethernet, shows if a port is powering a device. usr: User, will only light up ports that are down.",
                          "enum": [
                            "act",
                            "spd",
                            "stk",
                            "poe",
                            "usr"
                          ]
                        }
                      }
                    },
                    "type": {
                      "type": "string",
                      "description": "The type of button. led_mode: Alters the LEDs to show useful information."
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "Subsystem.type",
            "in": "path",
            "description": "Reference Resource: [Subsystem](#/Subsystem)<br>",
            "schema": {
              "type": "string",
              "enum": [
                "uninitialized",
                "system",
                "chassis",
                "line_card",
                "mezz_card",
                "fabric_card",
                "management_module",
                "rear_display_card",
                "fan_tray",
                "services_card",
                "io_module"
              ]
            },
            "required": true
          },
          {
            "name": "Subsystem.name",
            "in": "path",
            "description": "Reference Resource: [Subsystem](#/Subsystem)<br>",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "state",
                  "type"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/system/subsystems/{Subsystem.type},{Subsystem.name}/buttons/{Button.name}": {
