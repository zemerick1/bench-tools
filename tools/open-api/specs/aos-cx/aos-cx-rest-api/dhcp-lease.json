{
  "openapi": "3.0.0",
  "info": {
    "title": "DHCP_Lease",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "DHCP_Lease"
    }
  ],
  "paths": {
    "/system/vrfs/{VRF.name}/dhcp_leases": {
      "get": {
        "tags": [
          "DHCP_Lease"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "address_family": {
                      "type": "string",
                      "description": "Address family of the lease entry.",
                      "enum": [
                        "ipv4",
                        "ipv6"
                      ]
                    },
                    "client_hostname": {
                      "type": "string",
                      "description": "Specifies the hostname of the DHCP client to which IP address is assigned by the DHCP server."
                    },
                    "client_id": {
                      "type": "string",
                      "description": "Specifies the client id of the DHCP client to which IP address is assigned by the DHCP server."
                    },
                    "expiry_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time (in seconds from Epoch) when lease will expire."
                    },
                    "ip_address": {
                      "type": "string",
                      "description": "Reference Resource: [DHCP_Lease](#/DHCP_Lease)<br>Specifies the IPv4/IPv6 address that got assigned to the DHCP client. Example IPv4 address: 192.168.10.27.",
                      "maxLength": 45
                    },
                    "link_address": {
                      "type": "string",
                      "description": "In case of IPv4 leases, specifies the Ethernet MAC address of the DHCP client to which IP address is assigned by the DHCP server. Example: e6:8c:98:bb:b4:de. In case of IPv6 leases, specifies the DHCP Unique Identifier (DUID) used by the DHCP client to get an IP address from a DHCPv6 server. Example: 00:01:00:01:1e:99:8b:b6:00:00:02:b5:78:f4",
                      "maxLength": 59,
                      "minLength": 17
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [DHCP_Lease](#/DHCP_Lease)<br>VRF through which DHCP server offered the lease."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "VRF.name",
            "in": "path",
            "description": "Reference Resource: [VRF](#/VRF)<br>VRF identifier. Should be alphanumeric. VRF names must be unique.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ip_address",
                  "client_hostname",
                  "client_id",
                  "address_family",
                  "expiry_time",
                  "link_address"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
