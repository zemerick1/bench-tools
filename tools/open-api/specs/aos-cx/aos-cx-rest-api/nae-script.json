{
  "openapi": "3.0.0",
  "info": {
    "title": "NAE_Script",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "NAE_Script"
    }
  ],
  "paths": {
    "/system/nae_scripts": {
      "get": {
        "tags": [
          "NAE_Script"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "aoscx_platform_list": {
                      "type": "array",
                      "description": "The list of AOS-CX platforms on which the NAE Script can be executed.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 16
                    },
                    "aoscx_version_max": {
                      "type": "string",
                      "description": "The maximum AOS-CX version on which the NAE Script can be executed."
                    },
                    "aoscx_version_min": {
                      "type": "string",
                      "description": "The minimum AOS-CX version on which the NAE Script can be executed."
                    },
                    "author": {
                      "type": "string",
                      "description": "NAE Script author name"
                    },
                    "description": {
                      "type": "string",
                      "description": "NAE Script long description"
                    },
                    "expert_only": {
                      "type": "boolean",
                      "description": "Indicates whether the script requires expert level knowledge to deal with or not."
                    },
                    "nae_agents": {},
                    "nae_parameters": {
                      "type": "object",
                      "description": "Reference Resource: [NAE_Parameter](#/NAE_Parameter)<br>Parameters of the nae, available to the script if present.",
                      "properties": {
                        "string": {
                          "type": "string",
                          "description": "Reference resource URI of NAE_Parameter"
                        }
                      }
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [NAE_Script](#/NAE_Script)<br>Name of a NAE Script. This has to be a valid canonical name (CNAME) (i.e com.arubanetworks.bgp_monitor).",
                      "maxLength": 80,
                      "minLength": 3
                    },
                    "origin": {
                      "type": "string",
                      "description": "Defines the origin of the script. Set to `system` if the script is inbuilt in the system. Set to `generated` if the script is generated using user input. Set to `user` if the script is uploaded by the user.",
                      "enum": [
                        "generated",
                        "system",
                        "user"
                      ]
                    },
                    "required_nae_api_version": {
                      "type": "string",
                      "description": "The version of NAE Script APIs required to run the NAE Script."
                    },
                    "script": {
                      "type": "string",
                      "description": "NAE Script content in Base64. The max length represents a 256KB script.",
                      "maxLength": 342000
                    },
                    "status": {
                      "type": "object",
                      "properties": {
                        "error_at": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Timestamp, in epoch, of the last error.",
                          "minimum": 0
                        },
                        "error_description": {
                          "type": "string",
                          "description": "Provides a more detailed description of the error during that last execution."
                        },
                        "script_checksum": {
                          "type": "string",
                          "description": "SHA-1 hash of the raw(unencoded) script after its  validation."
                        },
                        "state": {
                          "type": "string",
                          "description": "Last state of the Script: * `CREATED`: Script got uploaded, but the script      validation is still pending. * `ERROR`: Any issue found during script or policy      execution will lead to the ERROR state, invalidating      the script and all its policy agents. * `VALIDATING`: Script got scheduled for validation, where      syntax and all its internal components (manifest,       parameters, monitor, condition and actions) will be      checked. * `VALIDATED`: Script syntax and internal components     checks done and no issues found.",
                          "enum": [
                            "CREATED",
                            "ERROR",
                            "VALIDATING",
                            "VALIDATED"
                          ]
                        }
                      }
                    },
                    "tags": {
                      "type": "array",
                      "description": "The list of tags assigned to the NAE Script",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 16
                    },
                    "target_platform": {
                      "type": "string",
                      "description": "The target platform on which the NAE Script is designed to be executed."
                    },
                    "target_software_version": {
                      "type": "string",
                      "description": "The target software version on which the NAE Script is designed to be executed."
                    },
                    "version": {
                      "type": "string",
                      "description": "NAE Script version"
                    }
                  },
                  "required": [
                    "name",
                    "script"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
