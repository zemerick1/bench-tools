                    },
                    "in_progress_version": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The version of the 'in_progress' Policy.  This value is copied from 'cfg_version' when the Policy processing begins. This value is cleared when the Policy status is updated to 'applied' or 'rejected.'",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991
                    },
                    "in_statistics": {
                      "type": "object",
                      "description": "Count of packets that matched ingress port-access group based policy specific 'count' entries. This is an aggregated statistics across all clients  of a role that have a group based policy or statistics of a multidest policy.",
