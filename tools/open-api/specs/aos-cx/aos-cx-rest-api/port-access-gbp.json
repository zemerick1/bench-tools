                      "description": "Controls which attributes should be synchronized between VSX peers. 'all_attributes_and_dependents': the entire Port Access GBP, including its entry, should be synchronized.",
                      "items": {
                        "type": "string",
                        "enum": [
                          "all_attributes_and_dependents"
                        ]
