                      "description": "Reference Resource: [Port_Access_GBP](#/Port_Access_GBP)<br>Port Access Group Based Policy name.",
                      "maxLength": 128
                    },
                    "origin": {
                      "type": "string",
                      "description": "Origin of the policy, i.e., how the policy is provisioned. `local`:       policy is provisioned locally on the device. `synthesized`: policy has been dynamically synthesized                by the system.",
                      "enum": [
                        "local",
                        "synthesized"
                      ]
                    },
                    "status": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Numeric error code.  Expected to be 0 when state is 'applied'."
                        },
                        "message": {
                          "type": "string",
                          "description": "Detailed reason for error state.  Expected empty when state is 'applied' or 'verified'."
