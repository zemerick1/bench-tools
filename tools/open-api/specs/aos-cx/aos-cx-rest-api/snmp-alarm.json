        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "SNMP_oid": {
                      "type": "string",
                      "description": "The object identifier to be monitored. Only variables that resolve to an ASN.1 primitive type of INTEGER (INTEGER, Integer32,Counter32, Counter64, Gauge32, or TimeTicks) will be monitored.",
                      "maxLength": 128,
                      "minLength": 1
                    },
                    "absolute_value": {
                      "type": "integer",
                      "description": "The value of the variable at the end of the sampling period.",
                      "maximum": 2147483647,
                      "minimum": -2147483648
                    },
                    "delta_value": {
                      "type": "integer",
                      "description": "The delta of the variable between the beginning and the end of the sampling period. Applicable only for the sample type 'delta'.",
                      "maximum": 2147483647,
                      "minimum": -2147483648
                    },
                    "disable": {
                      "type": "boolean",
                      "description": "Disables RMON alarms."
                    },
                    "falling_threshold": {
                      "type": "integer",
                      "description": "Falling threshold to be compared against the current value to trigger the SNMP alarm.",
                      "maximum": 2147483647,
                      "minimum": -2147483648
                    },
                    "index": {
                      "type": "integer",
                      "description": "Reference Resource: [SNMP_Alarm](#/SNMP_Alarm)<br>An index that uniquely identifies the SNMP alarm.",
                      "maximum": 65535,
                      "minimum": 1
                    },
                    "interval": {
                      "type": "integer",
                      "description": "The interval in seconds, over which the SNMP_oid is sampled and compared with the rising and falling thresholds.",
                      "maximum": 65535,
                      "minimum": 5
                    },
                    "last_update_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time (in seconds from epoch) when the last sample was processed."
                    },
                    "rising_threshold": {
                      "type": "integer",
                      "description": "Rising threshold to be compared against the current value to trigger the SNMP alarm.",
                      "maximum": 2147483647,
                      "minimum": -2147483648
                    },
                    "sample_type": {
                      "type": "string",
                      "description": "The method of sampling of the variable. 'absolute': Absolute value of the variable will be compared             with the thresholds. 'delta':    The difference between the current and previous             sample of the variable will be compared with the thresholds.",
                      "enum": [
                        "absolute",
                        "delta"
                      ]
                    },
                    "state": {
                      "type": "string",
                      "description": "Current state of the alarm: 'rising':  Value has once crossed the rising threshold and            is still above the falling threshold. 'falling': Value has once crossed the falling threshold and            is still below the rising threshold. 'off':     Value neither crossed the falling nor the rising threshold.",
                      "enum": [
                        "rising",
                        "falling",
                        "off"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "description": "The status of this alarm entry 'valid':          SNMP_oid is valid. 'invalid':        SNMP_oid is invalid. 'under_creation': Initial state when configuring alarm entry.",
                      "enum": [
                        "valid",
                        "invalid",
                        "under_creation"
                      ]
                    }
                  },
                  "required": [
                    "falling_threshold",
                    "index",
                    "SNMP_oid",
                    "rising_threshold"
                  ],
                  "type": "object"
                }
              }
            }
          },
