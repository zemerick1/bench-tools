{
  "openapi": "3.0.0",
  "info": {
    "title": "RADIUS_Config_Attribute",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "RADIUS_Config_Attribute"
    }
  ],
  "paths": {
    "/system/radius_config_attributes": {
      "get": {
        "tags": [
          "RADIUS_Config_Attribute"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "framed_ip_addr": {
                      "type": "object",
                      "description": "The Framed-IP-Address attribute sent in  RADIUS packets indicates the address configured for the user. The value of this attribute is taken from the IP binding table or Client IP Tracker table (In the same order). Both request type and service type should be configured to include this attribute in RADIUS packets.",
                      "properties": {
                        "request_type": {
                          "type": "string",
                          "description": "The request-type for which Framed-IP-Address (RADIUS attribute type 8) will be included.",
                          "enum": [
                            "authentication"
                          ]
                        },
                        "service_type": {
                          "type": "string",
                          "description": "The service-type for which Framed-IP-Address attribute 8 will be included in RADIUS access request.",
                          "enum": [
                            "port-access"
                          ]
                        }
                      }
                    },
                    "nas_id": {
                      "type": "object",
                      "properties": {
                        "request_type": {
                          "type": "string",
                          "description": "The request-type for which NAS-Id attribute will be included.",
                          "enum": [
                            "authentication",
                            "accounting",
                            "both"
                          ]
                        },
                        "service_type": {
                          "type": "string",
                          "description": "The service-type for which NAS-Id attribute will be included.",
                          "enum": [
                            "port-access"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "description": "The unique string to identify the Network Access Switch. This will be included in the RADIUS request packet as part of NAS-Id attribute.",
                          "maxLength": 253,
                          "minLength": 1
                        }
                      }
                    },
                    "nas_ip_addr": {
                      "type": "object",
                      "description": "NAS-IP address will be Source IP of the switch. If Source IP is not configured, Outgoing interface IP will be sent as NAS-IP. Both request-type and service-type should be set to include the NAS-IP-Address attribute in User Management RADIUS access request packet.",
                      "properties": {
                        "request_type": {
                          "type": "string",
                          "description": "The request-type for which NAS-IP address attribute will be included.",
                          "enum": [
                            "authentication",
                            "accounting",
                            "both"
                          ]
                        },
                        "service_type": {
                          "type": "string",
                          "description": "The service-type for which NAS-IP address attribute will be included in RADIUS access request.",
                          "enum": [
                            "user-management"
                          ]
                        }
                      }
                    },
                    "server_group": {
                      "type": "string",
                      "description": "Reference Resource: [RADIUS_Config_Attribute](#/RADIUS_Config_Attribute)<br>Specifies the RADIUS server-groups for which configured attributes will be included while sending access-request packets."
                    },
                    "tunnel_private_group_id": {
                      "type": "object",
                      "properties": {
                        "request_type": {
                          "type": "string",
                          "description": "The request-type for which tunnel-private-group-id attribute will be included.",
                          "enum": [
                            "authentication",
                            "accounting",
                            "both"
                          ]
                        },
                        "service_type": {
                          "type": "string",
                          "description": "The service-type for which tunnel-private-group-id attribute will be included.",
                          "enum": [
                            "port-access"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "description": "Value of string that will be included in the RADIUS request packet for tunnel-private-group-id attribute.",
                          "enum": [
                            "static",
                            "dynamic"
                          ]
                        }
                      }
                    }
                  },
                  "required": [
                    "server_group"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
