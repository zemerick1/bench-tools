{
  "openapi": "3.0.0",
  "info": {
    "title": "NAE_Rule",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "NAE_Rule"
    }
  ],
  "paths": {
    "/system/nae_scripts/{NAE_Script.name}/nae_agents/{NAE_Agent.name}/nae_rules": {
      "get": {
        "tags": [
          "NAE_Rule"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "active_condition_triggered": {
                      "type": "boolean",
                      "description": "Set to `true` if the active-condition has been triggered. In a rule if a clear-condition is defined, an active-condition once triggered will be suspended until the corresponding clear-condition has been triggered."
                    },
                    "description": {
                      "type": "string",
                      "description": "NAE Rule description",
                      "maxLength": 256
                    },
                    "description_arguments": {
                      "type": "object",
                      "description": "Reference Resource: [NAE_Parameter](#/NAE_Parameter)<br>References to the Monitoring Parameters used on a description. The map key contains a postion in the description the map value contains the parameter in that position.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of NAE_Parameter"
                        }
                      }
                    },
                    "nae_conditions": {
                      "type": "object",
                      "description": "Reference Resource: [NAE_Condition](#/NAE_Condition)<br>Conditions associated with the rule CONDITION : Condition associated with the rule CLEAR_CONDITION : Optional clear condition associated with the rule",
                      "properties": {
                        "string": {
                          "type": "string",
                          "description": "Reference resource URI of NAE_Condition"
                        }
                      }
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [NAE_Rule](#/NAE_Rule)<br>Rules created by the particular NAE Agent."
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "NAE_Script.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Script](#/NAE_Script)<br>Name of a NAE Script. This has to be a valid canonical name (CNAME) (i.e com.arubanetworks.bgp_monitor).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "NAE_Agent.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Agent](#/NAE_Agent)<br>Name of a NAE Agent. This has to be a CNAME starting with NAE Script name followed by its own name (i.e com.arubanetworks.bgp_monitor.agent1).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "description",
                  "description_arguments",
                  "nae_conditions",
                  "active_condition_triggered"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/system/nae_scripts/{NAE_Script.name}/nae_agents/{NAE_Agent.name}/nae_rules/{NAE_Rule.name}": {
