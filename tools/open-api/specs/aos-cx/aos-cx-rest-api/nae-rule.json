                      "description": "Reference Resource: [NAE_Condition](#/NAE_Condition)<br>Conditions associated with the rule CONDITION : Condition associated with the rule CLEAR_CONDITION : Optional clear condition associated with the rule",
                      "properties": {
                        "string": {
                          "type": "string",
                          "description": "Reference resource URI of NAE_Condition"
                        }
                      }
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [NAE_Rule](#/NAE_Rule)<br>Rules created by the particular NAE Agent."
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
