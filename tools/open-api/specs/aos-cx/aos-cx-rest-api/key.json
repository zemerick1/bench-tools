                "schema": {
                  "properties": {
                    "accept_end": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time since Epoch when the key will be de-activated. The `accept_end` should be always greater than the `accept_start`.",
                      "maximum": 2556143999,
                      "minimum": 1577836801
                    },
                    "accept_start": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time since Epoch from when the key will be active.",
                      "maximum": 2556143999,
                      "minimum": 1577836800
                    },
                    "auth_key": {
                      "type": "string",
                      "description": "Key used for authentication.",
                      "minLength": 1
                    },
                    "auth_type": {
                      "type": "string",
                      "description": "The type of authentication associated with this Key.",
                      "enum": [
                        "md5",
                        "sha1",
                        "sha256",
                        "sha384",
                        "sha512",
                        "aes_cmac128"
                      ]
                    },
                    "key_id": {
                      "type": "integer",
                      "description": "Reference Resource: [Key](#/Key)<br>The list of all the keys for the keychain instance."
                    },
                    "name": {
                      "type": "string",
                      "description": "Name of the key.",
                      "maxLength": 64,
                      "minLength": 1
                    },
                    "recv_id": {
                      "type": "integer",
                      "description": "Receive key id corresponding to the key instance. The keychain key cannot be used by applications  until the recv id is configured.",
                      "maximum": 255,
                      "minimum": 0
                    },
                    "send_end": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time since Epoch when the key will be de-activated. The `send_end` should be always greater than the `send_start`.",
