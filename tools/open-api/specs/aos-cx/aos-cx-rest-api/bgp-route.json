                      "type": "array",
                      "description": "Reference Resource: [BGP_VPNv4_Route](#/BGP_VPNv4_Route)<br>Reference to VPNv4 route attributes.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [BGP_Route](#/BGP_Route)<br>Reference to the VRF to which this route belongs."
                    }
                  },
                  "type": "object"
                }
