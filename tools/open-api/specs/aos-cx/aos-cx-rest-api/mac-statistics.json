{
  "openapi": "3.0.0",
  "info": {
    "title": "MAC_Statistics",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "MAC_Statistics"
    }
  ],
  "paths": {
    "/system/mac_statistics": {
      "get": {
        "tags": [
          "MAC_Statistics"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "last_update": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Timestamp of last update/insert to row.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "mac_addr": {
                      "type": "string",
                      "description": "Reference Resource: [MAC_Statistics](#/MAC_Statistics)<br>MAC address in a AA:BB:CC:DD:EE:FF form.",
                      "maxLength": 17,
                      "minLength": 17
                    },
                    "number_of_rapid_moves": {
                      "type": "integer",
                      "format": "int64",
                      "description": "A non-zero value to indicate the number of times that the entry has been detected as a rapid move.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "rapid_move_history": {
                      "type": "object",
                      "description": "Specifies details of the last 10 rapid mac moves.",
                      "properties": {
                        "integer": {
                          "type": "object",
                          "properties": {
                            "current_destination": {
                              "type": "string",
                              "description": "Specifies the current destination names [Port/Tunnel] on which this MAC address was rapidly moved to.",
                              "maxLength": 50
                            },
                            "current_source": {
                              "type": "string",
                              "description": "Specifies the current source type [i.e. Dynamic/Static] on which this MAC address was associated with at the time of the rapid move.",
                              "maxLength": 50
                            },
                            "previous_destination": {
                              "type": "string",
                              "description": "Specifies the last destination names [Port/Tunnel] on which this MAC address was associated prior to its current destination.",
                              "maxLength": 50
                            },
                            "previous_source": {
                              "type": "string",
                              "description": "Specifies the last source type [i.e. Dynamic/Static] on which this MAC address was associated with prior to its current source type.",
                              "maxLength": 50
                            },
                            "timestamp": {
                              "type": "string",
                              "description": "Specifies the last timestamp this MAC address was moved.",
                              "maxLength": 50
                            }
                          }
                        }
                      }
                    },
                    "vlan": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Reference Resource: [MAC_Statistics](#/MAC_Statistics)<br>VLAN ID on which the MAC entry is established.",
                      "maximum": 4294967295,
                      "minimum": 0
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "mac_addr",
                  "vlan",
                  "last_update",
                  "rapid_move_history",
                  "number_of_rapid_moves"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/system/mac_statistics/{MAC_Statistics.vlan},{MAC_Statistics.mac_addr}": {
      "get": {
        "tags": [
          "MAC_Statistics"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "last_update": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Timestamp of last update/insert to row.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "mac_addr": {
                      "type": "string",
                      "description": "Reference Resource: [MAC_Statistics](#/MAC_Statistics)<br>MAC address in a AA:BB:CC:DD:EE:FF form.",
                      "maxLength": 17,
                      "minLength": 17
                    },
                    "number_of_rapid_moves": {
                      "type": "integer",
                      "format": "int64",
                      "description": "A non-zero value to indicate the number of times that the entry has been detected as a rapid move.",
                      "maximum": 4294967295,
                      "minimum": 0
                    },
                    "rapid_move_history": {
                      "type": "object",
                      "description": "Specifies details of the last 10 rapid mac moves.",
                      "properties": {
                        "integer": {
                          "type": "object",
                          "properties": {
                            "current_destination": {
                              "type": "string",
                              "description": "Specifies the current destination names [Port/Tunnel] on which this MAC address was rapidly moved to.",
                              "maxLength": 50
                            },
                            "current_source": {
                              "type": "string",
                              "description": "Specifies the current source type [i.e. Dynamic/Static] on which this MAC address was associated with at the time of the rapid move.",
                              "maxLength": 50
                            },
                            "previous_destination": {
                              "type": "string",
                              "description": "Specifies the last destination names [Port/Tunnel] on which this MAC address was associated prior to its current destination.",
                              "maxLength": 50
                            },
                            "previous_source": {
                              "type": "string",
                              "description": "Specifies the last source type [i.e. Dynamic/Static] on which this MAC address was associated with prior to its current source type.",
                              "maxLength": 50
                            },
                            "timestamp": {
                              "type": "string",
                              "description": "Specifies the last timestamp this MAC address was moved.",
                              "maxLength": 50
                            }
                          }
                        }
                      }
                    },
                    "vlan": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Reference Resource: [MAC_Statistics](#/MAC_Statistics)<br>VLAN ID on which the MAC entry is established.",
                      "maximum": 4294967295,
                      "minimum": 0
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "MAC_Statistics.vlan",
            "in": "path",
            "description": "Reference Resource: [MAC_Statistics](#/MAC_Statistics)<br>VLAN ID on which the MAC entry is established.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "MAC_Statistics.mac_addr",
            "in": "path",
            "description": "Reference Resource: [MAC_Statistics](#/MAC_Statistics)<br>MAC address in a AA:BB:CC:DD:EE:FF form.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "mac_addr",
                  "vlan",
                  "last_update",
                  "rapid_move_history",
                  "number_of_rapid_moves"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
