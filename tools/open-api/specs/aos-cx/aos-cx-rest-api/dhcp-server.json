                    "": {
                      "type": "string",
                      "description": "Reference Resource: [DHCP_Server](#/DHCP_Server)<br>DHCPv4 Server in the VRF."
                    },
                    "authoritative_mode": {
                      "type": "boolean",
                      "description": "Set this value to `true` to enable authoritative mode of DHCPv4 server. If authoritative mode is enabled, server will become sole authority for the configured network. Server will respond with DHCPNAK messages for the DHCP requests received for unknown leases from unknown hosts. Setting the value to `false` will ignore the unknown leases from unknown hosts."
                    },
                    "dhcp_server_pools": {
                      "type": "object",
                      "description": "Reference Resource: [DHCP_Server_Pool](#/DHCP_Server_Pool)<br>DHCPv4 Server address pools.",
