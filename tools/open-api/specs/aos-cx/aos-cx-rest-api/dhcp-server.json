                        "string": {
                          "type": "string",
                          "description": "Reference resource URI of DHCP_Server_Pool"
                        }
                      }
                    },
                    "enable": {
                      "type": "boolean",
                      "description": "Enables this DHCPv4 server instance."
                    },
                    "status": {
                      "type": "string",
                      "description": "Current state of DHCPv4 Server:  `operational`: fully operational `disabled`:    administratively disabled",
                      "enum": [
                        "operational",
                        "disabled"
                      ]
