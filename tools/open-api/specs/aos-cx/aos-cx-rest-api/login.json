{
  "openapi": "3.0.0",
  "info": {
    "title": "Login",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Login"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "description": "Login to device using username and password.",
        "summary": "User login.",
        "tags": [
          "Login"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "description": "User name",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "password",
            "in": "query",
            "description": "Password",
            "schema": {
              "type": "string",
              "format": "password"
            }
          }
        ]
      }
    }
  }
}
