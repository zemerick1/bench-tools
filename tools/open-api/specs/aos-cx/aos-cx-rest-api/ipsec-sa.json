{
  "openapi": "3.0.0",
  "info": {
    "title": "IPsec_SA",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "IPsec_SA"
    }
  ],
  "paths": {
    "/system/vrfs/{VRF.name}/ipsec_sas": {
      "get": {
        "tags": [
          "IPsec_SA"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "SPI": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Reference Resource: [IPsec_SA](#/IPsec_SA)<br>Security Parameters Index for the Security Association.",
                      "maximum": 4294967295,
                      "minimum": 1
                    },
                    "address_family": {
                      "type": "string",
                      "description": "Reference Resource: [IPsec_SA](#/IPsec_SA)<br>Address Family used in the Security Association.",
                      "enum": [
                        "ipv4",
                        "ipv6"
                      ]
                    },
                    "auth_key": {
                      "type": "string",
                      "description": "Authentication key to use in the SA.",
                      "minLength": 1
                    },
                    "auth_type": {
                      "type": "string",
                      "description": "IPsec Authentication type.",
                      "enum": [
                        "sha1",
                        "sha256",
                        "sha512",
                        "md5"
                      ]
                    },
                    "dest_ip": {
                      "type": "string",
                      "description": "Reference Resource: [IPsec_SA](#/IPsec_SA)<br>IPv4 or IPv6 destination address. Example: 192.168.0.0.",
                      "maxLength": 45
                    },
                    "direction": {
                      "type": "string",
                      "description": "Reference Resource: [IPsec_SA](#/IPsec_SA)<br>Traffic direction for the Security Association. 'both' : This SA is applicable to both directions.",
                      "enum": [
                        "both"
                      ]
                    },
                    "encryption_key": {
                      "type": "string",
                      "description": "Encryption key to use in the SA.",
                      "minLength": 1
                    },
                    "encryption_type": {
                      "type": "string",
                      "description": "Cipher to be used for encryption.",
                      "enum": [
                        "aes",
                        "des",
                        "3des"
                      ]
                    },
                    "from": {
                      "type": "string",
                      "description": "Originator of this Security Association.",
                      "enum": [
                        "ospf",
                        "ospfv3af",
                        "radius"
                      ]
                    },
                    "ipsec_protocol": {
                      "type": "string",
                      "description": "Reference Resource: [IPsec_SA](#/IPsec_SA)<br>IPsec protocol to use in the Security Association. Authentication Header (AH) | Encapsulating Security Payload (ESP). 'AH' : Provides authentication. 'ESP': Provides confidentiality and authentication.",
                      "enum": [
                        "AH",
                        "ESP"
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "description": "IPsec operation mode. 'tunnel'    : Entire IP packet is encapsulated into a new packet with a new IP header. 'transport' : IP header of the packet is not modified.",
                      "enum": [
                        "tunnel",
                        "transport"
                      ]
                    },
                    "src_ip": {
                      "type": "string",
                      "description": "IPv4 or IPv6 source address. Example: 192.168.0.0.",
                      "maxLength": 45
                    },
                    "statistics": {
                      "type": "object",
                      "description": "Statistics of this Security Association.",
                      "properties": {
                        "bytes": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of bytes processed by this Security Association."
                        },
                        "integrity_failed": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of packets dropped due to failed integrity checks."
                        },
                        "packets": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of packets processed by this Security Association."
                        }
                      }
                    },
                    "status": {
                      "type": "object",
                      "description": "Status of this Security Association.",
                      "properties": {
                        "kernel_application_time ": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Time (in seconds) since epoch when this SA was applied in the kernel."
                        },
                        "kernel_state": {
                          "type": "string",
                          "description": "Runtime state of this SA in the kernel. 'not_applied'      : SA is added for kernel configuration and not yet applied to the kernel. 'applied'          : SA is configured successfully in the kernel. 'failed_to_apply'  : SA configuration failed in the kernel.",
                          "enum": [
                            "not_applied",
                            "applied",
                            "failed_to_apply"
                          ]
                        }
                      }
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [IPsec_SA](#/IPsec_SA)<br>Reference to the VRF table, to which this IPsec SA belongs."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "VRF.name",
            "in": "path",
            "description": "Reference Resource: [VRF](#/VRF)<br>VRF identifier. Should be alphanumeric. VRF names must be unique.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "mode",
                  "encryption_key",
                  "status",
                  "dest_ip",
                  "from",
                  "statistics",
                  "src_ip",
                  "auth_type",
                  "auth_key",
                  "address_family",
                  "direction",
                  "encryption_type",
                  "SPI",
                  "ipsec_protocol"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
