{
  "openapi": "3.0.0",
  "info": {
    "title": "L3_Destination",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "L3_Destination"
    }
  ],
  "paths": {
    "/system/l3_destinations": {
      "get": {
        "tags": [
          "L3_Destination"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "l2_composite_group": {
                      "type": "string",
                      "description": "Reference Resource: [L2_Composite_Group](#/L2_Composite_Group)<br>L2 Composite Group corresponding to this L3 Destination Entry. A L2 Composite Group is a composition of different types of  l2 egress entities. For a L3_Destination, either 'tunnel_endpoint' or 'l2_composite_group'  is populated to indicate how it is programmed in the forwarding plane."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "l2_composite_group"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/system/l3_destinations/{L3_Destination.forwarding_type},{L3_Destination.id}": {
      "get": {
        "tags": [
          "L3_Destination"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "l2_composite_group": {
                      "type": "string",
                      "description": "Reference Resource: [L2_Composite_Group](#/L2_Composite_Group)<br>L2 Composite Group corresponding to this L3 Destination Entry. A L2 Composite Group is a composition of different types of  l2 egress entities. For a L3_Destination, either 'tunnel_endpoint' or 'l2_composite_group'  is populated to indicate how it is programmed in the forwarding plane."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "L3_Destination.forwarding_type",
            "in": "path",
            "description": "Reference Resource: [L3_Destination](#/L3_Destination)<br>Specific platforms support a subset of these forwarding types: 'ip_neighbor_multicast':               Used by Static ARP Neighbors on same port and mac 'ipv4_directed_broadcast':             Used by IPv4 IPDB Neighbors on same port. 'ipv4_neighbor':                       Used by IPv4 Neighbors on same port and phy_port. 'ipv6_neighbor':                       Used by IPv6 Neighbors with same MAC Address                                        on same port and phy_port. 'neighbor_route_overlay':              Used by Neighbors or Routes reachable on a                                         remote overlay peer. 'route':                               Used by routing entries with same Nexthop IP Address. 'route_overlay':                       Used by Routes reachable on a remote overlay peer. 'ecmp_member_block':                   Used by ECMP Groups for member                                         Nexthops, for hardware that                                         requires IDs allocated in blocks. 'route_ecmp_member':                   Used by Routes and Groups. 'neighbor_route_ecmp_member':          Used by Neighbors, Routes, and                                        Groups. 'neighbor_route_ecmp_member_overlay':  Used by Neighbors, Routes, and Groups                                        reachable on a VLAN with a VNI pointing to it. 'tunnel_member':                       Used by Tunnel groups for member                                        Nexthops. 'tunnel_member_outer':                 Used by Tunnel groups for member                                        Nexthops, for an outer packet. 'tunnel_member_block':                 Used by Tunnel Groups for member                                        Nexthops, for hardware that                                         requires IDs allocated in blocks. 'tunnel_interface_with_ecmp':          Used by Tunnel interfaces for route                                        associations. 'mpls_lsp_route':                      Used by MPLS LSPs, Routes, and                                        Groups.",
            "schema": {
              "type": "string",
              "enum": [
                "ip_neighbor_multicast",
                "ipv4_directed_broadcast",
                "ipv4_neighbor",
                "ipv6_neighbor",
                "neighbor_route_overlay",
                "route",
                "route_overlay",
                "ecmp_member_block",
                "route_ecmp_member",
                "neighbor_route_ecmp_member",
                "neighbor_route_ecmp_member_overlay",
                "tunnel_member",
                "tunnel_member_outer",
                "tunnel_member_block",
                "tunnel_interface_with_ecmp",
                "mpls_lsp_route"
              ]
            },
            "required": true
          },
          {
            "name": "L3_Destination.id",
            "in": "path",
            "description": "Reference Resource: [L3_Destination](#/L3_Destination)<br>Abstracted value which is generated to identify each of the  L3 destinations.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "l2_composite_group"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "responses": {
      "304": {
        "description": "Not Modified"
      },
      "400": {
        "description": "Bad Request"
      },
      "401": {
        "description": "Unauthorized"
      },
      "403": {
        "description": "Forbidden"
      },
      "404": {
        "description": "Not Found"
      },
      "500": {
        "description": "Internal Server Error"
      },
      "501": {
        "description": "Not Implemented"
      },
      "503": {
        "description": "Service Unavailable"
      }
    }
  }
}
