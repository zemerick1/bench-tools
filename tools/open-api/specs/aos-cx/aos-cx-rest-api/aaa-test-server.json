                    "test_id": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Reference Resource: [AAA_Test_Server](#/AAA_Test_Server)<br>Specifies the test run ID associated with the test run.",
                      "minimum": 1
                    },
