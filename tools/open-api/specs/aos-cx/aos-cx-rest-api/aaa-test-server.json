                        "URI": {
                          "type": "string",
                          "description": "Reference resource URI of AAA_Test_Server_Status"
                        }
                      }
                    },
                    "test_start_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time (in microseconds) since Epoch, when the test-server run started.",
                      "minimum": 0
                    },
                    "test_status": {
                      "type": "string",
                      "description": "State of AAA test server run:  `pending`: AAA test server run pending  `in-progress`: AAA test server run in-progress.  `completed`: AAA test server run completed successfully.",
