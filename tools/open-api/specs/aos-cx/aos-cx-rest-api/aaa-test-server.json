                      "enum": [
                        "pap",
                        "chap"
                      ]
                    },
                    "password": {
                      "type": "string",
                      "description": "Specifies the passkey between RADIUS client and RADIUS server for authentication."
                    },
                    "persistence": {
                      "type": "string",
                      "description": "Persistence of AAA test server run instances, i.e how the  AAA test server run is provisioned: `volatile`     :  AAA test server test run instances will not be                   retained over system reboot.",
                      "enum": [
                        "volatile"
                      ]
                    },
                    "radius_server": {
                      "type": "string",
                      "description": "Reference Resource: [Radius_Server](#/Radius_Server)<br>Specifies the server to reach out to for this test authentication."
