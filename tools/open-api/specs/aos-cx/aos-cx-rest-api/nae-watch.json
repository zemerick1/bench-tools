{
  "openapi": "3.0.0",
  "info": {
    "title": "NAE_Watch",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "NAE_Watch"
    }
  ],
  "paths": {
    "/system/nae_scripts/{NAE_Script.name}/nae_agents/{NAE_Agent.name}/nae_watches": {
      "get": {
        "tags": [
          "NAE_Watch"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": "NAE Watch description",
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [NAE_Watch](#/NAE_Watch)<br>Watches created by the particular NAE Agent."
                    },
                    "resource": {
                      "type": "object",
                      "description": "Identifies the resource to be watched. For the `type` `event_log`, specify the event id of the desired event log.",
                      "properties": {
                        "event_id": {
                          "type": "string",
                          "description": "List of one or more comma seperated Event IDs."
                        }
                      }
                    },
                    "type": {
                      "type": "string",
                      "description": "Type of the information getting watched. 'event_log': Watch the event log buffer for for occurance of a configured event log ID.",
                      "enum": [
                        "event_log"
                      ]
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "NAE_Script.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Script](#/NAE_Script)<br>Name of a NAE Script. This has to be a valid canonical name (CNAME) (i.e com.arubanetworks.bgp_monitor).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "NAE_Agent.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Agent](#/NAE_Agent)<br>Name of a NAE Agent. This has to be a CNAME starting with NAE Script name followed by its own name (i.e com.arubanetworks.bgp_monitor.agent1).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "description",
                  "name",
                  "type",
                  "resource"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/system/nae_scripts/{NAE_Script.name}/nae_agents/{NAE_Agent.name}/nae_watches/{NAE_Watch.name}": {
      "get": {
        "tags": [
          "NAE_Watch"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": "NAE Watch description",
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [NAE_Watch](#/NAE_Watch)<br>Watches created by the particular NAE Agent."
                    },
                    "resource": {
                      "type": "object",
                      "description": "Identifies the resource to be watched. For the `type` `event_log`, specify the event id of the desired event log.",
                      "properties": {
                        "event_id": {
                          "type": "string",
                          "description": "List of one or more comma seperated Event IDs."
                        }
                      }
                    },
                    "type": {
                      "type": "string",
                      "description": "Type of the information getting watched. 'event_log': Watch the event log buffer for for occurance of a configured event log ID.",
                      "enum": [
                        "event_log"
                      ]
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "NAE_Script.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Script](#/NAE_Script)<br>Name of a NAE Script. This has to be a valid canonical name (CNAME) (i.e com.arubanetworks.bgp_monitor).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "NAE_Agent.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Agent](#/NAE_Agent)<br>Name of a NAE Agent. This has to be a CNAME starting with NAE Script name followed by its own name (i.e com.arubanetworks.bgp_monitor.agent1).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "NAE_Watch.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Watch](#/NAE_Watch)<br>Watches created by the particular NAE Agent.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "type",
                  "resource",
                  "description"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "responses": {
      "304": {
        "description": "Not Modified"
      },
      "400": {
        "description": "Bad Request"
      },
      "401": {
        "description": "Unauthorized"
      },
      "403": {
        "description": "Forbidden"
      },
      "404": {
        "description": "Not Found"
      },
      "500": {
        "description": "Internal Server Error"
      },
      "501": {
        "description": "Not Implemented"
      },
      "503": {
        "description": "Service Unavailable"
      }
    }
  }
}
