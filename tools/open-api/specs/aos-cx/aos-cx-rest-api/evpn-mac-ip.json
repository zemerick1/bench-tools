{
  "openapi": "3.0.0",
  "info": {
    "title": "EVPN_MAC_IP",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "EVPN_MAC_IP"
    }
  ],
  "paths": {
    "/system/evpn_mac_ips": {
      "get": {
        "tags": [
          "EVPN_MAC_IP"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "evi": {
                      "type": "integer",
                      "description": "Reference Resource: [EVPN_MAC_IP](#/EVPN_MAC_IP)<br>Index identifying the EVPN instance.",
                      "maximum": 16777214,
                      "minimum": 1
                    },
                    "flags": {
                      "type": "object",
                      "description": "Flags associated with this MAC entry on this EVPN instance.",
                      "properties": {
                        "sticky": {
                          "type": "boolean",
                          "description": "The MAC entry's sticky-bit status. It indicates that the MAC address is 'static' and cannot be moved to a different port or tunnel interface."
                        }
                      }
                    },
                    "ip_address": {
                      "type": "string",
                      "description": "Reference Resource: [EVPN_MAC_IP](#/EVPN_MAC_IP)<br>IP addresses associated with this MAC address. This is updated based on the MAC-IP NLRIs for this MAC address on this EVPN instance.",
                      "maxLength": 45
                    },
                    "mac_address": {
                      "type": "string",
                      "description": "Reference Resource: [EVPN_MAC_IP](#/EVPN_MAC_IP)<br>MAC address in AA:BB:CC:DD:EE:FF form.",
                      "maxLength": 17,
                      "minLength": 17
                    },
                    "mac_mobility_seq_num": {
                      "type": "integer",
                      "format": "int64",
                      "description": "MAC mobility sequence number associated with this MAC address on this EVPN instance."
                    },
                    "mac_route_status": {
                      "type": "boolean",
                      "description": "MAC-only NLRI (no IP address associated with this NLRI) for this MAC address on this EVPN instance."
                    },
                    "nexthop": {
                      "type": "string",
                      "description": "Reference Resource: [EVPN_MAC_IP](#/EVPN_MAC_IP)<br>EVPN next hop for the MAC/IP entry.",
                      "maxLength": 45
                    },
                    "source": {
                      "type": "string",
                      "description": "Source of this MAC/IP entry on this EVPN instance.",
                      "enum": [
                        "local",
                        "remote"
                      ]
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
