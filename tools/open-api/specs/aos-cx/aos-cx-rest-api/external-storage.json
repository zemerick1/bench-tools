{
  "openapi": "3.0.0",
  "info": {
    "title": "External_Storage",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "External_Storage"
    }
  ],
  "paths": {
    "/system/external_storages": {
      "get": {
        "tags": [
          "External_Storage"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "address": {
                      "type": "string",
                      "description": "IP address or host name of the network attached storage.",
                      "maxLength": 255
                    },
                    "directory": {
                      "type": "string",
                      "description": "Directory to be accessed on the external storage.",
                      "maxLength": 128
                    },
                    "enable": {
                      "type": "boolean",
                      "description": "Enables access to specific storage volume."
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [External_Storage](#/External_Storage)<br>The name of the external storage volume.",
                      "maxLength": 64
                    },
                    "password": {
                      "type": "string",
                      "description": "Password to be used for SMB and SCP type storage.",
                      "maxLength": 192,
                      "minLength": 8
                    },
                    "state": {
                      "type": "string",
                      "description": "Current state of external storage volume:  `operational`:           fully operational `disabled`:              administratively disabled `connecting`:            establishing connection to network attached storage `unaccessible`:          network attached storage is not accessible due to connectivity issues `invalid_credentials`:   invalid username and/or the password `invalid_directory`:     directory doesn't exist or is not allowed to be accessed `internal_error`:        any other error that might have happened during access to                          the external storage",
                      "enum": [
                        "operational",
                        "disabled",
                        "connecting",
                        "unaccessible",
                        "invalid_credentials",
                        "invalid_directory",
                        "internal_error"
                      ]
                    },
                    "type": {
                      "type": "string",
                      "description": "External storage access type: 'NFSv4': network attached storage, accessible through NFSv4 protocol 'NFSv3': network attached storage, accessible through NFSv3 protocol 'SMB':   network attached storage, accessible through SMB protocol (also known as CIFS or Windows Share) 'SCP':   network attached storage, accessible through secured shell protocol",
                      "enum": [
                        "NFSv4",
                        "NFSv3",
                        "SMB",
                        "SCP"
                      ]
                    },
                    "username": {
                      "type": "string",
                      "description": "User name to be used for SMB and SCP type storage.",
                      "maxLength": 32,
                      "minLength": 1
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [VRF](#/VRF)<br>VRF to be used for reaching the network attached storage."
                    }
                  },
                  "required": [
                    "name",
                    "vrf"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
