          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "origin",
                  "description",
                  "history",
                  "status",
                  "run_count",
                  "failed_run_count",
                  "name",
                  "disable",
                  "job_entries"
