{
  "openapi": "3.0.0",
  "info": {
    "title": "Job",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Job"
    }
  ],
  "paths": {
    "/system/jobs": {
      "get": {
        "tags": [
          "Job"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": "A description about the job. This column value can be empty.",
                      "maxLength": 128,
                      "minLength": 1
                    },
                    "disable": {
                      "type": "boolean",
                      "description": "Disable the job."
                    },
                    "failed_run_count": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The number of times the job has failed since boot.",
                      "minimum": 0
                    },
                    "history": {
                      "type": "object",
                      "description": "Job history information.",
                      "properties": {
                        "integer": {
                          "type": "object",
                          "properties": {
                            "failure_reason": {
                              "type": "string",
                              "description": "Reason for the job failure."
                            },
                            "job_history_uri": {
                              "type": "string",
                              "description": "File URI of the generated job history file."
                            },
                            "run_duration": {
                              "type": "integer",
                              "format": "int64",
                              "description": "Execution duration in seconds corresponding to the job run."
                            },
                            "run_status": {
                              "type": "string",
                              "description": "Status of the run. `success`     : Job run was successful. `failed`      : Job run failed. `unknown`     : Job run unknown",
                              "enum": [
                                "success",
                                "failed",
                                "unknown"
                              ]
                            },
                            "run_timestamp": {
                              "type": "integer",
                              "format": "int64",
                              "description": "Time since Epoch when this instance of the job was started."
                            }
                          }
                        }
                      }
                    },
                    "job_entries": {
                      "type": "object",
                      "description": "Reference Resource: [Job_Entry](#/Job_Entry)<br>List of commands executed under this job.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Job_Entry"
                        }
                      }
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Job](#/Job)<br>Job name.",
                      "maxLength": 64,
                      "minLength": 1
                    },
                    "origin": {
                      "type": "string",
                      "description": "Origin of the Job, i.e., how the Job is provisioned:  `synthesized`: Job has been dynamically synthesized                 by the system.  `static`     : Job is provisioned by the administrator                 via CLI or REST.",
                      "enum": [
                        "synthesized",
                        "static"
                      ]
                    },
                    "run_count": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The number of times the job has run since boot."
                    },
                    "status": {
                      "type": "string",
                      "description": "Status of the job `waiting_for_trigger` : waiting for a trigger. `running`             : currently being executed.",
                      "enum": [
                        "running",
                        "waiting_for_trigger"
                      ]
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
