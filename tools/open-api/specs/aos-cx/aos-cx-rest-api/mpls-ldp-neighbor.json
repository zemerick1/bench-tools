      "get": {
        "tags": [
          "MPLS_LDP_Neighbor"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "addresses": {
                      "type": "array",
                      "description": "Nexthop addresses bound to LDP peer",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000
                    },
                    "graceful_restart": {
                      "type": "boolean",
                      "description": "Peer's advertisement graceful restart for the current LDP session"
                    },
                    "hold_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Hello hold time which is negotiated between the local (entity) and the peer"
                    },
                    "peer_reconnect_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Graceful restart reconnect time advertised by peer."
                    },
                    "peer_recovery_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Graceful restart recovery time advertised by peer."
                    },
                    "peer_router_id": {
                      "type": "string",
                      "description": "Reference Resource: [MPLS_LDP_Neighbor](#/MPLS_LDP_Neighbor)<br>IP address of the peer router ID",
                      "maxLength": 21
                    },
                    "router_id": {
                      "type": "string",
                      "description": "Reference Resource: [MPLS_LDP_Neighbor](#/MPLS_LDP_Neighbor)<br>IP address of the local router ID",
                      "maxLength": 21
                    },
                    "source_port": {
                      "type": "array",
                      "description": "Reference Resource: [Port](#/Port)<br>Ingress port",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000
                    },
                    "state": {
                      "type": "string",
                      "description": "Current state of LDP session",
                      "enum": [
                        "non-existent",
                        "initialized",
                        "open-received",
                        "open-sent",
                        "operational"
                      ]
                    },
                    "tcp_connection": {
                      "type": "object",
                      "properties": {
                        "dst_ip": {
                          "type": "string",
                          "description": "Destination IP address",
                          "maxLength": 16
                        },
                        "dst_port": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Destination port"
                        },
                        "src_ip": {
                          "type": "string",
                          "description": "Source IP address",
                          "maxLength": 16
                        },
                        "src_port": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Source port"
                        }
                      }
                    },
                    "up_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Up time for current LDP session"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
