{
  "openapi": "3.0.0",
  "info": {
    "title": "MPLS_LDP_Neighbor",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "MPLS_LDP_Neighbor"
    }
  ],
  "paths": {
