{
  "openapi": "3.0.0",
  "info": {
    "title": "MVRP_VLAN",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "MVRP_VLAN"
    }
  ],
  "paths": {
    "/system/interfaces/{Interface.name}/mvrp_vlans": {
      "get": {
        "tags": [
          "MVRP_VLAN"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "mvrp_applicant_state": {
                      "type": "string",
                      "description": "The state of the Applicant state machine. The possible states of the applicant are \"Very anxious Observer (VO)\", \"Very anxious Passive (VP)\", \"Very anxious New (VN)\", \"Anxious New (AN)\", \"Anxious Active (AA)\", \"Quiet Active (QA)\", \"Leaving Active (LA)\", \"Anxious Observer (AO)\", \"Quiet Observer (QO)\", \"Anxious Passive (AP)\", \"Quiet Passive (QP)\", \"Leaving Observer (LO)\"",
                      "enum": [
                        "vo",
                        "vp",
                        "vn",
                        "an",
                        "aa",
                        "qa",
                        "la",
                        "ao",
                        "qo",
                        "ap",
                        "qp",
                        "lo"
                      ]
                    },
                    "mvrp_registrar_state": {
                      "type": "string",
                      "description": "The state of the Registrar state machine. The possible states and their description are: \"in\"  state means \"Registered\". \"lv\" state means  \"Previously registered, but now being timed out\". \"mt\" state means \"Not registered\".",
                      "enum": [
                        "in",
                        "lv",
                        "mt"
                      ]
                    },
                    "vlan-id": {
                      "type": "integer",
                      "description": "Reference Resource: [MVRP_VLAN](#/MVRP_VLAN)<br>The list of all the VLANs that have been learned through the MVRP protocol."
                    }
                  },
                  "required": [
                    "vlan-id"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "Interface.name",
            "in": "path",
            "description": "Reference Resource: [Port](#/Port)<br>The port name. For non-bonded ports, the port name is the same as the associated interface name. The name must otherwise be unique across all ports and interfaces of the system.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "mvrp_registrar_state",
                  "mvrp_applicant_state"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
