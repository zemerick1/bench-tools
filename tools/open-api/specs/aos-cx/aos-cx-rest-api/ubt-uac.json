{
  "openapi": "3.0.0",
  "info": {
    "title": "UBT_UAC",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "UBT_UAC"
    }
  ],
  "paths": {
    "/system/vrfs/{VRF.name}/ubt_zones/{UBT_Zone.name}/ubt_uacs": {
      "get": {
        "tags": [
          "UBT_UAC"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ip_address": {
                      "type": "string",
                      "description": "Reference Resource: [UBT_UAC](#/UBT_UAC)<br>IP address of the UAC node.",
                      "maxLength": 45
                    },
                    "statistics": {
                      "type": "object",
                      "description": "Statistics of the number of users attached to this node and count of packets exchanged with it.",
                      "properties": {
                        "bootstrap_ack_rx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of bootstrap acknowledgment packets received from this UAC."
                        },
                        "bootstrap_tx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of bootstrap packets transmitted to this UAC."
                        },
                        "keepalive_ack_rx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of keep-alive acknowledgment packets received from this UAC."
                        },
                        "keepalive_tx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of keep-alive packets transmitted to this UAC."
                        },
                        "packet_rx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of packets received from this UAC."
                        },
                        "packet_tx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of packets transmitted to this UAC."
                        },
                        "unbootstrap_ack_rx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of unbootstrap acknowledgment packets received from this UAC."
                        },
                        "unbootstrap_tx": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of unbootstrap packets transmitted to this UAC."
                        },
                        "user_count": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Count of users attached to UAC node."
                        }
                      }
                    },
                    "ubt_zone": {
                      "type": "string",
                      "description": "Reference Resource: [UBT_UAC](#/UBT_UAC)<br>Zone associated with this User Anchor Controller(UAC) node."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "VRF.name",
            "in": "path",
            "description": "Reference Resource: [VRF](#/VRF)<br>VRF identifier. Should be alphanumeric. VRF names must be unique.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "UBT_Zone.name",
            "in": "path",
            "description": "Reference Resource: [UBT_Zone](#/UBT_Zone)<br>Zone name.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ip_address",
                  "statistics"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
