{
  "openapi": "3.0.0",
  "info": {
    "title": "Plugin",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Plugin"
    }
  ],
  "paths": {
    "/system/subsystems/{Subsystem.type},{Subsystem.name}/daemons/{Daemon.name}/plugins": {
      "get": {
        "tags": [
          "Plugin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "major_version": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The major version number of the currently loaded plugin",
                      "minimum": 0
                    },
                    "minor_version": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The minor version number of the currently loaded plugin",
                      "minimum": 0
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Plugin](#/Plugin)<br>"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "Subsystem.type",
            "in": "path",
            "description": "Reference Resource: [Subsystem](#/Subsystem)<br>",
            "schema": {
              "type": "string",
              "enum": [
                "uninitialized",
                "system",
                "chassis",
                "line_card",
                "mezz_card",
                "fabric_card",
                "management_module",
                "rear_display_card",
                "fan_tray",
                "services_card",
                "io_module"
              ]
            },
            "required": true
          },
          {
            "name": "Subsystem.name",
            "in": "path",
            "description": "Reference Resource: [Subsystem](#/Subsystem)<br>",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "Daemon.name",
            "in": "path",
            "description": "Reference Resource: [Daemon](#/Daemon)<br>The name of the daemon.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "minor_version",
                  "major_version"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/system/subsystems/{Subsystem.type},{Subsystem.name}/daemons/{Daemon.name}/plugins/{Plugin.name}": {
      "get": {
        "tags": [
