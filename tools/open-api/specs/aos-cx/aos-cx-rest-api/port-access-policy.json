{
  "openapi": "3.0.0",
  "info": {
    "title": "Port_Access_Policy",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Port_Access_Policy"
    }
  ],
  "paths": {
    "/system/port_access_policies": {
      "get": {
        "tags": [
          "Port_Access_Policy"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "acl_names": {
                      "type": "array",
                      "description": "List of ACLs from which the current policy is derived. This is applicable only when the policy is of type 'radius'.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 128
                    },
                    "base_policy_name": {
                      "type": "string",
                      "description": "Base policy from which the current policy is derived. This is applicable only when the policy is of type 'radius'.",
                      "maxLength": 128
                    },
                    "cfg_entries": {
                      "type": "object",
                      "description": "Reference Resource: [Port_Access_Policy_Entry](#/Port_Access_Policy_Entry)<br>Policy entries as configured by the user. MAC based classes are not supported in a policy entry. The entire policy is rejected if it contains one or more policy entries with MAC classes.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Port_Access_Policy_Entry"
                        }
                      }
                    },
                    "cfg_version": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The version of 'cfg_entries' that should be changed to a random value each time 'cfg_entries' is modified.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991
                    },
                    "client_in_conform_rate": {
                      "type": "object",
                      "description": "Traffic rate in kilobits per second that matched ingress port-access policy specific 'cir', count' entries. This is an aggregated statistics across all clients on a  port that have port-access authentication mode set to 'client-mode'.",
                      "properties": {
                        "integer": {
                          "type": "integer",
                          "format": "int64",
                          "minimum": 0
                        }
                      }
                    },
                    "client_in_statistics": {
                      "type": "object",
                      "description": "Count of packets that matched ingress port-access policy specific 'count' entries. This is an aggregated statistics across all clients  on a port that have port-access authentication mode set to 'client-mode'.",
                      "properties": {
                        "integer": {
                          "type": "integer",
                          "format": "int64",
                          "minimum": 0
                        }
                      }
                    },
                    "cur_entries": {
                      "type": "object",
                      "description": "Reference Resource: [Port_Access_Policy_Entry](#/Port_Access_Policy_Entry)<br>Policy entries that are currently programmed in the data path.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Port_Access_Policy_Entry"
                        }
                      }
                    },
                    "in_progress_entries": {
                      "type": "object",
                      "description": "Reference Resource: [Port_Access_Policy_Entry](#/Port_Access_Policy_Entry)<br>Policy entries that are being processed for installation into the data path.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Port_Access_Policy_Entry"
                        }
                      }
                    },
                    "in_progress_version": {
                      "type": "integer",
                      "format": "int64",
                      "description": "The version of the 'in_progress' Policy.  This value is copied from 'cfg_version' when the Policy processing begins. This value is cleared when the Policy status is updated to 'applied' or 'rejected.'",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Port_Access_Policy](#/Port_Access_Policy)<br>Name of a port-access policy.",
                      "maxLength": 128,
                      "minLength": 1
                    },
                    "origin": {
                      "type": "string",
                      "description": "Origin of the policy, i.e., how the policy is provisioned.  `local`:           policy is provisioned locally on the device.  `downloaded`:      policy is downloaded from ClearPass server.  `radius`:          policy is translated from the attributes assigned                     by RADIUS server.",
                      "enum": [
                        "downloaded",
                        "local",
                        "radius"
                      ]
                    },
                    "port_in_conform_rate": {
                      "type": "object",
                      "description": "Traffic rate in kilobits per second that matched ingress port-access policy specific 'cir', 'count' entries. This is an aggregated statistics across all ports that  have their port-access authentication mode set to 'device-mode'.",
                      "properties": {
                        "integer": {
                          "type": "integer",
                          "format": "int64",
                          "minimum": 0
                        }
                      }
                    },
                    "port_in_statistics": {
                      "type": "object",
                      "description": "Count of packets that matched ingress port-access policy specific 'count' entries.This is an aggregated statistics across all ports  that have their port-access authentication mode set to 'device-mode'.",
                      "properties": {
                        "integer": {
                          "type": "integer",
                          "format": "int64",
                          "minimum": 0
                        }
                      }
                    },
                    "status": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Numeric error code.  Expected to be 0 when state is 'applied'."
                        },
                        "message": {
                          "type": "string",
                          "description": "Detailed reason for error state.  Expected empty when state is 'applied'."
                        },
                        "state": {
                          "type": "string",
                          "description": "Valid values are 'applied', 'in_progress', 'rejected'",
                          "enum": [
                            "applied",
                            "in_progress",
                            "rejected"
                          ]
                        },
                        "version": {
                          "type": "integer",
                          "format": "int64",
                          "description": "The version of cfg_entries that corresponds to this status."
                        }
                      }
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
