{
  "openapi": "3.0.0",
  "info": {
    "title": "Certificate_Login",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Certificate_Login"
    }
  ],
  "paths": {
    "/certificate_login": {
      "post": {
        "description": "Certificate based authentication.<br><br>  This URI is not supported by Notifications or NAE.",
        "summary": "Certificate based authentication.",
        "tags": [
          "Certificate_Login"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  }
}
