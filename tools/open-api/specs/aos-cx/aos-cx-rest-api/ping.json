{
  "openapi": "3.0.0",
  "info": {
    "title": "Ping",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Ping"
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "description": "Get ping statistics for destination.<br><br>  This URI is not supported by Notifications or NAE.",
        "summary": "Ping result.",
        "tags": [
          "Ping"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "name": "ping_target",
            "in": "query",
            "description": "ping IP address",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "is_ipv4",
            "in": "query",
            "description": "true if ping_target is an IPv4 address",
            "schema": {
              "type": "boolean"
            },
            "required": true
          },
          {
            "name": "is_bcast",
            "in": "query",
            "description": "true if ping_target is a broadcast address",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "ping_data_fill",
            "in": "query",
            "description": "ping dataFill pattern in hexadecimal, and maximum pattern data less than 32",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ping_data_size",
            "in": "query",
            "description": "set the packet size to n bytes, default value 100.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ping_source",
            "in": "query",
            "description": "set the source address, it can be an IP address or an interface name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ping_time_out",
            "in": "query",
            "description": "ping timeout, default value 2",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ping_interval",
            "in": "query",
            "description": "set ping interval, time between packets in seconds",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ping_repetitions",
            "in": "query",
            "description": "send n ping signals, default value 5",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ping_type_of_service",
            "in": "query",
            "description": "ping type of service",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "include_time_stamp",
            "in": "query",
            "description": "include time stamp",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "include_time_stamp_address",
            "in": "query",
            "description": "include time stamp address",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "record_route",
            "in": "query",
            "description": "route recorded",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "mgmt",
            "in": "query",
            "description": "VRF name/Management mutually exclusive. default value false",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "vrf_name",
            "in": "query",
            "description": "VRF name/Management mutually exclusive. default value 'swns'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
