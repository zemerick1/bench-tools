{
  "openapi": "3.0.0",
  "info": {
    "title": "RIP_Route",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "RIP_Route"
    }
  ],
  "paths": {
    "/system/vrfs/{VRF.name}/rip_routers/{RIP_Router.instance_tag}/rip_routes": {
      "get": {
        "tags": [
          "RIP_Route"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "metric": {
                      "type": "integer",
                      "description": "Number of routed hops between the nexthop device and the destination network.",
                      "maximum": 15,
                      "minimum": 1
                    },
                    "nexthop": {
                      "type": "string",
                      "description": "Reference Resource: [RIP_Route](#/RIP_Route)<br>IPv4 or IPv6 address of the nexthop device.",
                      "maxLength": 45
                    },
                    "port": {
                      "type": "string",
                      "description": "Reference Resource: [Port](#/Port)<br>Interface through which the next hop of this route is reachable."
                    },
                    "prefix": {
                      "type": "string",
                      "description": "Reference Resource: [RIP_Route](#/RIP_Route)<br>IPv4 or IPv6 destination prefix and mask in the address/mask format.",
                      "maxLength": 49
                    },
                    "rip_router": {
                      "type": "string",
                      "description": "Reference Resource: [RIP_Route](#/RIP_Route)<br>The RIP router instance associated with this IP route."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "VRF.name",
            "in": "path",
            "description": "Reference Resource: [VRF](#/VRF)<br>VRF identifier. Should be alphanumeric. VRF names must be unique.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "RIP_Router.instance_tag",
            "in": "path",
            "description": "Reference Resource: [RIP_Router](#/RIP_Router)<br>The list of all the RIP IPv4 Router instances.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "prefix",
                  "nexthop",
                  "metric",
                  "port"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
