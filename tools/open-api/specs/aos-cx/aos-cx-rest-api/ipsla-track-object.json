            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "down_delay": {
                      "type": "integer",
                      "description": "Specify time in seconds to delay notification of a tracker 'down' event.",
                      "maximum": 180,
                      "minimum": 0
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Ipsla_Track_Object](#/Ipsla_Track_Object)<br>Object name.",
                      "maxLength": 100
                    },
                    "object_status": {
                      "type": "string",
                      "description": "Object status of the event. up: Object being monitored is in 'up' state. down: Object being monitored is in 'down' state.",
                      "enum": [
                        "up",
                        "down"
                      ]
                    },
                    "object_status_last_change_timestamp": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time (in seconds from Epoch) when monitored object status  changed.",
                      "minimum": 0
                    },
                    "track_list_operator": {
                      "type": "string",
                      "description": "Object monitor track list operator. track list operator enables two types of calculation by using either AND or OR  operators. For example, when tracking two interfaces using the AND  operator, up means that both interfaces are up, and down  means that either interface is down.",
                      "enum": [
                        "and",
                        "or"
                      ]
                    },
                    "tracked_ipsla_session": {
                      "type": "array",
                      "description": "Reference Resource: [ipsla_source](#/ipsla_source)<br>List of IPSLA sessions which are configured and tracked by this object",
