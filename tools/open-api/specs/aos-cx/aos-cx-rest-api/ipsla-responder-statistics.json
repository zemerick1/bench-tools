{
  "openapi": "3.0.0",
  "info": {
    "title": "ipsla_responder_statistics",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "ipsla_responder_statistics"
    }
  ],
  "paths": {
    "/system/ipsla_responders/{ipsla_responder.name}/ipsla_responder_statistics": {
      "get": {
        "tags": [
          "ipsla_responder_statistics"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "": {
                      "type": "string",
                      "description": "Reference Resource: [ipsla_responder_statistics](#/ipsla_responder_statistics)<br>Responder statistics for different IP SLA sources.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 9223372036854776000
                    },
                    "last_probe_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Time (in seconds from epoch) when last probe was received from the source."
                    },
                    "num_of_pkts_received": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Number of packets received by the IP SLA responder."
                    },
                    "num_of_pkts_transmitted": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Number of packets responded back by the IP SLA responder."
                    },
                    "source_ip": {
                      "type": "string",
                      "description": "Reference Resource: [ipsla_responder_statistics](#/ipsla_responder_statistics)<br>IP address of the IP SLA source from which the packets are being received."
                    },
                    "source_port": {
                      "type": "integer",
                      "description": "Reference Resource: [ipsla_responder_statistics](#/ipsla_responder_statistics)<br>TCP/UDP port of the IP SLA source on which the session has been established.",
                      "maximum": 65535,
                      "minimum": 1
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [ipsla_responder_statistics](#/ipsla_responder_statistics)<br>VRF on which the responder listens for IP SLA packets."
                    }
                  },
                  "required": [
                    ""
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
