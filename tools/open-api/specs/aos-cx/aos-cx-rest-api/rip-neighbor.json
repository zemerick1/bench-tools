{
  "openapi": "3.0.0",
  "info": {
    "title": "RIP_Neighbor",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "RIP_Neighbor"
    }
  ],
  "paths": {
    "/system/vrfs/{VRF.name}/rip_routers/{RIP_Router.instance_tag}/rip_neighbors": {
      "get": {
        "tags": [
          "RIP_Neighbor"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "last_update_time": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Value of sysUpTime corresponding to the last RIP update  received from this neighbor.",
                      "minimum": 0
                    },
                    "peer_address": {
                      "type": "string",
                      "description": "Reference Resource: [RIP_Neighbor](#/RIP_Neighbor)<br>IPv4 or IPv6 address that the peer is using as its source address.",
                      "maxLength": 45
                    },
                    "peer_version": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Protocol version number advertised by this neighbor."
                    },
                    "rip_router": {
                      "type": "string",
                      "description": "Reference Resource: [RIP_Neighbor](#/RIP_Neighbor)<br>IP address corresponding to this RIP neighbor."
                    },
                    "statistics": {
                      "type": "object",
                      "properties": {
                        "received_bad_packets": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of invalid response packets received from this neighbor."
                        },
                        "received_bad_routes": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Number of invalid or badly formatted routes received from this neighbor."
                        }
                      }
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "VRF.name",
            "in": "path",
            "description": "Reference Resource: [VRF](#/VRF)<br>VRF identifier. Should be alphanumeric. VRF names must be unique.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "RIP_Router.instance_tag",
            "in": "path",
            "description": "Reference Resource: [RIP_Router](#/RIP_Router)<br>The list of all the RIP IPv4 Router instances.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "peer_address",
                  "last_update_time",
                  "peer_version",
                  "statistics"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
