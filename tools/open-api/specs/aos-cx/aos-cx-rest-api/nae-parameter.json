{
  "openapi": "3.0.0",
  "info": {
    "title": "NAE_Parameter",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "NAE_Parameter"
    }
  ],
  "paths": {
    "/system/nae_scripts/{NAE_Script.name}/nae_parameters": {
      "get": {
        "tags": [
          "NAE_Parameter"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "default_value": {
                      "type": "string",
                      "description": "Value that should be assigned to the parameter during agent instantiation if not provided.",
                      "maxLength": 256
                    },
                    "encrypt": {
                      "type": "boolean",
                      "description": "Specifies whether this parameter is encrypted when an agent is created"
                    },
                    "long_description": {
                      "type": "string",
                      "description": "Description of the NAE Parameter.",
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [NAE_Parameter](#/NAE_Parameter)<br>Parameters of the nae, available to the script if present."
                    },
                    "required": {
                      "type": "boolean",
                      "description": "Specifies whether this parameter is required when an agent is created. If the parameter is required and the user does not provide a value, then the NAE Agent will be considered invalid and will be in an error state."
                    },
                    "short_description": {
                      "type": "string",
                      "description": "Short description of the NAE Parameter.",
                      "maxLength": 64
                    },
                    "type": {
                      "type": "string",
                      "description": "Type of the nae parameter. * `FLOAT`: Specifies a Parameter where its contents will              always contain a decimal value * `INTEGER`: Specifies a Parameter where its contents will              always contain a signed 64 bit integer value * `STRING`: Specifies a Parameter where its contents will             always contain a string value",
                      "enum": [
                        "FLOAT",
                        "INTEGER",
                        "STRING"
                      ]
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "NAE_Script.name",
            "in": "path",
            "description": "Reference Resource: [NAE_Script](#/NAE_Script)<br>Name of a NAE Script. This has to be a valid canonical name (CNAME) (i.e com.arubanetworks.bgp_monitor).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "encrypt",
                  "required",
                  "type",
                  "short_description",
                  "long_description",
                  "default_value"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
