    {
      "name": "EVPN"
    }
  ],
  "paths": {
    "/system/evpn": {
      "get": {
        "tags": [
          "EVPN"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "allow_imet_relay": {
                      "type": "boolean",
                      "description": "Allow IMET routes to be relayed between eBGP peers."
                    },
                    "arp_suppression_enable": {
                      "type": "boolean",
                      "description": "Enable ARP suppression on the device."
                    },
                    "evpn_vlan_aware_bundles": {
                      "type": "object",
                      "description": "Reference Resource: [EVPN_VLAN_Aware_Bundle](#/EVPN_VLAN_Aware_Bundle)<br>EVPN VLAN-aware bundle configuration.",
                      "properties": {
                        "string": {
                          "type": "string",
                          "description": "Reference resource URI of EVPN_VLAN_Aware_Bundle"
                        }
                      }
                    },
                    "evpn_vlans": {
                      "type": "object",
                      "description": "Reference Resource: [EVPN_VLAN](#/EVPN_VLAN)<br>References to per-VLAN EVPN configurations.",
                      "properties": {
                        "URI": {
                          "type": "string",
                          "description": "Reference resource URI of EVPN_VLAN"
                        }
                      }
                    },
                    "mac_move_count": {
                      "type": "integer",
                      "description": "Specifies the limit on the number of times a host (MAC)  is allowed to move across interfaces within a given 'MAC move' interval.  When this threshold is exceeded, this MAC is considered to be duplicated  in the network. The corresponding MAC route will no longer be advertised  to peer EVPN routers until the duplication issue has been resolved and  the duplicate MAC is cleared from this device's FDB via an explicit administrative action.",
                      "maximum": 10,
                      "minimum": 2
                    },
                    "mac_move_timer": {
                      "type": "integer",
                      "description": "Specifies the MAC move time interval in seconds.",
                      "maximum": 1000,
                      "minimum": 1
                    },
                    "nd_suppression_enable": {
                      "type": "boolean",
                      "description": "Enable IPv6 ND suppression on the device."
                    },
                    "redistribute": {
                      "type": "object",
                      "description": "Types of routes that should be redistributed by EVPN.",
                      "properties": {
                        "local-mac": {
                          "type": "boolean",
                          "description": "Enable Type-2 route advertisement for local system MAC  address of the EVPN enabled VLANs."
                        },
                        "local-svi": {
                          "type": "boolean",
                          "description": "Enable Type-2 route advertisement for local IP address  and MAC address of the SVI interfaces corresponding to  EVPN enabled VLANs."
                        }
                      }
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
