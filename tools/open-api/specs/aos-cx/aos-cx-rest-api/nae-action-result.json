{
  "openapi": "3.0.0",
  "info": {
    "title": "NAE_Action_Result",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "NAE_Action_Result"
    }
  ],
  "paths": {
    "/action_result/{fileID}": {
      "get": {
        "description": "Get details of the NAE Action result<br><br>  This URI is not supported by Notifications or NAE.",
        "summary": "Get the full NAE Action result",
        "tags": [
          "NAE_Action_Result"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "action": {
                      "type": "string"
                    },
                    "error_message": {
                      "type": "string"
                    },
                    "output": {
                      "type": "string"
                    },
                    "parameter": {
                      "type": "string"
                    },
                    "progress": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "name": "fileID",
            "in": "path",
            "description": "Action File ID",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/action_result/{fileID}/{field}": {
      "get": {
        "description": "Get a specific field from the NAE Action result<br><br>  This URI is not supported by Notifications or NAE.",
        "summary": "Get the NAE Action result",
        "tags": [
          "NAE_Action_Result"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "field": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": [
          {
            "name": "fileID",
            "in": "path",
            "description": "Action File ID",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "field",
            "in": "path",
            "description": "Field in the Action File",
            "schema": {
              "type": "string",
              "enum": [
                "action",
                "error_message",
                "output",
                "parameter",
                "progress",
                "timestamp",
                "status"
              ]
            },
            "required": true
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
