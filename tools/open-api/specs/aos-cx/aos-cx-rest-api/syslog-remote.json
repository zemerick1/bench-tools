          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "": {
                      "type": "string",
                      "description": "Reference Resource: [Syslog_Remote](#/Syslog_Remote)<br>List of syslog servers to which syslog messages will be forwarded. [Syslog_Remote](#/Syslog_Remote)",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 4
                    },
                    "connected": {
                      "type": "boolean",
                      "description": "Transport layer protocol connection status with the server. Applicable only in TCP and TLS transport type."
                    },
                    "disable": {
                      "type": "boolean",
                      "description": "Disable sending syslog messages to the remote syslog server."
                    },
                    "include_auditable_events": {
                      "type": "boolean",
                      "description": "Specifies whether auditable events (audit and authentication)  should be transmitted to the remote syslog server."
                    },
                    "logging_filter": {
                      "type": "string",
                      "description": "Reference Resource: [Logging_Filter](#/Logging_Filter)<br>Currently active logging filter.This column value can be empty."
                    },
                    "port_number": {
                      "type": "integer",
                      "description": "Port number of the syslog server.This column value can be empty.",
                      "maximum": 65535,
                      "minimum": 1
                    },
                    "rate_limit": {
                      "type": "object",
                      "description": "Rate limiting applied to messages sent to the remote syslog server.",
                      "properties": {
                        "burst": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Maximum number of logs allowed in a given rate limit interval.",
                          "maximum": 4294967295,
                          "minimum": 1
                        },
                        "interval": {
                          "type": "integer",
                          "format": "int64",
                          "description": "Rate limit interval in seconds.",
                          "maximum": 4294967295,
                          "minimum": 30
                        }
                      }
                    },
                    "remote_host": {
                      "type": "string",
                      "description": "Reference Resource: [Syslog_Remote](#/Syslog_Remote)<br>FQDN or host name or IPv4 address or IPv6 address of the syslog server.",
                      "maxLength": 256,
                      "minLength": 1
                    },
                    "severity": {
                      "type": "string",
                      "description": "Filter syslog messages with severity.  Only messages with severity higher than or equal to the specified value will be sent to the remote server.",
                      "enum": [
                        "debug",
                        "info",
                        "notice",
                        "warning",
                        "err",
                        "crit",
                        "alert",
                        "emerg"
                      ]
                    },
                    "tls_auth_mode": {
                      "type": "string",
                      "description": "TLS authentication mode used to authenticate the server: 'certificate':   certificate based authentication 'subject-name':  certificate and subject name based authentication",
                      "enum": [
                        "certificate",
                        "subject-name"
                      ]
                    },
                    "transport": {
                      "type": "string",
                      "description": "Transport layer protocol used to forward messages to the server.",
                      "enum": [
                        "udp",
                        "tcp",
                        "tls"
                      ]
                    },
                    "unsecure_tls_renegotiation": {
                      "type": "boolean",
                      "description": "Enable TLS session with syslog server which does not support secure  renegotiation."
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [VRF](#/VRF)<br>VRF of the remote_host. If not specified, remote_host will be routed through default VRF This column value can be empty."
                    }
                  },
                  "required": [
                    "",
                    "remote_host"
                  ],
                  "type": "object"
                }
              }
            }
          },
