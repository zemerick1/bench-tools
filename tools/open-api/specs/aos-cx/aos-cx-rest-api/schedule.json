{
  "openapi": "3.0.0",
  "info": {
    "title": "Schedule",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Schedule"
    }
  ],
  "paths": {
    "/system/schedules": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "count": {
                      "type": "integer",
                      "description": "Maximum number of times the schedule can trigger. If not set, no limit is applied on the number of triggers. This is not applicable for 'one-shot' schedule type. Once schedule is triggered *count* number of times, the status changes to *expired*.",
                      "maximum": 1000,
                      "minimum": 1
                    },
                    "days_of_month": {
                      "type": "array",
                      "description": "Specify the days of the month associated with this schedule. If the day is greater than the number of days of that month, then the schedule gets triggered on last day of that month. This is only applicable when the schedule type is set to 'calendar' type.",
                      "items": {
                        "type": "integer"
                      },
                      "maxItems": 31
                    },
                    "days_of_week": {
                      "type": "array",
                      "description": "Specify the days of the week associated with this schedule. This is only applicable when the schedule type is set to 'calendar' type. Note: If both *days_of_month* and *days_of_week* are specified, then only *days_of_week* is considered.",
                      "items": {
                        "type": "string",
                        "enum": [
                          "sunday",
                          "monday",
                          "tuesday",
                          "wednesday",
                          "thursday",
                          "friday",
                          "saturday"
                        ]
                      },
                      "maxItems": 7
                    },
                    "description": {
                      "type": "string",
                      "description": "Description about the schedule.",
                      "maxLength": 128,
                      "minLength": 1
                    },
                    "disable": {
                      "type": "boolean",
                      "description": "Disable the schedule."
                    },
                    "job": {
                      "type": "object",
                      "description": "Reference Resource: [Job](#/Job)<br>Jobs associated with this schedule.",
                      "properties": {
                        "integer": {
                          "type": "string",
                          "description": "Reference resource URI of Job"
                        }
                      }
                    },
                    "last_trigger_timestamp": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Epoch timestamp of the most recent trigger corresponding to this schedule."
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [Schedule](#/Schedule)<br>Schedule name.",
                      "maxLength": 64,
                      "minLength": 1
                    },
                    "next_trigger_timestamp": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Epoch timestamp of the next trigger corresponding to this schedule."
                    },
                    "periodicity": {
                      "type": "object",
                      "description": "Specify the periodic interval associated with this schedule. This is only applicable when the schedule type is set to 'periodic' type.",
                      "properties": {
                        "day": {
                          "type": "integer",
                          "description": "Periodicity of this schedule represented in days.",
                          "maximum": 365,
                          "minimum": 1
                        },
                        "hour": {
                          "type": "integer",
                          "description": "Periodicity of this schedule represented in hours.",
                          "maximum": 8760,
                          "minimum": 1
                        },
                        "minute": {
                          "type": "integer",
                          "description": "Periodicity of this schedule represented in minutes.",
                          "maximum": 525600,
                          "minimum": 30
                        }
                      }
                    },
                    "persistence_type": {
                      "type": "boolean",
                      "description": "Enable schedule persistence across device reboots."
                    },
                    "schedule_type": {
                      "type": "string",
                      "description": "Type of the schedule. 'calendar'   : Triggered at a specific calendar date and time. 'one-shot'   : Triggered only once at a specific calendar date and time. 'periodic'   : Triggered at specific periodic intervals.",
                      "enum": [
                        "calendar",
                        "one-shot",
                        "periodic"
                      ]
                    },
                    "start_date": {
                      "type": "string",
                      "description": "Specify the start date in format YYYY-MM-DD for the schedule.",
                      "maxLength": 10,
                      "minLength": 10
                    },
                    "status": {
                      "type": "string",
                      "description": "Status of the schedule. `active`    : Schedule is active `inactive`  : Schedule is not started yet `expired`   : Schedule is expired or the *count* is reached. `failed`    : Schedule is failed",
                      "enum": [
                        "active",
                        "inactive",
                        "expired",
                        "failed"
                      ]
                    },
                    "time": {
                      "type": "string",
                      "description": "Specify the time in HH:MM format. This indicates the schedule time, if the schedule type is set to 'calendar' or 'one-shot'. And this indicates the start time, if the schedule type is set to 'periodic'. Note that 'time' needs to be specified in conjunction with either 'days_of_month' or 'days_of_week' if the schedule type is set to 'calendar'. And 'time' needs to be specified in conjunction with 'periodicity', if the schedule type is set to 'periodic'.",
                      "maxLength": 5,
                      "minLength": 5
                    },
                    "trigger_count": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Number of times this schedule has been triggered."
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
