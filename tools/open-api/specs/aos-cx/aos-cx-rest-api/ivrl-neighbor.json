{
  "openapi": "3.0.0",
  "info": {
    "title": "IVRL_Neighbor",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "IVRL_Neighbor"
    }
  ],
  "paths": {
    "/system/vrfs/{VRF.name}/ivrl_neighbors": {
      "get": {
        "tags": [
          "IVRL_Neighbor"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "address_family": {
                      "type": "string",
                      "description": "Address family of the neighbor.",
                      "enum": [
                        "ipv4",
                        "ipv6"
                      ]
                    },
                    "gbp_role_id": {
                      "type": "integer",
                      "description": "GBP role-id associated with neighbor entry. Non GBP clients use 0 as their role-id.",
                      "maximum": 8191,
                      "minimum": 0
                    },
                    "ip_address": {
                      "type": "string",
                      "description": "Reference Resource: [IVRL_Neighbor](#/IVRL_Neighbor)<br>The IPv4 address or the IPv6 address of neighbor",
                      "maxLength": 45
                    },
                    "mac": {
                      "type": "string",
                      "description": "MAC address learned for this neighbor."
                    },
                    "phy_port": {
                      "type": "string",
                      "description": "Reference Resource: [Port](#/Port)<br>Matches 'Port' if 'Port' refers to LAG/non-aggregated physical port, otherwise references the actual VLAN member port."
                    },
                    "port": {
                      "type": "string",
                      "description": "Reference Resource: [IVRL_Neighbor](#/IVRL_Neighbor)<br>Logical port LAG/non-aggregated physical port/L3 VLAN interface etc. at which MAC was learnt."
                    },
                    "state": {
                      "type": "string",
                      "description": "Current state of the neighbor entry.",
                      "enum": [
                        "reachable",
                        "stale",
                        "incomplete",
                        "failed",
                        "permanent"
                      ]
                    },
                    "tunnel_endpoint": {
                      "type": "string",
                      "description": "Reference Resource: [Tunnel_Endpoint](#/Tunnel_Endpoint)<br>In case of multipoint tunnels, like VXLAN, tunnel_endpoint designates specific endpoint where the packets matching this destination IP address should be forwarded to."
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [IVRL_Neighbor](#/IVRL_Neighbor)<br>Reference to the VRF instance, to which this neighbor belongs."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "VRF.name",
            "in": "path",
            "description": "Reference Resource: [VRF](#/VRF)<br>VRF identifier. Should be alphanumeric. VRF names must be unique.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "mac",
                  "phy_port",
                  "tunnel_endpoint",
                  "state",
                  "gbp_role_id",
                  "ip_address",
                  "address_family",
                  "port"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
