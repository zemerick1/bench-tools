{
  "openapi": "3.0.0",
  "info": {
    "title": "SimpliVity",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "SimpliVity"
    }
  ],
  "paths": {
    "/system/simplivity": {
      "get": {
        "tags": [
          "SimpliVity"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "auth_token": {
                      "type": "string",
                      "description": "Random string generated by the switch. Might be utilized to authenticate communication with the SimpliVity feature."
                    },
                    "enable": {
                      "type": "boolean",
                      "description": "Enables SimpliVity feature."
                    },
                    "image_location": {
                      "type": "string",
                      "description": "URL through which the image can be obtained. Only HTTP protocol is supported.",
                      "maxLength": 1024
                    },
                    "image_status": {
                      "type": "string",
                      "description": "State of the SimpliVity Image: no_image             : SimpliVity image is not available. download_in_progress : SimpliVity image is being downloaded. download_failed      : SimpliVity image download failed. downloaded           : SimpliVity image downloaded successfully. verified             : SimpliVity image verified successfully. verification_failed  : SimpliVity image verification failed.",
                      "enum": [
                        "no_image",
                        "download_in_progress",
                        "download_failed",
                        "downloaded",
                        "verified",
                        "verification_failed"
                      ]
                    },
                    "image_version": {
                      "type": "string",
                      "description": "Version of the image."
                    },
                    "status": {
                      "type": "string",
                      "description": "State of the SimpliVity feature: down                       : Feature is down. disabled                   : Feature is administratively down. initializing               : Feature initialization and config verification. operational                : Feature is up and runnig. failed                     : Feature failed to execute.",
                      "enum": [
                        "down",
                        "disabled",
                        "initializing",
                        "operational",
                        "failed"
                      ]
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [VRF](#/VRF)<br>VRF at which the SimpliVity feature should be enabled. If not configured, `default` VRF would be used."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "enable",
                  "vrf",
                  "image_location",
                  "status",
                  "image_status",
                  "auth_token",
                  "image_version"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "put": {
        "tags": [
          "SimpliVity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "enable": {
                    "type": "boolean",
                    "description": "Enables SimpliVity feature."
                  },
                  "image_location": {
                    "type": "string",
                    "description": "URL through which the image can be obtained. Only HTTP protocol is supported.",
                    "maxLength": 1024
                  },
                  "vrf": {
                    "type": "string",
                    "description": "Reference Resource: [VRF](#/VRF)<br>VRF at which the SimpliVity feature should be enabled. If not configured, `default` VRF would be used."
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "post": {
        "tags": [
          "SimpliVity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "enable": {
                    "type": "boolean",
                    "description": "Enables SimpliVity feature."
                  },
                  "image_location": {
                    "type": "string",
                    "description": "URL through which the image can be obtained. Only HTTP protocol is supported.",
                    "maxLength": 1024
                  },
                  "vrf": {
                    "type": "string",
                    "description": "Reference Resource: [VRF](#/VRF)<br>VRF at which the SimpliVity feature should be enabled. If not configured, `default` VRF would be used."
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "delete": {
        "tags": [
          "SimpliVity"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "patch": {
        "tags": [
          "SimpliVity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "enable": {
                    "type": "boolean",
                    "description": "Enables SimpliVity feature."
                  },
                  "image_location": {
                    "type": "string",
                    "description": "URL through which the image can be obtained. Only HTTP protocol is supported.",
                    "maxLength": 1024
                  },
                  "vrf": {
                    "type": "string",
                    "description": "Reference Resource: [VRF](#/VRF)<br>VRF at which the SimpliVity feature should be enabled. If not configured, `default` VRF would be used."
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    }
  },
