{
  "openapi": "3.0.0",
  "info": {
    "title": "EVPN_VTEP_Neighbor",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "EVPN_VTEP_Neighbor"
    }
  ],
  "paths": {
    "/system/vrfs/{VRF.name}/evpn_vtep_neighbors": {
      "get": {
        "tags": [
          "EVPN_VTEP_Neighbor"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "address_family": {
                      "type": "string",
                      "description": "Address family of the IP address.",
                      "enum": [
                        "ipv4"
                      ]
                    },
                    "ip_address": {
                      "type": "string",
                      "description": "Reference Resource: [EVPN_VTEP_Neighbor](#/EVPN_VTEP_Neighbor)<br>The IP address of the peer VTEP.",
                      "maxLength": 45
                    },
                    "mac": {
                      "type": "string",
                      "description": "Peer-VTEP MAC address.",
                      "maxLength": 17,
                      "minLength": 17
                    },
                    "phy_port": {
                      "type": "string",
                      "description": "Reference Resource: [Port](#/Port)<br>VxLAN port associated with the tunnel endpoint."
                    },
                    "tunnel_endpoint": {
                      "type": "string",
                      "description": "Reference Resource: [Tunnel_Endpoint](#/Tunnel_Endpoint)<br>In case of multipoint tunnels, like VXLAN, tunnel_endpoint designates specific endpoint where the packets matching this destination IP address should be forwarded to."
                    },
                    "vni": {
                      "type": "string",
                      "description": "Reference Resource: [Virtual_Network_ID](#/Virtual_Network_ID)<br>The L3VNI associated with the tunnel next-hop for the VRF."
                    },
                    "vrf": {
                      "type": "string",
                      "description": "Reference Resource: [EVPN_VTEP_Neighbor](#/EVPN_VTEP_Neighbor)<br>Overlay VRF, based on the L3VNI received in the EVPN route."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "VRF.name",
            "in": "path",
            "description": "Reference Resource: [VRF](#/VRF)<br>VRF identifier. Should be alphanumeric. VRF names must be unique.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ip_address",
                  "address_family",
                  "mac",
                  "vni",
                  "tunnel_endpoint",
                  "phy_port"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
