{
  "openapi": "3.0.0",
  "info": {
    "title": "VSX_Remote_Lag",
    "version": "10.16",
    "description": "RESTful interface for AOS-CX switch software"
  },
  "servers": [
    {
      "url": "https://{switchIp}/rest/v10.16",
      "description": "AOS-CX switch",
      "variables": {
        "switchIp": {
          "default": "192.0.2.1",
          "description": "Switch management IP or hostname"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "VSX_Remote_Lag"
    }
  ],
  "paths": {
    "/system/vsx_remote_lags": {
      "get": {
        "tags": [
          "VSX_Remote_Lag"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "hash_scheme": {
                      "type": "string",
                      "description": "LAG hash scheme for this VSX as configured on the peer device.",
                      "enum": [
                        "l2-src-dst-hash",
                        "l3-src-dst-hash",
                        "l4-src-dst-hash"
                      ]
                    },
                    "loop_protect_enabled": {
                      "type": "boolean",
                      "description": "Loop Protection admin status for this VSX as configured on the peer device."
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference Resource: [VSX_Remote_Lag](#/VSX_Remote_Lag)<br>Peer device VSX name."
                    },
                    "qos_config": {
                      "type": "object",
                      "properties": {
                        "cos_override": {
                          "type": "integer",
                          "description": "Specifies the port COS override to use. If the key is not specified, then no override will be enabled.",
                          "maximum": 7,
                          "minimum": 0
                        },
                        "dscp_override": {
                          "type": "integer",
                          "description": "Specifies the port DSCP override to use. If the key is not specified, then no override will be enabled.",
                          "maximum": 63,
                          "minimum": 0
                        },
                        "qos_trust": {
                          "type": "string",
                          "description": "Specifies the individual port QoS Trust Mode.",
                          "enum": [
                            "cos",
                            "dscp"
                          ]
                        }
                      }
                    },
                    "vlan_list": {
                      "type": "array",
                      "description": "List of VLANs that this VSX is a member of on the peer device.",
                      "items": {
                        "type": "integer"
                      },
                      "maxItems": 4096
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/304"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "attributes",
            "in": "query",
            "description": "Columns to display.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "qos_config",
                  "vlan_list",
                  "name",
                  "loop_protect_enabled",
                  "hash_scheme"
                ]
              }
            },
            "explode": false
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Depth to traverse.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "selector",
            "in": "query",
            "description": "Select configuration, status and/or statistics. Default is all categories.",
            "schema": {
              "type": "string",
              "enum": [
                "configuration",
                "status",
                "statistics",
                "writable"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter rows by attribute values.  Format: attribute:value",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explode": false
          },
          {
            "name": "count",
            "in": "query",
            "description": "Count the number of rows found.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity-tag value for representation comparison (see RFC 7232 - Conditional Requests - section 3.2)",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
