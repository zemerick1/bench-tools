# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
*~

# Node (not required to run the site; keep accidental installs out)
node_modules/
dist/
.npm/
package-lock.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Env / secrets
.env
.env.*
!.env.example

# Central alerts API secrets (never commit)
tools/central-alerts/credentials.local.json

# Local scratch
*.local.json
!tools/central-alerts/credentials.local.json.example
tmp/
.tmp/

# AOS-CX CLI builder: local PDF + venv (generated JSON under data/ is committed)
tools/cli-explorer/.venv/
tools/cli-explorer/source/*.pdf
tools/cli-explorer/source/**/*.pdf
tools/cli-explorer/source/build_logs/
tools/cli-explorer/source/*.log
tools/aos-cx-cli/.venv/
tools/aos-cx-cli/source/*.pdf
tools/aos-cx-cli/source/**/*.pdf

# CLI Explorer generated markdown exports
tools/cli-explorer/markdown/

# Local download logs (may contain machine paths)
tools/cli-explorer/source/download_manifest.json
tools/cli-explorer/source/**/download_manifest.json

# Full per-platform bank JSON (long builds; app uses data/layers/ instead)
tools/cli-explorer/full-banks/

# Wrangler local state / deploy junk
.wrangler/
.assetsignore.bak
