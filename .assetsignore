# Files in the assets directory that must not be uploaded to Cloudflare.
# Same format as .gitignore — see Workers static assets docs.

.git
.wrangler
node_modules

# Offline-only CLI Explorer build tooling + local inputs
tools/cli-explorer/scripts
tools/cli-explorer/source
tools/cli-explorer/full-banks
tools/cli-explorer/.venv
tools/cli-explorer/markdown
tools/cli-explorer/**/*.py
tools/cli-explorer/**/*.sh

# Other offline maintainer scripts (browser tools do not need them)
**/*.py
**/*.pyc
**/__pycache__
**/.venv

# Repo meta not needed on the CDN
docs
LICENSE
*.md
!README.md
